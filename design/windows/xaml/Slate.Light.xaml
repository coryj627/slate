    <!-- 4. Shadows: one DropShadowEffect per level (WPF takes one effect per element). Direction 270 = straight down.
         BlurRadius = 1.5 x the CSS blur (same Gaussian spread). Put the effect on a background-only Border
         behind the content, never on a text parent, or ClearType turns off. Check by eye in the app. -->
    <DropShadowEffect x:Key="Slate.Shadow2" Color="#FF000000" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.18" />
    <DropShadowEffect x:Key="Slate.Shadow4" Color="#FF000000" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.18" />
    <DropShadowEffect x:Key="Slate.Shadow8" Color="#FF000000" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.18" />
    <DropShadowEffect x:Key="Slate.Shadow16" Color="#FF000000" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.18" />
    <DropShadowEffect x:Key="Slate.Shadow28" Color="#FF000000" Direction="270" ShadowDepth="14" BlurRadius="42" Opacity="0.18" />
    <DropShadowEffect x:Key="Slate.Shadow64" Color="#FF000000" Direction="270" ShadowDepth="32" BlurRadius="96" Opacity="0.18" />

