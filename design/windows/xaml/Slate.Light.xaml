<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Slate Design System theme layer (Light). Generated from tokens/colors.css, tokens/brand.css,
         tokens/fluent-slate.css and tokens/spacing.css. Drop-in replacement for Themes/Slate.Light.xaml:
         ThemeManager already merges it after Fluent.Light.xaml, so every key below wins.
         Sections: 1 accent roles, 2 Slate colours and brushes (existing keys kept), 3 new Slate keys,
         4 shadows, 5 Fluent colour keys, 6 Fluent brushes re-pointed to Slate, 7 Fluent control borders.
         High Contrast is untouched: keep Fluent.HC.xaml + Slate.Contrast.xaml, no gold. -->

    <!-- 1. Accent roles. Every accent brush reads these with DynamicResource, so the app can swap
         Slate gold for the Windows accent at runtime by writing these nine keys (xaml/README.md). -->
    <Color x:Key="Slate.AccentColor">#FF7D5A00</Color> <!-- Fill for primary buttons, checked boxes, switches, sliders, progress and focused input underlines -->
    <Color x:Key="Slate.AccentHoverColor">#FF6B4D00</Color> <!-- Accent fill on pointer-over -->
    <Color x:Key="Slate.AccentPressedColor">#FF563D04</Color> <!-- Accent fill when pressed -->
    <Color x:Key="Slate.AccentTextColor">#FF6B4D00</Color> <!-- Links, wikilinks, tags, headings in the editor -->
    <Color x:Key="Slate.AccentIndicatorColor">#FFA57A00</Color> <!-- Selected-row pill and selected-tab underline -->
    <Color x:Key="Slate.TextOnAccentColor">#FFFFFFFF</Color> <!-- Text and glyphs on an accent fill -->
    <Color x:Key="Slate.SelectedSurfaceColor">#FFFDF5E1</Color> <!-- Selected list and tree rows -->
    <Color x:Key="Slate.SelectionBackgroundColor">#FFF9E7B8</Color> <!-- Text selection -->
    <Color x:Key="Slate.SelectionTextColor">#FF171717</Color> <!-- Text inside a selection -->
    <Color x:Key="Slate.ReadingSelectionColor">#33A57A00</Color> <!-- Reading view selection: an overlay on top of the text, #A57A00 at 20% -->

    <!-- 2. Slate colours and brushes. -->
    <!-- Provisional W1 palette. Text-bearing pairs are intentionally high
         separation; W8-2 owns final values and the permanent APCA gate. -->
    <Color x:Key="Slate.WindowBackgroundColor">#FFF7F7F7</Color>
    <Color x:Key="Slate.SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="Slate.RaisedSurfaceColor">#FFEFEFEF</Color>
    <Color x:Key="Slate.TextColor">#FF171717</Color>
    <!-- WB-22 (#1112): the editor's find-match fill, drawn behind the text.
         The text over it clears the APCA floor (ThemeTokenContrastTests). -->
    <Color x:Key="Slate.FindMatchColor">#FFFFE48A</Color>
    <Color x:Key="Slate.FindMatchRingColor">#FF6B3800</Color>
    <Color x:Key="Slate.SecondaryTextColor">#FF3A3A3A</Color>
    <Color x:Key="Slate.TertiaryTextColor">#FF555555</Color>
    <Color x:Key="Slate.BorderColor">#FF767676</Color>
    <Color x:Key="Slate.ErrorColor">#FF8A0014</Color>
    <Color x:Key="Slate.WarningColor">#FF754500</Color>

    <!-- Canvas tokens (W6-1 §D D13): the dark dictionary’s note
         applies; these are the light composites over #FFFFFFFF. -->
