# Marks the uniffi-bindgen-cs output as generated so `dotnet format
# --verify-no-changes` (windows.yml gate) never fails on code we don't
# author. Hand-written C# in this tree is formatted by the same gate.
[src/SlateUniffi/generated/**.cs]
generated_code = true

# The §W-E censuses use bounded Task.Wait as deadlock watchdogs — "did
# this terminate within T" is the assertion, which await would erase.
# xUnit runs without a synchronization context, so blocking is safe here.
[tests/**.cs]
dotnet_diagnostic.xUnit1031.severity = none
# xunit v3's xUnit1051 asks every call that takes a CancellationToken to pass
# TestContext.Current.CancellationToken. That token fires only when a run is
# cancelled or a per-test timeout trips; both suites run serially with no
# per-test timeouts, and v3 runs them in their own process, so a cancelled
# run ends with it. Threading the token through ~350 calls (many inside the
# bounded-wait watchdogs above) would change no behaviour.
dotnet_diagnostic.xUnit1051.severity = none
