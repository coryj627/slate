<UserControl x:Class="SlateWindows.FindInNoteBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SlateWindows"
             xmlns:cmd="clr-namespace:SlateWindows.Commands"
             x:ClassModifier="internal"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="FindBarBooleanToVisibility" />
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <!-- WB-22 (#1112): a non-modal landmark beside the note, never a Popup,
         never a dialog. Its own keys (Enter / Shift+Enter in the query, Escape
         anywhere) are FindInNoteBar.Bind's map; Ctrl+G is the window's route. -->
    <local:AutomationLandmarkGrid AutomationProperties.AutomationId="FindInNote"
                                  AutomationProperties.Name="Find in note"
                                  Margin="12,0,12,4">
        <WrapPanel Orientation="Horizontal">
            <TextBox x:Name="QueryBox"
                     MinWidth="200"
                     Margin="0,0,8,4"
                     VerticalContentAlignment="Center"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="FindInNoteQuery"
                     AutomationProperties.Name="Find in note"
                     AutomationProperties.HelpText="{x:Static cmd:NavigationHelp.FindInNote}" />
            <TextBlock x:Name="CountReadout"
                       Margin="0,0,8,4"
                       VerticalAlignment="Center"
                       Focusable="True"
                       KeyboardNavigation.IsTabStop="True"
                       Text="{Binding CountText}"
                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                       AutomationProperties.AutomationId="FindInNoteCount"
                       AutomationProperties.Name="{Binding CountText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CountText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="_Previous"
                    Margin="0,0,4,4"
                    Command="{Binding PreviousCommand}"
                    AutomationProperties.AutomationId="FindInNotePrevious"
                    AutomationProperties.Name="Previous match" />
            <Button Content="_Next"
                    Margin="0,0,8,4"
                    Command="{Binding NextCommand}"
                    AutomationProperties.AutomationId="FindInNoteNext"
                    AutomationProperties.Name="Next match" />
            <CheckBox Content="Match _case"
                      Margin="0,0,8,4"
                      VerticalAlignment="Center"
                      IsChecked="{Binding MatchCase}"
                      AutomationProperties.AutomationId="FindInNoteMatchCase" />
            <CheckBox Content="_Whole word"
                      Margin="0,0,8,4"
                      VerticalAlignment="Center"
                      IsChecked="{Binding WholeWord}"
                      AutomationProperties.AutomationId="FindInNoteWholeWord" />
            <TextBox MinWidth="140"
                     Margin="0,0,4,4"
                     VerticalContentAlignment="Center"
                     Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding CanReplace, Converter={StaticResource FindBarBooleanToVisibility}}"
                     AutomationProperties.AutomationId="FindInNoteReplaceText"
                     AutomationProperties.Name="Replace with" />
            <Button Content="_Replace"
                    Margin="0,0,4,4"
                    Command="{Binding ReplaceCommand}"
                    Visibility="{Binding CanReplace, Converter={StaticResource FindBarBooleanToVisibility}}"
                    AutomationProperties.AutomationId="FindInNoteReplace"
                    AutomationProperties.Name="Replace" />
            <Button Content="Replace _All"
                    Margin="0,0,8,4"
                    Command="{Binding ReplaceAllCommand}"
                    Visibility="{Binding CanReplace, Converter={StaticResource FindBarBooleanToVisibility}}"
                    AutomationProperties.AutomationId="FindInNoteReplaceAll"
                    AutomationProperties.Name="Replace all" />
            <Button Content="Close"
                    Margin="0,0,8,4"
                    Command="{Binding CloseCommand}"
                    AutomationProperties.AutomationId="FindInNoteClose"
                    AutomationProperties.Name="Close find" />
            <TextBlock Margin="0,0,8,4"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding Error}"
                       Foreground="{DynamicResource Slate.WarningBrush}"
                       Visibility="{Binding HasError, Converter={StaticResource FindBarBooleanToVisibility}}"
                       AutomationProperties.AutomationId="FindInNoteError"
                       AutomationProperties.Name="{Binding Error}" />
        </WrapPanel>
    </local:AutomationLandmarkGrid>
</UserControl>
