<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SlateWindows"
                    xmlns:cmd="clr-namespace:SlateWindows.Commands"
                    xmlns:panels="clr-namespace:SlateWindows.Panels"
                    xmlns:reading="clr-namespace:SlateWindows.Reading"
                    xmlns:bases="clr-namespace:SlateWindows.Bases"
                    xmlns:canvas="clr-namespace:SlateWindows.Canvas"
                    xmlns:graph="clr-namespace:SlateWindows.Graph">
    <!-- #1767: a control with a local style loses Fluent's and falls back to WPF's
         classic template, whose colours are literals no resource key can change: a
         list turns fixed white, a button pale. Every local ListBox, Button and
         TreeViewItem style in the shell is based on one of these, and a test enforces
         it. They live here, the first dictionary MainWindow merges, so both files
         can reach them. -->
    <!-- #1772: Fluent's focus ring is drawn outside its element, and a list clips a
         row at its edges, so a row's ring is drawn inside the row. -->
    <Style x:Key="Slate.RowFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Slate.FocusBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slate.PanelListBase" TargetType="ListBox">
        <!-- With no border or padding, an empty list would have no rectangle. -->
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Slate.TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsGrouping" Value="True">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- #1781: its template is in the theme layer, with the list row's. -->
    <Style x:Key="Slate.ComboRowBase" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Slate.RowFocusVisual}" />
        <Setter Property="Template" Value="{DynamicResource Slate.ComboRowTemplate}" />
    </Style>
    <Style x:Key="Slate.ButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,5,11,6" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- #1778: a split handle's local style drops Fluent, and WPF's classic thumb is a
         pale bar. It's a gutter until it's used, and fills when it has the keys. -->
    <ControlTemplate x:Key="Slate.SplitHandleTemplate" TargetType="Thumb">
        <Border Background="{TemplateBinding Background}" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Slate.AccentIndicatorBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Slate.AccentIndicatorBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Slate.FocusBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <BooleanToVisibilityConverter x:Key="Slate.TreeBoolToVisibility" />
    <!-- A separate key because the canvas outline's rows take it from code, which
         can't base a style on one here. A folder's item includes its children, so the
         focus ring is the row's own, not a focus visual around the whole subtree. -->
    <ControlTemplate x:Key="Slate.TreeRowTemplate" TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton Width="19"
                                      Focusable="False"
                                      ClickMode="Press"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Slate.TreeBoolToVisibility}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 0 8 Z"
                                              Fill="{DynamicResource Slate.SecondaryTextBrush}"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:TreeChevron.Angle}}" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border Grid.Column="1"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- The pill: selection is a shape too, not colour alone. -->
                                <Rectangle Width="3"
                                           Height="16"
                                           Margin="-6,0,0,0"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Fill="{TemplateBinding BorderBrush}" />
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource Slate.FocusBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Slate.TreeBoolToVisibility}}" />
                        <ItemsPresenter Grid.Row="1"
                                        Grid.Column="1"
                                        Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Slate.TreeBoolToVisibility}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- DS-18: the design's surface hover, as panel rows have. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Slate.HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Slate.SelectedSurfaceBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Slate.SelectedTextBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Slate.AccentIndicatorBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Slate.TreeRowBase" TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Slate.TextBrush}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Slate.TreeRowTemplate}" />
    </Style>
    <!-- DS-19: a launcher action, EmptyStateLauncher.prompt.md: a 32 row 320 wide, its label
         on the left and its chord (Tag) on the right in secondary text. Whole, on Slate.ButtonBase.
         The launcher caps the width, so in a narrow pane a row narrows, and where its label and
         chord don't fit on one line the chord goes under the label (LauncherRowPanel) and the
         row grows. Off under every modal surface, as the menus are: at once under a sheet,
         and under Quick Open, search or the palette once the keys have left the row for the
         overlay's field, which takes them in the turn it opens (#1690). IsModalSurfaceOpen
         can change just before that, and off while it held the keys, the row said
         "unavailable" in NVDA. -->
    <Style x:Key="Slate.LauncherRowStyle" TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Slate.TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel VerticalAlignment="Center">
                            <local:AutomationPresentationTextBlock DockPanel.Dock="Left"
                                                                   Text="{Binding (local:LauncherRowPanel.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                   FontSize="16"
                                                                   Margin="0,0,12,0"
                                                                   VerticalAlignment="Center" />
                            <local:LauncherRowPanel>
                                <local:AutomationPresentationTextBlock Text="{TemplateBinding Content}"
                                                                       TextWrapping="Wrap" />
                                <local:AutomationPresentationTextBlock Text="{TemplateBinding Tag}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            </local:LauncherRowPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Slate.HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Slate.PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Slate.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsModalSurfaceOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsModalSheetOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <local:AxisToOrientationConverter x:Key="AxisToOrientationConverter" />
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <local:PixelGridLengthConverter x:Key="PixelGridLengthConverter" />
    <!-- What the rows leave: the tab strip, the rows' own header, the editor's margins, four of its 22px lines and the line under it, which is 280 here. CI measured 11 more, so it holds 40 in hand. -->
    <local:CappedShareConverter x:Key="PropertyRowsMaxHeightConverter" Reserve="360" Floor="80" Cap="280" />
    <!-- DS-15: both reserves hold the note header's 40 too. -->
    <local:CappedShareConverter x:Key="PropertiesCardMaxHeightConverter" Reserve="190" Floor="120" Cap="100000" />
    <local:CappedShareConverter x:Key="QuickOpenNameWidthConverter" Share="12.8572" />
    <local:CappedShareConverter x:Key="DualPaneListMaxHeightConverter" Share="0.5" Cap="150" />
    <local:IsNotNullConverter x:Key="IsNotNullConverter" />
    <local:SidebarSortModeLabelConverter x:Key="SidebarSortModeLabelConverter" />
    <local:RecentVaultNameConverter x:Key="RecentVaultNameConverter" />

    <!-- DS-18: a tag is a count row (CountListRow.prompt.md): its icon, its label, and its
         count on the right in tabular figures. Selected, the label is semibold and the count
         takes Slate.SelectedCaptionBrush. Everything here is presentation: the row's container
         names it "{Segment}, {n} files", as before. -->
    <HierarchicalDataTemplate x:Key="SidebarTagTemplate"
                              DataType="{x:Type local:SidebarTagViewModel}"
                              ItemsSource="{Binding Children}">
        <Grid MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:AutomationPresentationTextBlock Text="&#xE8EC;"
                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                   FontSize="16"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
            <local:AutomationPresentationTextBlock x:Name="Label"
                                                   Grid.Column="1"
                                                   Text="{Binding Segment}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
            <local:AutomationPresentationTextBlock x:Name="Count"
                                                   Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   Text="{Binding FileCount, StringFormat={}{0:N0}}"
                                                   FontSize="{DynamicResource Slate.FontSizeCaption}"
                                                   LineHeight="{DynamicResource Slate.LineHeightCaption}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                <local:AutomationPresentationTextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Slate.TertiaryTextBrush}" />
                    </Style>
                </local:AutomationPresentationTextBlock.Style>
            </local:AutomationPresentationTextBlock>
        </Grid>
        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Slate.SelectedCaptionBrush}" />
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="FileTreeNodeTemplate"
                              DataType="{x:Type local:FileTreeNodeViewModel}"
                              ItemsSource="{Binding Children}">
        <Grid Margin="1" ToolTip="{Binding Path}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- W7-7 (R-2, OD-2): out of the arrow order — Space on the row
                 toggles it and the row's ItemStatus reports it; a pointer
                 click still checks it. -->
            <CheckBox Grid.Column="0"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      Focusable="False"
                      IsTabStop="False"
                      IsChecked="{Binding IsBatchSelected}"
                      Visibility="{Binding IsBatchSelectable, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.Name="{Binding AutomationName, StringFormat=Select {0} for batch actions}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MetadataText}"
                           FontSize="{DynamicResource Slate.FontSizeCaption}" FontFamily="{DynamicResource Slate.FontFamilySmall}" LineHeight="{DynamicResource Slate.LineHeightCaption}" LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </HierarchicalDataTemplate>

    <DataTemplate x:Key="WorkspaceTabHeaderTemplate"
                  DataType="{x:Type local:WorkspaceTabViewModel}">
        <!-- DS-8: icon at 8, label at 32, and a title that takes what's left, so a long one
             is cut. A dock gives its children room in order, so the close button comes first,
             and a narrow split takes from the title and the icon before it takes from that.
             A reader walks visual order, which follows ZIndex, so that keeps what it's always
             heard: the title, the dirty marker, then the close button. -->
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Panel.ZIndex="3"
                    Style="{DynamicResource Slate.TabCloseButtonStyle}"
                    Content="&#xE711;"
                    AutomationProperties.Name="{Binding Title, StringFormat=Close {0}}"
                    Command="{Binding DataContext.Workspace.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <TextBlock DockPanel.Dock="Right"
                       Panel.ZIndex="2"
                       Text="{Binding DirtyMarker}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                       AutomationProperties.Name="Unsaved changes" />
            <local:AutomationPresentationTextBlock DockPanel.Dock="Left"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                   FontSize="16"
                                                   Text="{Binding KindGlyph}" />
            <TextBlock Panel.ZIndex="1"
                       Text="{Binding Title}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </DataTemplate>

<!-- ============================================================
     W4-4 (#736): per-kind property editor templates. The editor
     control is FIXED at row construction from the STORED value
     (EditorMode) — it never swaps mid-edit; rows are rebuilt by
     every publish. All edits are draft-local; Enter commits, Esc
     reverts, Ctrl+Backspace opens the delete confirmation (the
     Cmd-Backspace substitution, chords.json).
     ============================================================ -->
    <DataTemplate x:Key="PropertyTextEditorTemplate"
                  DataType="{x:Type panels:PropertyRowViewModel}">
        <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding EditorTooltip}"
                 AutomationProperties.Name="{Binding AutomationName}">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding CommitCommand}" />
                <KeyBinding Key="Escape" Command="{Binding RevertCommand}" />
                <KeyBinding Key="Back" Modifiers="Control" Command="{Binding DeleteCommand}" />
            </TextBox.InputBindings>
        </TextBox>
    </DataTemplate>

    <DataTemplate x:Key="PropertyDatePickerTemplate"
                  DataType="{x:Type panels:PropertyRowViewModel}">
        <!-- Only mounted when the STORED value parses yyyy-MM-dd, so
             SelectedDate never invents a date. The calendar commits
             ONCE, when it closes (CalendarCommit; the owner's decision
             on PR 4b's last codex check): its arrows move the day
             without a write, and Escape puts back the day it opened on.
             The text portion is read-only (adversarial round 1,
             contract 2): WPF's DatePicker parses typed text on
             LostFocus, which would turn a focus change into a disk
             write. -->
        <DatePicker SelectedDate="{Binding DateValue, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                    local:CalendarCommit.IsEnabled="True"
                    ToolTip="{Binding EditorTooltip}"
                    AutomationProperties.Name="{Binding AutomationName}">
            <DatePicker.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="IsReadOnly" Value="True" />
                </Style>
            </DatePicker.Resources>
        </DatePicker>
    </DataTemplate>

    <DataTemplate x:Key="PropertyNumberEditorTemplate"
                  DataType="{x:Type panels:PropertyRowViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding AutomationName}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding CommitCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding RevertCommand}" />
                    <KeyBinding Key="Up" Command="{Binding StepUpCommand}" />
                    <KeyBinding Key="Down" Command="{Binding StepDownCommand}" />
                    <KeyBinding Key="Back" Modifiers="Control" Command="{Binding DeleteCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <RepeatButton Grid.Column="1"
                          Margin="4,0,0,0"
                          Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                          Content="&#xE70E;"
                          Command="{Binding StepUpCommand}"
                          AutomationProperties.Name="{Binding StepUpLabel}" />
            <RepeatButton Grid.Column="2"
                          Margin="2,0,0,0"
                          Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                          Content="&#xE70D;"
                          Command="{Binding StepDownCommand}"
                          AutomationProperties.Name="{Binding StepDownLabel}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PropertyBooleanEditorTemplate"
                  DataType="{x:Type panels:PropertyRowViewModel}">
        <!-- ToggleButton flips IsChecked (the TwoWay binding lands in
             the draft) BEFORE the command runs, so one click is
             flip + immediate commit — never a double flip. -->
        <CheckBox VerticalAlignment="Center"
                  IsChecked="{Binding BoolValue, Mode=TwoWay}"
                  Command="{Binding CommitCommand}"
                  AutomationProperties.Name="{Binding AutomationName}" />
    </DataTemplate>

    <DataTemplate x:Key="PropertyWikilinkEditorTemplate"
                  DataType="{x:Type panels:PropertyRowViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding EditorTooltip}"
                     AutomationProperties.Name="{Binding AutomationName}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding CommitCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding RevertCommand}" />
                    <KeyBinding Key="Back" Modifiers="Control" Command="{Binding DeleteCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1"
                    Margin="6,0,0,0"
                    Padding="8,2"
                    Content="Pick…"
                    Command="{Binding DataContext.Workspace.PickWikilinkTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding PickerLabel}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PropertyListEditorTemplate"
                  DataType="{x:Type panels:PropertyRowViewModel}">
        <StackPanel>
            <!-- Unnamed on purpose: it is non-focusable structure and
                 the type-cued row name contains "list", which trips
                 axe's NameExcludesControlType on a List control. The
                 per-item editors carry the full labels, so the item
                 containers are layout too (R-4, #1246). -->
            <local:LayoutItemsControl ItemsSource="{Binding Items}"
                                      Focusable="False"
                                      IsTabStop="False">
                <local:LayoutItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type panels:PropertyListItemViewModel}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Enter commits the ROW (contract 2 —
                                 lists have the same commit triggers
                                 as scalars), Esc reverts it. -->
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding ItemLabel}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding CommitCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding RevertCommand}" />
                                    <KeyBinding Key="Back" Modifiers="Control" Command="{Binding DeleteCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Padding="8,2"
                                    Content="Remove"
                                    Command="{Binding RemoveCommand}"
                                    AutomationProperties.Name="{Binding RemoveLabel}" />
                        </Grid>
                    </DataTemplate>
                </local:LayoutItemsControl.ItemTemplate>
            </local:LayoutItemsControl>
            <Button Margin="0,4,0,0"
                    Padding="8,2"
                    HorizontalAlignment="Left"
                    Content="{Binding AddItemVisibleText}"
                    Command="{Binding AddItemCommand}"
                    AutomationProperties.Name="{Binding AddItemLabel}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PropertyRowTemplate"
                  DataType="{x:Type panels:PropertyRowViewModel}">
        <local:PropertyRowGrid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- The key text is visual context only — the editor's
                 AutomationName carries the key for AT. -->
            <local:AutomationPresentationTextBlock Text="{Binding Key}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
            <ContentControl Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="{Binding}"
                            Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource PropertyTextEditorTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EditorMode}" Value="datePicker">
                                <Setter Property="ContentTemplate" Value="{StaticResource PropertyDatePickerTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EditorMode}" Value="integer">
                                <Setter Property="ContentTemplate" Value="{StaticResource PropertyNumberEditorTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EditorMode}" Value="float">
                                <Setter Property="ContentTemplate" Value="{StaticResource PropertyNumberEditorTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EditorMode}" Value="boolean">
                                <Setter Property="ContentTemplate" Value="{StaticResource PropertyBooleanEditorTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EditorMode}" Value="wikilink">
                                <Setter Property="ContentTemplate" Value="{StaticResource PropertyWikilinkEditorTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EditorMode}" Value="list">
                                <Setter Property="ContentTemplate" Value="{StaticResource PropertyListEditorTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <WrapPanel Grid.Column="2"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center">
                <!-- Row traversal: editor → Save → Revert (dirty
                     only) → Delete → validation error (§2.3). -->
                <Button Margin="0,0,6,2"
                        Padding="8,2"
                        Content="Save"
                        Command="{Binding CommitCommand}"
                        AutomationProperties.Name="{Binding SaveLabel}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WriteInFlight}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,6,2"
                        Padding="8,2"
                        Content="Revert"
                        Command="{Binding RevertCommand}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="{Binding RevertLabel}"
                        AutomationProperties.HelpText="{Binding RevertHint}" />
                <Button Margin="0,0,0,2"
                        Padding="8,2"
                        Content="Delete"
                        Command="{Binding DeleteCommand}"
                        AutomationProperties.Name="{Binding DeleteLabel}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
                            <Style.Triggers>
                                <!-- Delete is disabled while the draft
                                     is dirty; the reason is exposed as
                                     HelpText (§2.3). -->
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="AutomationProperties.HelpText"
                                            Value="Revert or save this property draft before deleting the property." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Margin="8,2,0,0"
                       Text="{Binding ValidationError}"
                       Foreground="{DynamicResource Slate.WarningBrush}"
                       TextWrapping="Wrap"
                       Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}"
                       AutomationProperties.Name="{Binding ValidationLabel}" />
        </local:PropertyRowGrid>
    </DataTemplate>

    <DataTemplate x:Key="WorkspaceTabContentTemplate"
                  DataType="{x:Type local:WorkspaceTabViewModel}">
        <!-- W7-7 PR 4 (#1247, R-5; the completeness sweep's G17): the tab's
             content contains its arrows. The tab strip is a region of its
             own directly above, and Up from the Properties header selected a
             tab; in a split, Left and Right crossed into the other pane. -->
        <Grid Background="{DynamicResource Slate.WindowBackgroundBrush}"
              KeyboardNavigation.DirectionalNavigation="Contained">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- DS-15 (#1816): the note's header, for Markdown tabs: its folders and name, the
                 Source and Reading switch, and the note's actions. -->
            <local:NoteHeaderView Grid.Row="0"
                                  Visibility="{Binding IsMarkdown, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!-- W4-4 (#736): the in-note properties header — above the
                 editor host, OUTSIDE its scroll viewer (UIA reads
                 Properties before content, where frontmatter lives in
                 the file). Shown in editing and reading modes;
                 collapsed until the per-tab VM attaches (markdown tabs
                 only). -->
            <!-- DS-5: the card scrolls past what leaves the note a few lines of its own.
                 Those lines and the tab strip are text, so the room follows the text's size. -->
            <ScrollViewer Grid.Row="1"
                          Focusable="False"
                          VerticalScrollBarVisibility="Auto"
                          local:WheelChain.IsEnabled="True"
                          Visibility="{Binding Properties, Converter={StaticResource NullToVisibilityConverter}}">
                <ScrollViewer.MaxHeight>
                    <MultiBinding Converter="{StaticResource PropertiesCardMaxHeightConverter}" FallbackValue="395">
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=TabControl}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource AncestorType=TabControl}" />
                    </MultiBinding>
                </ScrollViewer.MaxHeight>
            <Expander Margin="12,8,12,0"
                      IsExpanded="{Binding Properties.IsExpanded, Mode=TwoWay}"
                      Visibility="{Binding Properties, Converter={StaticResource NullToVisibilityConverter}}"
                      AutomationProperties.AutomationId="PropertiesHeader"
                      AutomationProperties.Name="{Binding Properties.HeaderGroupName}">
                <Expander.Header>
                    <!-- #1778: wraps, because a half-width split pane can't fit all three.
                         Tab order is unchanged, and the buttons now draw in that order. -->
                    <WrapPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding Properties.HeaderText}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <Button Margin="0,2,8,2"
                                MinHeight="28"
                                Padding="8,2"
                                AutomationProperties.Name="Rename property across the vault"
                                AutomationProperties.AutomationId="PropertiesBulkRenameButton"
                                Command="{Binding DataContext.Workspace.OpenBulkRenameSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="Rename property across the vault" TextWrapping="Wrap" />
                        </Button>
                        <Button Margin="0,2,8,2"
                                MinHeight="28"
                                Padding="8,2"
                                Content="Add property"
                                AutomationProperties.AutomationId="PropertiesAddButton"
                                AutomationProperties.HelpText="Add a property to this note."
                                Command="{Binding DataContext.Workspace.OpenAddPropertySheetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </WrapPanel>
                </Expander.Header>
                <StackPanel Margin="4,4,4,8">
                    <TextBlock Text="Loading properties"
                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                               Visibility="{Binding Properties.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Properties.LoadError, StringFormat=Error: {0}}"
                               Foreground="{DynamicResource Slate.WarningBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Properties.LoadError, Converter={StaticResource NullToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Properties.EmptyStateText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                               Visibility="{Binding Properties.ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.Name="{Binding Properties.EmptyStateText}" />
                    <!-- Hugs small sets, scrolls internally past
                         ~280px (mac parity), or past what a short pane
                         leaves once the note has room for its text (#1795).
                         The room is text, so it follows the text's size. -->
                    <ScrollViewer Focusable="False"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Properties.HasRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer.MaxHeight>
                            <MultiBinding Converter="{StaticResource PropertyRowsMaxHeightConverter}" FallbackValue="280">
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=TabControl}" />
                                <Binding Path="FontSize" RelativeSource="{RelativeSource AncestorType=TabControl}" />
                            </MultiBinding>
                        </ScrollViewer.MaxHeight>
                        <!-- W7-7 PR 3 (#1246, R-4's one-stop rule): a row's
                             container is layout. As a plain ItemsControl
                             container NVDA read "SlateWindows.Panels.
                             PropertyRowViewModel, data item, 1 of 7", and
                             named by the editor's label it was a second stop
                             reading the editor's own name; the editor and its
                             buttons already carry the key. -->
                        <!-- #1795: the margin keeps Delete out from under the
                             scroll bar, which draws over its content. -->
                        <local:LayoutItemsControl ItemsSource="{Binding Properties.Rows}"
                                      Margin="0,0,12,0"
                                      ItemTemplate="{StaticResource PropertyRowTemplate}"
                                      Focusable="False"
                                      IsTabStop="False"
                                      AutomationProperties.AutomationId="PropertiesRows"
                                      AutomationProperties.Name="{Binding Properties.HeaderGroupName}"
                                      local:PropertiesLanding.IsEnabled="True" />
                    </ScrollViewer>
                </StackPanel>
            </Expander>
            </ScrollViewer>
            <local:SlateTextEditor x:Name="MarkdownEditor"
                                   Grid.Row="2"
                                   Margin="12"
                                   Padding="12"
                                   Document="{Binding EditorDocument}"
                                   HighlightSession="{Binding EditorSession}"
                                   InteractionSession="{Binding EditorInteractions}"
                                   EditorCaretOffset="{Binding EditorCaretOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   WordWrap="True"
                                   ShowLineNumbers="False"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   FontSize="{Binding EditorPreferences.EffectiveFontSize}"
                                   SpellingPreferences="{Binding EditorPreferences}"
                                   Background="{DynamicResource Slate.WindowBackgroundBrush}"
                                   Foreground="{DynamicResource Slate.TextBrush}"
                                   Visibility="{Binding IsEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="MarkdownEditor"
                                   AutomationProperties.Name="{Binding EditorAutomationName}">
                <local:SlateTextEditor.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="_Activate at Cursor"
                                  AutomationProperties.AutomationId="EditorActivateAtCursor"
                                  InputGestureText="{cmd:ChordText slate.editor.activateAtCaret}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}"
                                  Command="{Binding EditorInteractions.ActivateAtCaretCommand}" />
                        <MenuItem Header="Preview _Embed"
                                  AutomationProperties.AutomationId="EditorPreviewEmbed"
                                  InputGestureText="{cmd:ChordText slate.editor.previewEmbed}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}"
                                  Command="{Binding EditorInteractions.PreviewEmbedCommand}" />
                        <Separator />
                        <local:CheckMenuItem Header="Check _Spelling While Typing"
                                  AutomationProperties.AutomationId="EditorToggleSpellCheckContext"
                                  IsCheckable="True"
                                  IsChecked="{Binding EditorPreferences.IsSpellCheckEnabled, Mode=OneWay}"
                                  Command="{Binding EditorPreferences.ToggleSpellCheckCommand}" />
                    </ContextMenu>
                </local:SlateTextEditor.ContextMenu>
            </local:SlateTextEditor>
            <!-- W3-1 (#728): the reading surface swaps in for the editor
                 on the persisted per-tab mode. Same grid cell — one of
                 the two is always collapsed, so UIA never sees both. -->
            <reading:ReadingSurface x:Name="ReadingSurface"
                                    Grid.Row="2"
                                    Margin="12"
                                    Padding="12"
                                    Model="{Binding Reading}"
                                    FontSize="{Binding EditorPreferences.EffectiveFontSize}"
                                    Visibility="{Binding IsReadingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!-- W4-6 (#738): the .base tab body — same shared cell,
                 collapsed unless this tab IS a base, so UIA only ever
                 sees the one live document surface. -->
            <bases:BaseSurfaceView Grid.Row="2"
                                   Tab="{Binding}"
                                   Model="{Binding Base}"
                                   Visibility="{Binding IsBaseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <bases:DashboardSurfaceView Grid.Row="2"
                                        Model="{Binding Dashboard}"
                                        Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!-- W6-1 PR A (#745): the .canvas tab body — same shared
                 cell and the same visibility discipline, so UIA only
                 ever sees the one live document surface. -->
            <canvas:CanvasSurfaceView Grid.Row="2"
                                      Model="{Binding Canvas}"
                                      Visibility="{Binding IsCanvasVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!-- W6-2 PR A (#746): the graph tab body — the placeholder
                 retired for Graph; the same shared cell and visibility
                 discipline as the canvas. -->
            <graph:GraphSurfaceView Grid.Row="2"
                                    Model="{Binding Graph}"
                                    Visibility="{Binding IsGraphVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!-- Keep the modal interaction surface in the tab's presentation
                 source so UIA ownership is stable across providers. The
                 transparent layer intentionally makes Close/Escape the only
                 dismissal paths and prevents pointer input reaching the editor. -->
            <local:AutomationLandmarkGrid Grid.RowSpan="5"
                                          Panel.ZIndex="100"
                                          Background="Transparent"
                                          Visibility="{Binding EditorInteractions.IsPopoverOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                          AutomationProperties.IsDialog="True"
                                          AutomationProperties.AutomationId="EditorInteractionPopover"
                                          AutomationProperties.Name="{Binding EditorInteractions.PopoverAutomationName}">
                <local:EditorInteractionPopoverHost MaxWidth="620"
                                                    MaxHeight="460"
                                                    Margin="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    InteractionSession="{Binding EditorInteractions}"
                                                    KeyboardNavigation.TabNavigation="Cycle"
                                                    KeyboardNavigation.ControlTabNavigation="Cycle">
                    <Border Padding="16"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Slate.BorderBrush}"
                            Background="{DynamicResource Slate.WindowBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding EditorInteractions.PopoverTitle}"
                                   Style="{DynamicResource Slate.BodyStrongTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <!-- W7-7 (#1251, R-8): not a focus stop of its own. Its
                                 read-only text keeps a caret, and a focusable host
                                 took the arrows for scrolling, so a reader heard
                                 line 1 again; the caret now scrolls it. -->
                            <ScrollViewer MaxWidth="560"
                                          MaxHeight="300"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          KeyboardNavigation.TabIndex="2"
                                          AutomationProperties.Name="Scrollable embed preview"
                                          Visibility="{Binding EditorInteractions.HasPopoverEmbed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <local:EditorEmbedPreviewView Root="{Binding EditorInteractions.PopoverEmbedRoot}"
                                                              InteractionSession="{Binding EditorInteractions}" />
                            </ScrollViewer>
                            <StackPanel Visibility="{Binding EditorInteractions.HasPopoverEmbed, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Image MaxWidth="560"
                                       MaxHeight="240"
                                       Stretch="Uniform"
                                       Source="{Binding EditorInteractions.PopoverImage}"
                                       Visibility="{Binding EditorInteractions.HasPopoverImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="{Binding EditorInteractions.PopoverTitle}" />
                                <TextBox MaxWidth="560"
                                         MaxHeight="260"
                                         Padding="0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource Slate.TextBrush}"
                                         Text="{Binding EditorInteractions.PopoverBody, Mode=OneWay}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Preview content" />
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Grid.Row="2"
                                   HorizontalAlignment="Right">
                            <Button Margin="0,0,8,4"
                                    Content="Open source"
                                    KeyboardNavigation.TabIndex="1"
                                    AutomationProperties.AutomationId="EditorPopoverOpenSource"
                                    Command="{Binding EditorInteractions.OpenPopoverSourceCommand}"
                                    Visibility="{Binding EditorInteractions.CanOpenPopoverSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,0,0,4"
                                    Content="Close"
                                    KeyboardNavigation.TabIndex="0"
                                    AutomationProperties.AutomationId="EditorPopoverClose"
                                    Command="{Binding EditorInteractions.ClosePopoverCommand}" />
                        </WrapPanel>
                    </Grid>
                    </Border>
                </local:EditorInteractionPopoverHost>
            </local:AutomationLandmarkGrid>
            <StackPanel Grid.Row="2"
                        Margin="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding KindLabel}"
                           Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Margin="0,8,0,0"
                           MaxWidth="420"
                           Text="{Binding PlaceholderText}"
                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
            <!-- WB-22 (#1112): the find bar, a SIBLING of the note's surfaces,
                 never their child (the editor's Document peer keeps its atomic
                 text, w_c_matrix row 17); its Escape never reaches the text and
                 the text's never reaches it. -->
            <local:FindInNoteBar Grid.Row="3"
                                 DataContext="{Binding FindInNote}"
                                 Editor="{Binding ElementName=MarkdownEditor}"
                                 ReadingSurface="{Binding ElementName=ReadingSurface}" />
            <TextBlock Grid.Row="4"
                       Margin="12,0,12,8"
                       Text="{Binding Status}"
                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WorkspaceGroupTemplate"
                  DataType="{x:Type local:WorkspaceGroupViewModel}">
        <!-- W7-7 PR 3 (#1246, R-4): each pane is one silent structural
             Pane. With the split's host and containers out of the control
             view (the structural split host below), two panes' tab controls
             would otherwise be sibling "Workspace tabs" — axe's
             SiblingUniqueAndFocusable failure. Unnamed on purpose: a Pane
             named "Editor pane" fails NameExcludesControlType, NVDA does
             not speak an unnamed Pane, and W7-6's announcer already says
             "Editor pane 1 of 2, {title}.". (The old name sat on a plain
             Border, which creates no peer, so it never reached UIA.) -->
        <local:AutomationLandmarkBorder Margin="2"
                                        BorderBrush="{DynamicResource Slate.BorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource Slate.WindowBackgroundBrush}">
            <!-- W7-5 (#1239): an EMPTY tab control is not a stop. With zero
                 restored tabs the startup focus landed here, NVDA said only
                 "Workspace tabs tab control", and Down arrow wandered to the
                 menu bar. Focusable and IsTabStop follow HasItems, so focus
                 requests fail closed and the window's fallback seats the
                 Files tree instead. -->
            <Grid>
            <TabControl ItemsSource="{Binding Tabs}"
                        Background="{DynamicResource Slate.SurfaceBrush}"
                        BorderBrush="{DynamicResource Slate.SubtleBorderBrush}"
                        SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                        Focusable="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                        IsTabStop="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                        ItemTemplate="{StaticResource WorkspaceTabHeaderTemplate}"
                        ContentTemplate="{StaticResource WorkspaceTabContentTemplate}"
                        AutomationProperties.AutomationId="WorkspaceTabs" local:SiblingNames.NamePath="Title" local:SiblingNames.DistinguisherPath="Path" local:SiblingNames.Noun="tab" local:SiblingNames.StatePath="SpokenState"
                        AutomationProperties.Name="Workspace tabs">
                <TabControl.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Duplicate Tab" Command="{Binding Owner.DuplicateTabCommand}" />
                        <MenuItem Header="Close Tab" Command="{Binding Owner.CloseActiveTabCommand}" />
                        <Separator />
                        <MenuItem Header="Split Right" Command="{Binding Owner.SplitRightCommand}" />
                        <MenuItem Header="Split Down" Command="{Binding Owner.SplitDownCommand}" />
                        <MenuItem Header="Close Pane" Command="{Binding Owner.ClosePaneCommand}" />
                    </ContextMenu>
                </TabControl.ContextMenu>
                <!-- DS-8: the strip is 36: 4 above the tabs, 32 of tab, and a foot that overlaps
                     the rule under it by one, so the open tab, drawn over the rule, joins the
                     note. The strip shows the window behind it, and an empty pane has none. -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <local:TabStripPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      MinHeight="32"
                                      Margin="8,4,8,-1"
                                      Panel.ZIndex="1"
                                      Background="Transparent"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1" />
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="HeaderPanel" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <!-- W7-7 PR 3 (#1246, R-4; codex PR 3 round 5): the name
                             carries the tab's state as an INPUT to the sibling
                             rule (StatePath above), so the rule's collision
                             checks run over what the reader hears; a trigger
                             appending the state after the rule re-created the
                             duplicates it had removed. The triggers below set
                             only the status. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="Saved" />
                        <!-- #1758: WPF's classic TabItem template hard-codes a white
                             selected tab, so this style has to bring its own. -->
                        <Setter Property="Foreground" Value="{DynamicResource Slate.SecondaryTextBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                        <!-- DS-8: 32 high and up to 240 wide. The floor of 100 is the strip's
                             panel's, because a narrow split has to be able to lower it. -->
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="MaxWidth" Value="240" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Grid>
                                        <Border x:Name="Chrome"
                                                CornerRadius="8,8,0,0"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1,1,1,0" />
                                        <!-- Beside the border, not in it, so its top edge doesn't
                                             add to the close button's 32. -->
                                        <ContentPresenter ContentSource="Header"
                                                          RecognizesAccessKey="True"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                        <!-- On the left edge, overlapping the neighbour by one: the open
                                             tab is drawn above its neighbours, so it covers the ones
                                             beside it, and a row's first tab has nothing to its left. -->
                                        <Border x:Name="Divider"
                                                Width="1"
                                                Height="16"
                                                Margin="-1,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Slate.SubtleBorderBrush}" />
                                        <!-- Selection is a shape too, not colour and tone alone. -->
                                        <Border x:Name="Indicator"
                                                Height="2"
                                                Margin="8,0"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource Slate.AccentIndicatorBrush}"
                                                Visibility="Collapsed" />
                                        <Path x:Name="FlareLeft"
                                              Width="4"
                                              Height="4"
                                              Margin="-4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Bottom"
                                              Data="M4,0 L4,4 L0,4 A4,4 0 0 0 4,0 Z"
                                              Fill="{DynamicResource Slate.SurfaceBrush}"
                                              IsHitTestVisible="False"
                                              Visibility="Collapsed" />
                                        <Path x:Name="FlareRight"
                                              Width="4"
                                              Height="4"
                                              Margin="0,0,-4,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Data="M0,0 L0,4 L4,4 A4,4 0 0 1 0,0 Z"
                                              Fill="{DynamicResource Slate.SurfaceBrush}"
                                              IsHitTestVisible="False"
                                              Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="local:TabStripPanel.IsRowStart" Value="True">
                                            <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Slate.HoverOverlayBrush}" />
                                            <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="1" />
                                            <Setter Property="Background" Value="{DynamicResource Slate.SurfaceBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Slate.TextBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Slate.SubtleBorderBrush}" />
                                            <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="FlareLeft" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="FlareRight" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="AutomationProperties.ItemStatus"
                                        Value="Unsaved changes" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissingFromDisk}" Value="True">
                                <Setter Property="AutomationProperties.ItemStatus"
                                        Value="Missing from disk" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDirty}" Value="True" />
                                    <Condition Binding="{Binding IsMissingFromDisk}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="AutomationProperties.ItemStatus"
                                        Value="Missing from disk; unsaved changes" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.ItemContainerStyle>
            </TabControl>
            <!-- DS-19 (EmptyStateLauncher.prompt.md): with no tabs, the logo, "No note open" and
                 the next actions, each with its chord from the table, as the menus show it. The
                 logo and the title stay out of the tree: a reader hears the empty pane's own line
                 when they land on it (#1774). The actions are Tab stops after the pane's stop,
                 and count as the empty pane for F6 (MainWindow.ShellRegions.cs). -->
            <!-- In a short pane at a large text size the launcher is taller than the pane, so it
                 scrolls, and an action brought the keys scrolls into view. Not a stop itself. -->
            <local:AutomationPresentationScrollViewer x:Name="EmptyPaneLauncherScroll"
                          Focusable="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          local:WheelChain.IsEnabled="True"
                          Visibility="{Binding Visibility, ElementName=EmptyPaneLauncher}">
            <StackPanel x:Name="EmptyPaneLauncher"
                        Margin="24"
                        MaxWidth="320"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- An image brush, not an Image: a brush has no peer. -->
                <Border Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Border.Background>
                        <!-- #1862: decoded at 144 (48 at 300%), as the app menu's logo is at
                             64: the PNG is 1800 square, about 13 MB a pane decoded whole. -->
                        <ImageBrush Stretch="Uniform">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/SlateWindows;component/Assets/slate-gold.png" DecodePixelWidth="144" />
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>
                <local:AutomationPresentationTextBlock Text="No note open"
                                                       Margin="0,0,0,16"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Style="{DynamicResource Slate.SubtitleTextBlockStyle}" />
                <Button Style="{StaticResource Slate.LauncherRowStyle}"
                        Content="Quick Open…"
                        local:LauncherRowPanel.Glyph="&#xE8E5;"
                        Tag="{cmd:ChordText slate.workspace.quickOpen}"
                        AutomationProperties.AutomationId="EmptyPaneQuickOpen"
                        AutomationProperties.Name="Quick Open…"
                        AutomationProperties.AcceleratorKey="{Binding Tag, RelativeSource={RelativeSource Self}}"
                        Command="{Binding DataContext.QuickSwitcher.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource Slate.LauncherRowStyle}"
                        Content="New Note from Template…"
                        local:LauncherRowPanel.Glyph="&#xE710;"
                        Tag="{cmd:ChordText slate.file.newFromTemplate}"
                        AutomationProperties.AutomationId="EmptyPaneNewFromTemplate"
                        AutomationProperties.Name="New Note from Template…"
                        AutomationProperties.AcceleratorKey="{Binding Tag, RelativeSource={RelativeSource Self}}"
                        Command="{Binding DataContext.Workspace.NewFromTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource Slate.LauncherRowStyle}"
                        Content="Search Vault…"
                        local:LauncherRowPanel.Glyph="&#xE721;"
                        Tag="{cmd:ChordText slate.view.toggleSearch}"
                        AutomationProperties.AutomationId="EmptyPaneSearchVault"
                        AutomationProperties.Name="Search Vault…"
                        AutomationProperties.AcceleratorKey="{Binding Tag, RelativeSource={RelativeSource Self}}"
                        Command="{Binding DataContext.ToggleSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
            </local:AutomationPresentationScrollViewer>
            </Grid>
        </local:AutomationLandmarkBorder>
    </DataTemplate>

    <DataTemplate x:Key="WorkspaceNodeChildTemplate"
                  DataType="{x:Type local:WorkspacePaneNodeViewModel}">
        <Grid>
            <ContentControl Focusable="False" Content="{Binding}"
                            ContentTemplate="{DynamicResource WorkspaceNodeTemplate}" />
            <!-- UI Automation migration contract:
                 WorkspaceSplitHandleHorizontal -> WorkspaceSplitHandle
                 former shared WorkspaceSplitHandle -> WorkspaceSplitHandle (horizontal)
                                                     or WorkspaceSplitHandleVertical (vertical)
                 Both Thumb declarations below set these IDs explicitly.
                 Example: ByAutomationId("WorkspaceSplitHandleHorizontal") becomes
                          ByAutomationId("WorkspaceSplitHandle"). See the W1 execution
                 report's UI Automation release and migration note. -->
            <Thumb AutomationProperties.AutomationId="WorkspaceSplitHandle"
                   Width="8"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   Focusable="True"
                   AutomationProperties.Name="Resize editor panes horizontally"
                   AutomationProperties.ItemStatus="{Binding Weight, StringFormat={}{0:P0} of split space}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.HelpText="{x:Static cmd:NavigationHelp.HorizontalSplitter}">
                <Thumb.Style>
                    <Style TargetType="Thumb">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template" Value="{StaticResource Slate.SplitHandleTemplate}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Axis, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         Value="horizontal">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Thumb.Style>
            </Thumb>
            <Thumb AutomationProperties.AutomationId="WorkspaceSplitHandleVertical"
                   Height="8"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Cursor="SizeNS"
                   Focusable="True"
                   AutomationProperties.Name="Resize editor panes vertically"
                   AutomationProperties.ItemStatus="{Binding Weight, StringFormat={}{0:P0} of split space}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.HelpText="{x:Static cmd:NavigationHelp.VerticalSplitter}">
                <Thumb.Style>
                    <Style TargetType="Thumb">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template" Value="{StaticResource Slate.SplitHandleTemplate}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Axis, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         Value="vertical">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Thumb.Style>
            </Thumb>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WorkspaceNodeTemplate"
                  DataType="{x:Type local:WorkspacePaneNodeViewModel}">
        <Grid>
            <ContentControl Focusable="False" Content="{Binding Group}"
                            ContentTemplate="{StaticResource WorkspaceGroupTemplate}"
                            Visibility="{Binding IsGroup, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!-- W7-7 PR 3 (#1246, R-4): a structural split host whose
                 containers are layout. A plain ItemsControl named each pane
                 container by its view model's type, and NVDA spoke
                 "SlateWindows.WorkspacePaneNodeViewModel, data item, 1 of 2"
                 on every pane move; the announcer's "Editor pane 1 of 2,
                 {title}." (W7-6) carries the position instead. The host only
                 arranges the panes, so it is unnamed and out of the control
                 view (codex PR 3 round 4): a split adds no named
                 object-navigation element. -->
            <local:LayoutItemsControl ItemsSource="{Binding Children}"
                                      ItemTemplate="{StaticResource WorkspaceNodeChildTemplate}"
                                      AlternationCount="2147483647"
                                      Visibility="{Binding IsSplit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      IsStructural="True">
                <local:LayoutItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:WeightedSplitPanel Orientation="{Binding DataContext.Axis, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource AxisToOrientationConverter}}" />
                    </ItemsPanelTemplate>
                </local:LayoutItemsControl.ItemsPanel>
            </local:LayoutItemsControl>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
