                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="60" MaxWidth="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBar.ItemContainerStyle>
                    <Style TargetType="StatusBarItem">
                        <Setter Property="Padding" Value="8,0" />
                    </Style>
                </StatusBar.ItemContainerStyle>
                <!-- DS-7: pointer and UIA paths. The keyboard's is the command, so the bar
                     stays one stop. They bind to the toggles, not the visibilities, because
                     a reveal has to finish, and UIA's Toggle runs no command. They disable
                     under a modal surface, as the menu does: the scrim takes no pointer. -->
                <StatusBarItem Grid.Column="0"
                               Padding="0"
                               Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ToggleButton Style="{DynamicResource Slate.SubtleIconToggleButtonStyle}"
                                  Width="24"
                                  Height="24"
                                  Content="&#xE90C;"
                                  Focusable="False"
                                  IsEnabled="{Binding IsModalSurfaceOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                  IsChecked="{Binding Workspace.FilesSidebarToggle}"
                                  AutomationProperties.AutomationId="FilesSidebarToggle"
                                  AutomationProperties.Name="Files sidebar" />
                </StatusBarItem>
                <!-- No vault means no sidebar: an unresolved binding must keep
                     operation controls out of both layout and automation. -->
                <StatusBarItem Grid.Column="1"
                               Visibility="{Binding FileSidebar.ShowTrashProgress, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FileSidebar.TrashStatus}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360"
                                   AutomationProperties.AutomationId="TrashProgressStatus" />
                        <Button Content="Cancel" Margin="8,0,8,0"
                                MinHeight="24"
                                Padding="8,0"
                                Command="{Binding FileSidebar.CancelTrashCommand}"
                                GotKeyboardFocus="TrashCancel_GotKeyboardFocus"
                                LostKeyboardFocus="TrashCancel_LostKeyboardFocus"
                                IsEnabledChanged="TrashCancel_AvailabilityChanged"
                                IsVisibleChanged="TrashCancel_AvailabilityChanged"
                                AutomationProperties.AutomationId="CancelTrash"
                                AutomationProperties.Name="Cancel moving items to the Recycle Bin" />
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem Grid.Column="2">
                    <TextBlock x:Name="StatusTextBlock"
                               AutomationProperties.AutomationId="VaultStatus"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Vault status" />
                </StatusBarItem>
                <Separator Grid.Column="3" />
                <StatusBarItem Grid.Column="4" HorizontalContentAlignment="Stretch">
                    <!-- #1773: a reader can still ask how the last scan ended, so the
                         bar stays in the tree. It only draws fully while work runs. -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.35" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgressActive}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ProgressBar Minimum="0"
                                     AutomationProperties.AutomationId="VaultScanProgress"
                                     Maximum="{Binding ProgressMaximum}"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Height="6"
                                     AutomationProperties.Name="Vault scan progress" />
                    </Border>
                </StatusBarItem>
                <StatusBarItem Grid.Column="5"
                               Padding="0"
                               Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ToggleButton Style="{DynamicResource Slate.SubtleIconToggleButtonStyle}"
                                  Width="24"
                                  Height="24"
                                  Content="&#xE90D;"
                                  Focusable="False"
                                  IsEnabled="{Binding IsModalSurfaceOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                  IsChecked="{Binding Workspace.RightPaneToggle}"
                                  AutomationProperties.AutomationId="RightPaneToggle"
                                  AutomationProperties.Name="Right pane">
                        <ToggleButton.ToolTip>
                            <TextBlock>Right pane (<Run Text="{cmd:ChordText slate.view.toggleRightPane}" />)</TextBlock>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                </StatusBarItem>
            </StatusBar>
        </Border>
            <!-- The design's hairline, inside the row's 24: what it covers is transparent at rest. -->
            <Border Height="1"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Slate.SubtleBorderBrush}"
                    IsHitTestVisible="False" />
            <Border x:Name="ModalScrimOverStatus"
                    Background="{DynamicResource Slate.ScrimBrush}"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsModalSurfaceOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Grid>
            <local:AutomationLandmarkGrid x:Name="WelcomeRoot"
                  KeyboardNavigation.DirectionalNavigation="Contained"
                  Background="{DynamicResource Slate.WindowBackgroundBrush}"
                  AutomationProperties.AutomationId="WelcomeView"
                  AutomationProperties.Name="Welcome"
                  Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  FocusManager.FocusedElement="{Binding ElementName=OpenVaultButton}">
                <local:AutomationLandmarkGrid.Style>
                    <Style TargetType="{x:Type local:AutomationLandmarkGrid}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding QuickSwitcher.IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Search.IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Palette.IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:AutomationLandmarkGrid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <!-- DS-14: 520 at most, and less in a narrow window. -->
                    <ColumnDefinition Width="*" MaxWidth="520" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="1" Focusable="False" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,56,0,32">
                    <TextBlock Text="Welcome to Slate" TextWrapping="Wrap" Style="{DynamicResource Slate.TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Margin="0,8,0,24" TextWrapping="Wrap" Style="{DynamicResource Slate.BodyTextBlockStyle}" Foreground="{DynamicResource Slate.SecondaryTextBrush}" Text="Open a folder of Markdown files to start." />
                    <!-- WB-9 (#1319, WD4): the welcome view holds the keys while a
                         vault opens; its status says what the open is doing. Pull,
                         not push (LiveSetting Off, as every readback here): a
                         press on Open or a recent vault speaks it, through the
                         lifecycle's registered restatement. -->
                    <TextBlock x:Name="WelcomeOpeningStatus"
                               AutomationProperties.AutomationId="WelcomeOpeningStatus"
                               AutomationProperties.LiveSetting="Off"
                               Margin="0,-16,0,24"
                               TextWrapping="Wrap"
                               Text="{Binding StatusText}"
                               Visibility="{Binding IsOpening, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="OpenVaultButton"
                            AutomationProperties.AutomationId="OpenVaultButton"
                            Content="_Open Vault…"
                            Command="{Binding OpenVaultCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Left"
                            Padding="16,8"
                            AutomationProperties.HelpText="Choose a folder to open as a Slate vault." />
                    <StackPanel Visibility="{Binding HasRecentVaults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,32,0,8" Style="{DynamicResource Slate.BodyLargeStrongTextBlockStyle}" Text="Recent Vaults" AutomationProperties.HeadingLevel="Level2" />
                        <!-- W7-7 PR 3 (#1246, R-4): the Button is the stop; its
                             container is layout. As a plain ItemsControl each
                             container was a DataItem named by the RecentVault
                             record's ToString(), and NVDA read the dump. -->
                        <local:LayoutItemsControl ItemsSource="{Binding RecentVaults}"
                                                  AutomationProperties.Name="Recent vaults">
                            <local:LayoutItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,2"
                                            Padding="10,7"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Path}">
                                        <!-- The buttons are siblings now: a shared
                                             display name also carries the path. -->
                                        <AutomationProperties.Name>
                                            <MultiBinding Converter="{StaticResource RecentVaultNameConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.RecentVaults" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.RecentVaults.Count" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}" Style="{DynamicResource Slate.CaptionTextBlockStyle}" Foreground="{DynamicResource Slate.SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </local:LayoutItemsControl.ItemTemplate>
                        </local:LayoutItemsControl>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </local:AutomationLandmarkGrid>

            <local:AutomationLandmarkGrid x:Name="WorkspaceRoot"
                  AutomationProperties.AutomationId="WorkspaceView"
                  AutomationProperties.Name="Workspace"
                  Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- #1690: an overlay disables the workspace under it once the keys have left
                     for its field (MainWindow.LandInOpeningOverlay, in the turn it opens), not
                     as soon as IsOpen changes: these triggers may run before that landing, and
                     disabled with the keys still inside, the focused control went unavailable
                     and NVDA said so before the field. The welcome view's style does the same. -->
                <local:AutomationLandmarkGrid.Style>
                    <Style TargetType="{x:Type local:AutomationLandmarkGrid}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding QuickSwitcher.IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Search.IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Palette.IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:AutomationLandmarkGrid.Style>
                <!-- DS-17 (DSD9): no band above the panes. The vault's name is the Files
                     toolbar's level 1 heading, with its path as the tooltip, and in the
                     window's title (DS-12). -->
                <!-- W7-7 PR 4b (#1247, AR-38): the sidebar widths are the
                     workspace's, so Widen/Narrow Files Sidebar and Widen/Narrow
                     Right Pane step them from the keyboard and a splitter drag
                     writes them back. -->
                <local:WorkspaceRowHost SizeChanged="WorkspaceRow_SizeChanged">
                <Grid x:Name="WorkspaceColumns">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Workspace.FilesColumnWidth, Mode=TwoWay, Converter={StaticResource PixelGridLengthConverter}, FallbackValue=260}" MinWidth="{Binding Workspace.FilesColumnMinimumWidth, FallbackValue=200}" MaxWidth="640" />
                        <ColumnDefinition Width="{Binding Workspace.FilesSplitterWidth, Converter={StaticResource PixelGridLengthConverter}, FallbackValue=5}" />
                        <ColumnDefinition Width="*" MinWidth="{Binding Workspace.EditorColumnMinimumWidth, FallbackValue=270}" />
                        <ColumnDefinition Width="{Binding Workspace.RightPaneSplitterWidth, Converter={StaticResource PixelGridLengthConverter}, FallbackValue=5}" />
                        <ColumnDefinition Width="{Binding Workspace.RightPaneColumnWidth, Mode=TwoWay, Converter={StaticResource PixelGridLengthConverter}, FallbackValue=300}" MinWidth="{Binding Workspace.RightPaneColumnMinimumWidth, FallbackValue=280}" MaxWidth="640" />
                    </Grid.ColumnDefinitions>
                    <!-- DS-7: collapsed, not only narrowed: a zero-width pane still takes Tab. Its
                         DataContext is the sidebar, so the workspace comes from the window. -->
                    <local:AutomationLandmarkBorder x:Name="FilesPaneBorder"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            Visibility="{Binding DataContext.Workspace.IsFilesSidebarVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="FilesPane"
                            AutomationProperties.Name="Files"
                            Background="{DynamicResource Slate.SurfaceBrush}"
                            DataContext="{Binding FileSidebar}">
                        <local:FilesPanePanel Margin="10">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                            <StackPanel>
                                <!-- DS-17: one toolbar, Sidebar.jsx's PanelToolbar: the vault's
                                     name as the level 1 heading (DSD9), New note, Sort and group,
                                     Collapse all, Expand loaded and Refresh. Sort and group's menu
                                     holds the sort, Group by date, Show tag tree and dual pane
                                     (MainWindow.FilesToolbar.cs); its name says the order (DSD12). -->
                                <local:PanelToolbarView x:Name="FilesToolbar"
                                                        Margin="0,0,0,8"
                                                        TitleHeadingLevel="Level1"
                                                        Title="{Binding DataContext.VaultDisplayName, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        TitleToolTip="{Binding DataContext.VaultPath, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                            Content="&#xE710;"
                                            AutomationProperties.AutomationId="SidebarNewNote"
                                            AutomationProperties.Name="New note"
                                            Command="{Binding CreateNoteCommand}" />
                                    <Button x:Name="SidebarSortButton"
                                            Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                            Content="&#xE8CB;"
                                            ToolTip="{Binding SortButtonName}"
                                            AutomationProperties.AutomationId="SidebarSortAndGroup"
                                            AutomationProperties.Name="{Binding SortButtonName, FallbackValue=Sort and group}"
                                            Click="SidebarSortButton_Click" />
                                    <Button Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                            Content="&#xF166;"
                                            AutomationProperties.AutomationId="SidebarCollapseAll"
                                            AutomationProperties.Name="Collapse all"
                                            Command="{Binding CollapseAllCommand}" />
                                    <Button Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                            Content="&#xF164;"
                                            AutomationProperties.AutomationId="SidebarExpandLoaded"
                                            AutomationProperties.Name="Expand loaded folders"
                                            Command="{Binding ExpandLoadedCommand}" />
                                    <Button Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                            Content="&#xE72C;"
                                            AutomationProperties.AutomationId="SidebarRefresh"
                                            AutomationProperties.Name="Refresh files"
                                            Command="{Binding RefreshCommand}" />
                                </local:PanelToolbarView>
                                <!-- #1230: a read-only .slate/sidebar.json stands as a
                                     notice with its Retry beside it (mac's
                                     sidebarPreferencesNotice); the row leaves the tree
                                     with the notice. -->
                                <StackPanel Margin="0,0,0,8"
                                            Visibility="{Binding HasSettingsNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SettingsNotice}"
                                               Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource Slate.WarningBrush}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="SidebarSettingsNotice" />
                                    <Button Margin="0,4,0,0"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            Content="Retry"
                                            AutomationProperties.AutomationId="SidebarSettingsRetry"
                                            AutomationProperties.Name="Retry sidebar settings"
                                            AutomationProperties.HelpText="Reads .slate/sidebar.json again after you repair it."
                                            Command="{Binding RetrySettingsCommand}" />
                                </StackPanel>
                                <!-- W7-7 (R-3): the filter field and its Clear button (enabled while
                                     a filter or tag scope is active — a whitespace tag's scope never
                                     shows in the field); Escape in the field runs the same command. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SidebarFilterTextBox" local:FieldPrompt.IsEnabled="True" local:SearchGlyph.IsEnabled="True"
                                             Grid.Column="0"
                                             MinWidth="0"
                                             AutomationProperties.AutomationId="SidebarFilter"
                                             AutomationProperties.Name="Filter files"
                                             AutomationProperties.HelpText="{x:Static cmd:NavigationHelp.SidebarFilter}"
                                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="SidebarFilterTextBox_PreviewKeyDown"
                                             Padding="6,4"
                                             ToolTip="Filter by words, #tag, path:, ext:, has:task, or @date." />
                                    <Button Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="6,2"
                                            Content="Clear"
                                            AutomationProperties.AutomationId="SidebarFilterClear"
                                            AutomationProperties.Name="Clear filter"
                                            Click="SidebarFilterClear_Click"
                                            Command="{Binding ClearFilterCommand}" />
                                </Grid>
                                <!-- W7-7 PR 4 (#1247, R-5 as the owner amended it): a
                                     landing tree — keys that reach it go on to its
                                     selected tag, else its first tag UNSELECTED, whose
                                     focus applies nothing (LandingTreeView). -->
                                <local:LandingTreeView MaxHeight="120"
                                          Style="{DynamicResource {x:Type TreeView}}"
                                          ItemsSource="{Binding Tags}"
                                          ItemTemplate="{StaticResource SidebarTagTemplate}"
                                          SelectedItemChanged="Tags_SelectedItemChanged"
                                          Visibility="{Binding ShowTags, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.AutomationId="SidebarTagTree"
                                          AutomationProperties.Name="Tags">
                                    <local:LandingTreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource Slate.TreeRowBase}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                            <!-- DS-18: a count row is 32 tall as drawn, its 32 content with no vertical padding. -->
                                            <Setter Property="Padding" Value="8,0" />
                                            <!-- W7-7 (R-3): two-way, so a filter clear releases the
                                                 selection and the same tag can be applied again. -->
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            <!-- W7-7 PR 4b (codex r1 F4): the refresh keeps what the
                                                 reader had open, and opens a nested applied tag's
                                                 ancestors, so its row is there to land on. -->
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        </Style>
                                    </local:LandingTreeView.ItemContainerStyle>
                                </local:LandingTreeView>
                            </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                              <StackPanel>
                                <TextBlock Margin="0,6,0,2"
                                           Text="{Binding BatchSelectionSummary}"
                                           Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                <Expander Header="Batch actions"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarBatchActions">
                                    <StackPanel>
                                        <TextBox Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                                 local:FieldPrompt.IsEnabled="True"
                                                 AutomationProperties.Name="Tag name" />
                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Margin="0,0,4,4" Content="Add" Command="{Binding AddTagCommand}" />
                                            <Button Margin="0,0,4,4" Content="Remove" Command="{Binding RemoveTagCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Margin="0,0,4,4" Content="Move to…" Command="{Binding MoveToCommand}" />
                                            <Button Margin="0,0,4,4" Content="Move checked to Recycle Bin" Command="{Binding BatchTrashCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="SidebarFileActionsExpander"
                                          Header="File actions"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarFileActions">
                                    <StackPanel>
                                        <TextBox x:Name="SidebarMutationNameTextBox" local:FieldPrompt.IsEnabled="True"
                                                 Text="{Binding MutationName, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="SidebarMutationNameTextBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="SidebarMutationName"
                                                 AutomationProperties.Name="File or folder name" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Margin="0,0,4,4" Content="New note" Command="{Binding CreateNoteCommand}" />
                                            <Button Margin="0,0,4,4" Content="New folder" Command="{Binding CreateFolderCommand}" />
                                            <Button Margin="0,0,4,4" Content="Rename" Command="{Binding RenameCommand}" />
                                            <Button Margin="0,0,4,4" Content="Delete" Command="{Binding DeleteCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Margin="0,0,4,4" Content="Duplicate" Command="{Binding DuplicateCommand}" />
                                            <Button Margin="0,0,4,4" Content="Move to…" Command="{Binding MoveToCommand}" />
                                            <Button Margin="0,0,4,4" Content="Copy path" Command="{Binding CopyPathCommand}" />
                                            <Button Margin="0,0,4,4" Content="Reveal in File Explorer" Command="{Binding RevealCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Margin="0,0,4,4" Content="Folder note" Command="{Binding CreateFolderNoteCommand}" />
                                            <Button Margin="0,0,4,4" Content="Delete folder note" Command="{Binding DeleteFolderNoteCommand}" />
                                            <Button Margin="0,0,4,4" Content="Copy link" Command="{Binding CopyWikilinkCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Margin="0,0,4,4" Content="Open" Command="{Binding OpenCurrentCommand}" />
                                            <Button Margin="0,0,4,4" Content="New tab" Command="{Binding OpenNewTabCommand}" />
                                            <Button Margin="0,0,4,4" Content="Split" Command="{Binding OpenSplitCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Margin="0,0,4,4" Content="Pin" Command="{Binding PinCommand}" />
                                            <Button Margin="0,0,4,4" Content="Unpin" Command="{Binding UnpinCommand}" />
                                            <Button Margin="0,0,4,4" Content="Add shortcut" Command="{Binding AddShortcutCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Margin="0,0,4,4" Content="Import…" Command="{Binding ImportCommand}" />
                                            <Button Margin="0,0,4,4" Content="Cancel import" Command="{Binding CancelImportCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Shortcuts"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarShortcutsActions">
                                    <StackPanel>
                                        <ListBox MinHeight="24"
                                                 MaxHeight="100"
                                                 ItemsSource="{Binding Shortcuts}"
                                                 SelectedItem="{Binding SelectedShortcut}"
                                                 DisplayMemberPath="DisplayName"
                                                 AutomationProperties.AutomationId="SidebarShortcuts" local:SiblingNames.NamePath="AutomationName" local:SiblingNames.DistinguisherPath="Path" local:SiblingNames.Noun="shortcut"
                                                 AutomationProperties.Name="File shortcuts">
                                            <!-- R-4 (#1246): DisplayMemberPath templates the
                                                 text only; the container read the record dump. -->
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <Button Margin="0,4,0,0"
                                                HorizontalAlignment="Left"
                                                Content="Remove shortcut"
                                                Command="{Binding RemoveShortcutCommand}" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding Status}"
                                           Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </ScrollViewer>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- W7-7 PR 4 (#1247, R-5; spec review round 23; codex
                                     round 5): the tree and the filter's results
                                     contain their arrows. No landing rests on the bare
                                     tree (MainWindow.LandOnFilesTree: the selected
