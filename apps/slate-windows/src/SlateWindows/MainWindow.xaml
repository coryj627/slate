<Window x:Class="SlateWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SlateWindows"
        xmlns:cmd="clr-namespace:SlateWindows.Commands"
        xmlns:panels="clr-namespace:SlateWindows.Panels"
        xmlns:bases="clr-namespace:SlateWindows.Bases"
        xmlns:grids="clr-namespace:SlateWindows.Grids"
        xmlns:templates="clr-namespace:SlateWindows.Templates"
        Title="Slate"
        Height="720" Width="1120"
        MinHeight="480" MinWidth="760"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="Slate.MainWindow"
        Background="{DynamicResource Slate.WindowBackgroundBrush}"
        Foreground="{DynamicResource Slate.TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenVaultCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding QuickSwitcher.OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Workspace.SaveActiveCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding Workspace.ToggleReadingModeCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding Workspace.CloseActiveTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding Workspace.DuplicateTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding Workspace.ReopenClosedTabCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding Workspace.OpenTasksReviewCommand}" />
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding Workspace.OpenBulkRenameSheetCommand}" />
        <KeyBinding Key="Oem5" Modifiers="Control" Command="{Binding Workspace.SplitRightCommand}" />
        <KeyBinding Key="Oem5" Modifiers="Control+Alt" Command="{Binding Workspace.SplitDownCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control+Shift" Command="{Binding Workspace.NextTabCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control+Shift" Command="{Binding Workspace.PreviousTabCommand}" />
        <KeyBinding Key="Left" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneLeftCommand}" />
        <KeyBinding Key="Right" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneRightCommand}" />
        <KeyBinding Key="Up" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneAboveCommand}" />
        <KeyBinding Key="Down" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneBelowCommand}" />
        <KeyBinding Key="Left" Modifiers="Control+Alt+Shift" Command="{Binding Workspace.MoveTabLeftCommand}" />
        <KeyBinding Key="Right" Modifiers="Control+Alt+Shift" Command="{Binding Workspace.MoveTabRightCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control+Alt" Command="{Binding FileSidebar.HistoryBackCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control+Alt" Command="{Binding FileSidebar.HistoryForwardCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control+Alt" Command="{Binding Workspace.GrowPaneCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control+Alt" Command="{Binding Workspace.ShrinkPaneCommand}" />
        <KeyBinding Key="I" Modifiers="Control+Alt" Command="{Binding Workspace.ToggleRightPaneCommand}" />
        <!-- W4-5 (#737). Ctrl+J is enabled only while a citation is
             expanded, mirroring mac. -->
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding Workspace.JumpToBibliographyCommand}" />
        <KeyBinding Key="J" Modifiers="Control+Shift" Command="{Binding Workspace.OpenCitationSummaryCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Workspace.ActiveGroup.ActiveTab.EditorInteractions.ClosePopoverCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu x:Name="MainMenu"
              DockPanel.Dock="Top"
              AutomationProperties.Name="Application commands">
            <!-- The menu disables under EVERY modal surface — mac
                 parity: AppKit disables the menu bar while a sheet is
                 up, which is why mac's unguarded menu commands are
                 safe. Red-team round 1 (W5-2): only the three overlays
                 were listed here, so Workspace ▸ Search Vault… (and,
                 pre-existing since W1, File ▸ Quick Open…) opened its
                 overlay INVISIBLY beneath any of the seven sheets. One
                 trigger per ModalSurface member, in paint order; the
                 sheets are object properties (open == non-null), so
                 they route through IsNotNullConverter. Gated by
                 ModalSurfaceTests.TheMenuDisablesUnderEveryModalSurface,
                 so surface #11 cannot be forgotten. -->
            <Menu.Style>
                <Style TargetType="Menu">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding QuickSwitcher.IsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Search.IsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Palette.IsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.AddPropertySheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.BulkRenameSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.CitationDetails, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.CitationSummary, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.FilesCiting, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.DashboardEditorSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.BaseQueryBuilderSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.TemplatePickerSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.TemplateFlowSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FileSidebar.MoveToSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.CanvasCardEditorSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Menu.Style>
            <MenuItem Header="_File"
                      AutomationProperties.AutomationId="FileMenu">
                <MenuItem Header="_Open Vault…"
                          AutomationProperties.AutomationId="OpenVaultMenuItem"
                          InputGestureText="{cmd:ChordText slate.vault.open}"
                          Command="{Binding OpenVaultCommand}" />
                <MenuItem Header="_Quick Open…"
                          AutomationProperties.AutomationId="QuickOpenMenuItem"
                          InputGestureText="{cmd:ChordText slate.workspace.quickOpen}"
                          Click="QuickOpen_Click" />
                <Separator />
                <!-- W5-3 (#743): create-from-template. mac homes this in
                     the sidebar action catalog + ⇧⌘N; the Windows menu
                     home is File per the W4 convention. Invokes the
                     workspace command; the modal admission runs inside
                     the open (T9), so a menu invocation under a sheet
                     refuses instead of presenting beneath it (#1118's
                     class). -->
                <MenuItem Header="New Note from _Template…"
                          AutomationProperties.AutomationId="NewFromTemplateMenuItem"
                          InputGestureText="{cmd:ChordText slate.file.newFromTemplate}"
                          Command="{Binding Workspace.NewFromTemplateCommand}" />
                <Separator />
                <MenuItem Header="_Close Vault"
                          AutomationProperties.AutomationId="CloseVaultMenuItem"
                          Command="{Binding CloseVaultCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{x:Static ApplicationCommands.Close}" />
            </MenuItem>
            <MenuItem Header="_Workspace"
                      AutomationProperties.AutomationId="WorkspaceMenu">
                <MenuItem Header="_Duplicate Tab" InputGestureText="{cmd:ChordText slate.workspace.newTab}" Command="{Binding Workspace.DuplicateTabCommand}" />
                <MenuItem Header="_Close Tab" InputGestureText="{cmd:ChordText slate.workspace.closeTab}" Command="{Binding Workspace.CloseActiveTabCommand}" />
                <MenuItem Header="_Reopen Closed Tab" InputGestureText="{cmd:ChordText slate.workspace.reopenClosedTab}" Command="{Binding Workspace.ReopenClosedTabCommand}" />
                <Separator />
                <MenuItem Header="Split _Right" AutomationProperties.AutomationId="SplitRightMenuItem" InputGestureText="{cmd:ChordText slate.workspace.splitRight}" Command="{Binding Workspace.SplitRightCommand}" />
                <MenuItem Header="Split _Down" AutomationProperties.AutomationId="SplitDownMenuItem" InputGestureText="{cmd:ChordText slate.workspace.splitDown}" Command="{Binding Workspace.SplitDownCommand}" />
                <MenuItem Header="Close _Pane" AutomationProperties.AutomationId="ClosePaneMenuItem" Command="{Binding Workspace.ClosePaneCommand}" />
                <Separator />
                <MenuItem Header="Focus Pane _Left" InputGestureText="{cmd:ChordText slate.workspace.focusPaneLeft}" Command="{Binding Workspace.FocusPaneLeftCommand}" />
                <MenuItem Header="Focus Pane _Right" InputGestureText="{cmd:ChordText slate.workspace.focusPaneRight}" Command="{Binding Workspace.FocusPaneRightCommand}" />
                <MenuItem Header="Focus Pane _Above" InputGestureText="{cmd:ChordText slate.workspace.focusPaneAbove}" Command="{Binding Workspace.FocusPaneAboveCommand}" />
                <MenuItem Header="Focus Pane _Below" InputGestureText="{cmd:ChordText slate.workspace.focusPaneBelow}" Command="{Binding Workspace.FocusPaneBelowCommand}" />
                <MenuItem Header="Move Tab Left" InputGestureText="{cmd:ChordText slate.workspace.moveTabLeft}" Command="{Binding Workspace.MoveTabLeftCommand}" />
                <MenuItem Header="Move Tab Right" InputGestureText="{cmd:ChordText slate.workspace.moveTabRight}" Command="{Binding Workspace.MoveTabRightCommand}" />
                <MenuItem Header="_Grow Pane" InputGestureText="{cmd:ChordText slate.workspace.growPane}" Command="{Binding Workspace.GrowPaneCommand}" />
                <MenuItem Header="_Shrink Pane" InputGestureText="{cmd:ChordText slate.workspace.shrinkPane}" Command="{Binding Workspace.ShrinkPaneCommand}" />
                <Separator />
                <MenuItem Header="Toggle Right _Pane" InputGestureText="{cmd:ChordText slate.view.toggleRightPane}" Command="{Binding Workspace.ToggleRightPaneCommand}" />
                <!-- W5-2 close-out (#742): slate.view.toggleSearch. mac
                     homes "Search Vault…" in Edit; Windows has no Edit
                     menu, and its view-section verbs live here beside
                     Toggle Right Pane. Invokes the same unguarded
                     ToggleSearchCommand the palette runs; the
                     Ctrl+Shift+F chord stays imperative in
                     Window_PreviewKeyDown, where the modal gate lives. -->
                <MenuItem Header="Search _Vault…"
                          AutomationProperties.AutomationId="SearchVaultMenuItem"
                          InputGestureText="{cmd:ChordText slate.view.toggleSearch}"
                          Command="{Binding ToggleSearchCommand}" />
                <MenuItem Header="Show Tasks _Review"
                          AutomationProperties.AutomationId="ShowTasksReviewMenuItem"
                          InputGestureText="{cmd:ChordText slate.tasks.review}"
                          Command="{Binding Workspace.OpenTasksReviewCommand}" />
                <!-- W4-7 (#739): slate.history.showPanel — no chord on
                     mac (matrix row); the menu is the chordless
                     surface (contract H11). -->
                <MenuItem Header="Show _History Panel"
                          AutomationProperties.AutomationId="ShowHistoryPanelMenuItem"
                          Command="{Binding Workspace.ShowHistoryPanelCommand}" />
                <!-- Contract H8: the since-open opt-in (mac Settings ▸
                     History), a HOST preference, default off. -->
                <MenuItem Header="Show _Changes Since Last Open"
                          AutomationProperties.AutomationId="HistoryChangesSinceOpenMenuItem"
                          IsCheckable="True"
                          IsChecked="{Binding Workspace.EditorPreferences.HistoryShowChangesSinceOpen, Mode=OneWay}"
                          Command="{Binding Workspace.EditorPreferences.ToggleHistoryChangesSinceOpenCommand}" />
                <!-- W4-8 (#740): slate.diagnostics.refreshSync —
                     CHORDLESS on both platforms (mac: "refresh is a
                     rare, deliberate action"); the menu is the
                     Windows-native chordless surface. It refreshes
                     ONLY — it never reveals the leaf (contract SD7). -->
                <MenuItem Header="Refresh _Sync Diagnostics"
                          AutomationProperties.AutomationId="RefreshSyncDiagnosticsMenuItem"
                          Command="{Binding Workspace.RefreshSyncDiagnosticsCommand}" />
            </MenuItem>
            <!-- W4-6 (#738): every slate.bases.* command reachable and
                 AT-discoverable. Mac ships these palette-only with no
                 chords; a menu is the Windows-native chordless surface
                 (grid-scoped gestures — Ctrl+F, Ctrl+Alt+S — stay on
                 the substrate). Items disable through ActiveBaseDocument. -->
            <MenuItem Header="_Base"
                      AutomationProperties.AutomationId="BaseMenu">
                <MenuItem Header="_Refresh"
                          AutomationProperties.AutomationId="BasesRefreshMenuItem"
                          Command="{Binding Workspace.BasesRefreshCommand}" />
                <MenuItem Header="_Where Am I?"
                          AutomationProperties.AutomationId="BasesWhereAmIMenuItem"
                          Command="{Binding Workspace.BasesWhereAmICommand}" />
                <MenuItem Header="Res_ults"
                          AutomationProperties.AutomationId="BasesResultsMenuItem"
                          Command="{Binding Workspace.BasesResultsCommand}" />
                <Separator />
                <MenuItem Header="_Next View"
                          AutomationProperties.AutomationId="BasesNextViewMenuItem"
                          Command="{Binding Workspace.BasesNextViewCommand}" />
                <MenuItem Header="_Previous View"
                          AutomationProperties.AutomationId="BasesPreviousViewMenuItem"
                          Command="{Binding Workspace.BasesPreviousViewCommand}" />
                <MenuItem Header="Open View _Switcher"
                          AutomationProperties.AutomationId="BasesViewSwitcherMenuItem"
                          Command="{Binding Workspace.BasesViewSwitcherCommand}" />
                <MenuItem Header="View as _Table"
                          AutomationProperties.AutomationId="BasesViewAsTableMenuItem"
                          Command="{Binding Workspace.BasesViewAsTableCommand}" />
                <MenuItem Header="View as _List"
                          AutomationProperties.AutomationId="BasesViewAsListMenuItem"
                          Command="{Binding Workspace.BasesViewAsListCommand}" />
                <Separator />
                <MenuItem Header="Quick _Filter"
                          AutomationProperties.AutomationId="BasesQuickFilterMenuItem"
                          InputGestureText="{cmd:ChordText slate.bases.quickFilter}"
                          Command="{Binding Workspace.BasesQuickFilterCommand}" />
                <MenuItem Header="Sort by _Column"
                          AutomationProperties.AutomationId="BasesSortByColumnMenuItem"
                          InputGestureText="{cmd:ChordText slate.bases.sortByColumn}"
                          Command="{Binding Workspace.BasesSortByColumnCommand}" />
                <MenuItem Header="Save Sort to _View"
                          AutomationProperties.AutomationId="BasesSaveSortMenuItem"
                          Command="{Binding Workspace.BasesSaveSortToViewCommand}" />
                <Separator />
                <MenuItem Header="_Open Row"
                          AutomationProperties.AutomationId="BasesOpenRowMenuItem"
                          Command="{Binding Workspace.BasesOpenRowCommand}" />
                <MenuItem Header="Copy Lin_k"
                          AutomationProperties.AutomationId="BasesCopyLinkMenuItem"
                          Command="{Binding Workspace.BasesCopyLinkCommand}" />
                <MenuItem Header="Show _Backlinks"
                          AutomationProperties.AutomationId="BasesShowBacklinksMenuItem"
                          Command="{Binding Workspace.BasesShowBacklinksCommand}" />
                <MenuItem Header="_Edit Property"
                          AutomationProperties.AutomationId="BasesEditPropertyMenuItem"
                          Command="{Binding Workspace.BasesEditPropertyCommand}" />
                <Separator />
                <MenuItem Header="Export View as _CSV…"
                          AutomationProperties.AutomationId="BasesExportCsvMenuItem"
                          Command="{Binding Workspace.BasesExportCsvCommand}" />
                <MenuItem Header="Export View as _Markdown Table…"
                          AutomationProperties.AutomationId="BasesExportMarkdownMenuItem"
                          Command="{Binding Workspace.BasesExportMarkdownCommand}" />
                <MenuItem Header="Copy View as Mar_kdown"
                          AutomationProperties.AutomationId="BasesCopyMarkdownMenuItem"
                          Command="{Binding Workspace.BasesCopyMarkdownCommand}" />
                <Separator />
                <MenuItem Header="New _Query…"
                          AutomationProperties.AutomationId="BasesNewQueryMenuItem"
                          Command="{Binding Workspace.BasesNewQueryCommand}" />
                <MenuItem Header="Edit View F_ilters…"
                          AutomationProperties.AutomationId="BasesEditViewFiltersMenuItem"
                          Command="{Binding Workspace.BasesEditViewFiltersCommand}" />
            </MenuItem>
            <MenuItem Header="_Editor"
                      AutomationProperties.AutomationId="EditorMenu">
                <MenuItem Header="_Activate at Cursor"
                          AutomationProperties.AutomationId="EditorActivateMenuItem"
                          InputGestureText="{cmd:ChordText slate.editor.activateAtCaret}"
                          Command="{Binding Workspace.ActiveGroup.ActiveTab.EditorInteractions.ActivateAtCaretCommand}" />
                <MenuItem Header="Preview _Embed"
                          AutomationProperties.AutomationId="EditorPreviewEmbedMenuItem"
                          InputGestureText="{cmd:ChordText slate.editor.previewEmbed}"
                          Command="{Binding Workspace.ActiveGroup.ActiveTab.EditorInteractions.PreviewEmbedCommand}" />
                <MenuItem Header="Toggle _Reading Mode"
                          AutomationProperties.AutomationId="EditorToggleReadingModeMenuItem"
                          InputGestureText="{cmd:ChordText slate.editor.toggleViewMode}"
                          Command="{Binding Workspace.ToggleReadingModeCommand}" />
                <Separator />
                <!-- W4-4 (#736): menu-homed so bulk rename works when
                     the properties header isn't mounted; both disable
                     without a session (null Workspace). -->
                <MenuItem Header="Add _Property…"
                          AutomationProperties.AutomationId="AddPropertyMenuItem"
                          Command="{Binding Workspace.OpenAddPropertySheetCommand}" />
                <MenuItem Header="Bulk Rename Pr_operties…"
                          AutomationProperties.AutomationId="BulkRenamePropertiesMenuItem"
                          InputGestureText="{cmd:ChordText slate.editor.bulkRenameProperties}"
                          Command="{Binding Workspace.OpenBulkRenameSheetCommand}" />
                <!-- W4-5 (#737). Both citation commands were bound only
                     in Window.InputBindings, so they had no menu home,
                     no InputGestureText and therefore no UIA
                     AcceleratorKey — a user who did not already know
                     the chord could not reach either one. Reload is
                     menu-only: it is the recovery path after fixing a
                     bad bibliography path, and it has no mac chord. -->
                <MenuItem Header="Citation S_ummary"
                          AutomationProperties.AutomationId="CitationSummaryMenuItem"
                          InputGestureText="{cmd:ChordText slate.editor.citationSummary}"
                          Command="{Binding Workspace.OpenCitationSummaryCommand}" />
                <MenuItem Header="_Jump to Bibliography"
                          AutomationProperties.AutomationId="JumpToBibliographyMenuItem"
                          InputGestureText="{cmd:ChordText slate.navigation.jumpToBibliography}"
                          Command="{Binding Workspace.JumpToBibliographyCommand}" />
                <MenuItem Header="Reloa_d Bibliography"
                          AutomationProperties.AutomationId="ReloadBibliographyMenuItem"
                          AutomationProperties.HelpText="Re-read the vault's bibliography sources after fixing them."
                          Command="{Binding Workspace.ReloadBibliographyCommand}" />
                <Separator />
                <MenuItem Header="Check _Spelling While Typing"
                          AutomationProperties.AutomationId="EditorToggleSpellCheckMenuItem"
                          IsCheckable="True"
                          IsChecked="{Binding Workspace.EditorPreferences.IsSpellCheckEnabled, Mode=OneWay}"
                          Command="{Binding Workspace.EditorPreferences.ToggleSpellCheckCommand}" />
                <MenuItem Header="Open Reading Lin_ks in New Tab"
                          AutomationProperties.AutomationId="EditorToggleReadingLinkTargetMenuItem"
                          IsCheckable="True"
                          IsChecked="{Binding Workspace.EditorPreferences.OpenReadingLinksInNewTab, Mode=OneWay}"
                          Command="{Binding Workspace.EditorPreferences.ToggleReadingLinkTargetCommand}" />
                <MenuItem Header="_Math"
                          AutomationProperties.AutomationId="EditorMathPrefsMenu">
                    <MenuItem Header="Speech Style: _ClearSpeak"
                              AutomationProperties.AutomationId="EditorMathClearSpeakMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathSpeechClearSpeak, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathSpeechStyleCommand}"
                              CommandParameter="clearSpeak" />
                    <MenuItem Header="Speech Style: _SimpleSpeak"
                              AutomationProperties.AutomationId="EditorMathSimpleSpeakMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathSpeechSimpleSpeak, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathSpeechStyleCommand}"
                              CommandParameter="simpleSpeak" />
                    <Separator />
                    <MenuItem Header="Verbosity: _Terse"
                              AutomationProperties.AutomationId="EditorMathTerseMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathVerbosityTerse, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathVerbosityCommand}"
                              CommandParameter="terse" />
                    <MenuItem Header="Verbosity: M_edium"
                              AutomationProperties.AutomationId="EditorMathMediumMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathVerbosityMedium, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathVerbosityCommand}"
                              CommandParameter="medium" />
                    <MenuItem Header="Verbosity: _Verbose"
                              AutomationProperties.AutomationId="EditorMathVerboseMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathVerbosityVerbose, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathVerbosityCommand}"
                              CommandParameter="verbose" />
                    <Separator />
                    <MenuItem Header="Braille: _Nemeth"
                              AutomationProperties.AutomationId="EditorMathNemethMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathBrailleNemeth, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathBrailleCodeCommand}"
                              CommandParameter="nemeth" />
                    <MenuItem Header="Braille: _UEB"
                              AutomationProperties.AutomationId="EditorMathUebMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathBrailleUeb, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathBrailleCodeCommand}"
                              CommandParameter="ueb" />
                </MenuItem>
                <MenuItem Header="Code Preamble _Verbosity"
                          AutomationProperties.AutomationId="EditorCodeVerbosityMenu">
                    <MenuItem Header="Preamble _Only"
                              AutomationProperties.AutomationId="EditorCodeVerbosityPreambleOnlyMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsCodeVerbosityPreambleOnly, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetCodePreambleVerbosityCommand}"
                              CommandParameter="preambleOnly" />
                    <MenuItem Header="Preamble + _First Line"
                              AutomationProperties.AutomationId="EditorCodeVerbosityFirstLineMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsCodeVerbosityFirstLine, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetCodePreambleVerbosityCommand}"
                              CommandParameter="preambleFirstLine" />
                    <MenuItem Header="Preamble + _All Tokens"
                              AutomationProperties.AutomationId="EditorCodeVerbosityAllTokensMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsCodeVerbosityAllTokens, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetCodePreambleVerbosityCommand}"
                              CommandParameter="preambleAllTokens" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Zoom _In"
                          AutomationProperties.AutomationId="EditorZoomInMenuItem"
                          Command="{Binding Workspace.EditorPreferences.ZoomInCommand}" />
                <MenuItem Header="Zoom _Out"
                          AutomationProperties.AutomationId="EditorZoomOutMenuItem"
                          Command="{Binding Workspace.EditorPreferences.ZoomOutCommand}" />
                <MenuItem Header="_Actual Size"
                          AutomationProperties.AutomationId="EditorActualSizeMenuItem"
                          Command="{Binding Workspace.EditorPreferences.ActualSizeCommand}" />
            </MenuItem>
            <!-- W6-1 PR C (#745): every slate.canvas.* command PR C ships,
                 reachable and AT-discoverable without a chord — the Base
                 menu's precedent. Mac ships these palette-only; a menu is
                 the Windows-native chordless surface. Items disable
                 through ActiveCanvasDocument (the mode rows additionally
                 through the mode stack, contract C9). -->
            <MenuItem Header="Ca_nvas"
                      AutomationProperties.AutomationId="CanvasMenu">
                <MenuItem Header="_Where Am I?"
                          AutomationProperties.AutomationId="CanvasWhereAmIMenuItem"
                          InputGestureText="{cmd:ChordText slate.canvas.whereAmI}"
                          Command="{Binding Workspace.CanvasWhereAmICommand}" />
                <Separator />
                <MenuItem Header="_Next Card"
                          AutomationProperties.AutomationId="CanvasNextCardMenuItem"
                          InputGestureText="{cmd:ChordText slate.canvas.nextCard}"
                          Command="{Binding Workspace.CanvasNextCardCommand}" />
                <MenuItem Header="_Previous Card"
                          AutomationProperties.AutomationId="CanvasPreviousCardMenuItem"
                          InputGestureText="{cmd:ChordText slate.canvas.previousCard}"
                          Command="{Binding Workspace.CanvasPreviousCardCommand}" />
                <MenuItem Header="_Enter Group"
                          AutomationProperties.AutomationId="CanvasEnterGroupMenuItem"
                          Command="{Binding Workspace.CanvasEnterGroupCommand}" />
                <MenuItem Header="E_xit Group"
                          AutomationProperties.AutomationId="CanvasExitGroupMenuItem"
                          Command="{Binding Workspace.CanvasExitGroupCommand}" />
                <MenuItem Header="_Follow Connection Forward"
                          AutomationProperties.AutomationId="CanvasFollowForwardMenuItem"
                          InputGestureText="{cmd:ChordText slate.canvas.followConnectionForward}"
                          Command="{Binding Workspace.CanvasFollowConnectionForwardCommand}" />
                <MenuItem Header="Follow Connection _Back"
                          AutomationProperties.AutomationId="CanvasFollowBackMenuItem"
                          InputGestureText="{cmd:ChordText slate.canvas.followConnectionBack}"
                          Command="{Binding Workspace.CanvasFollowConnectionBackCommand}" />
                <MenuItem Header="_Trace Path from Selected Card"
                          AutomationProperties.AutomationId="CanvasTracePathMenuItem"
                          Command="{Binding Workspace.CanvasTracePathCommand}" />
                <Separator />
                <MenuItem Header="F_ilter Cards…"
                          AutomationProperties.AutomationId="CanvasFilterCardsMenuItem"
                          InputGestureText="{cmd:ChordText slate.canvas.filterCards}"
                          Command="{Binding Workspace.CanvasFilterCardsCommand}" />
                <MenuItem Header="_Clear Filter"
                          AutomationProperties.AutomationId="CanvasClearFilterMenuItem"
                          Command="{Binding Workspace.CanvasClearFilterCommand}" />
                <Separator />
                <MenuItem Header="Co_mmit Mode"
                          AutomationProperties.AutomationId="CanvasCommitModeMenuItem"
                          InputGestureText="{cmd:ChordText slate.canvas.commitMode}"
                          Command="{Binding Workspace.CanvasCommitModeCommand}" />
                <MenuItem Header="Cance_l Mode"
                          AutomationProperties.AutomationId="CanvasCancelModeMenuItem"
                          InputGestureText="{cmd:ChordText slate.canvas.cancelMode}"
                          Command="{Binding Workspace.CanvasCancelModeCommand}" />
                <Separator />
                <MenuItem Header="Toggle Viewport Follows _Selection"
                          AutomationProperties.AutomationId="CanvasToggleFollowSelectionMenuItem"
                          Command="{Binding Workspace.CanvasToggleFollowSelectionCommand}" />
                <Separator />
                <!-- t0 §1.2, contract C13. CHECK items bound OneWay to
                     the level (WPF has no radio menu item): the screen
                     reader speaks the selected level from the element
                     itself, which is why the setting needs no
                     announcement of its own. -->
                <MenuItem Header="_Verbosity"
                          AutomationProperties.AutomationId="CanvasVerbosityMenu">
                    <MenuItem Header="_Terse"
                              AutomationProperties.AutomationId="CanvasVerbosityTerseMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.CanvasPreferences.IsVerbosityTerse, Mode=OneWay}"
                              Command="{Binding Workspace.CanvasPreferences.SetVerbosityCommand}"
                              CommandParameter="terse" />
                    <MenuItem Header="_Standard"
                              AutomationProperties.AutomationId="CanvasVerbosityStandardMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.CanvasPreferences.IsVerbosityStandard, Mode=OneWay}"
                              Command="{Binding Workspace.CanvasPreferences.SetVerbosityCommand}"
                              CommandParameter="standard" />
                    <MenuItem Header="_Verbose"
                              AutomationProperties.AutomationId="CanvasVerbosityVerboseMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.CanvasPreferences.IsVerbosityVerbose, Mode=OneWay}"
                              Command="{Binding Workspace.CanvasPreferences.SetVerbosityCommand}"
                              CommandParameter="verbose" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Files">
                <MenuItem Header="_Open" Command="{Binding FileSidebar.OpenCurrentCommand}" />
                <MenuItem Header="Open in New _Tab" Command="{Binding FileSidebar.OpenNewTabCommand}" />
                <MenuItem Header="Open in _Split" Command="{Binding FileSidebar.OpenSplitCommand}" />
                <Separator />
                <MenuItem Header="_Import Files and Folders…" Command="{Binding FileSidebar.ImportCommand}" />
                <MenuItem Header="_Cancel Import" Command="{Binding FileSidebar.CancelImportCommand}" />
                <Separator />
                <MenuItem Header="_Refresh" Command="{Binding FileSidebar.RefreshCommand}" />
                <MenuItem Header="_Collapse All" Command="{Binding FileSidebar.CollapseAllCommand}" />
                <MenuItem Header="_Expand Loaded" Command="{Binding FileSidebar.ExpandLoadedCommand}" />
                <MenuItem Header="Focus _Filter" InputGestureText="{cmd:ChordText slate.sidebar.focusFilter}" Click="FocusFilter_Click" />
                <MenuItem Header="_Back" InputGestureText="{cmd:ChordText slate.sidebar.historyBack}" Command="{Binding FileSidebar.HistoryBackCommand}" />
                <MenuItem Header="_Forward" InputGestureText="{cmd:ChordText slate.sidebar.historyForward}" Command="{Binding FileSidebar.HistoryForwardCommand}" />
                <Separator />
                <MenuItem Header="_Pin Note" Command="{Binding FileSidebar.PinCommand}" />
                <MenuItem Header="_Unpin Note" Command="{Binding FileSidebar.UnpinCommand}" />
                <MenuItem Header="Unpin _All in Folder" Command="{Binding FileSidebar.UnpinAllCommand}" />
                <MenuItem Header="Add to _Shortcuts" Command="{Binding FileSidebar.AddShortcutCommand}" />
                <MenuItem Header="_Remove Shortcut" Command="{Binding FileSidebar.RemoveShortcutCommand}" />
                <MenuItem Header="Use Vault Default _Sort" Command="{Binding FileSidebar.UseVaultDefaultSortCommand}" />
                <MenuItem Header="Clear _Recents" Command="{Binding FileSidebar.ClearRecentsCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock"
                           AutomationProperties.AutomationId="VaultStatus"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Vault status" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch" Width="180">
                <ProgressBar Minimum="0"
                             AutomationProperties.AutomationId="VaultScanProgress"
                             Maximum="{Binding ProgressMaximum}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Height="6"
                             AutomationProperties.Name="Vault scan progress" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <local:AutomationLandmarkGrid x:Name="WelcomeRoot"
                  Background="{DynamicResource Slate.WindowBackgroundBrush}"
                  AutomationProperties.AutomationId="WelcomeView"
                  AutomationProperties.Name="Welcome"
                  Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  FocusManager.FocusedElement="{Binding ElementName=OpenVaultButton}">
                <local:AutomationLandmarkGrid.Style>
                    <Style TargetType="{x:Type local:AutomationLandmarkGrid}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding QuickSwitcher.IsOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Search.IsOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Palette.IsOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:AutomationLandmarkGrid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="520" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Margin="0,56,0,32">
                    <TextBlock Text="Welcome to Slate" FontSize="30" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Margin="0,8,0,24" FontSize="15" Foreground="{DynamicResource Slate.SecondaryTextBrush}" Text="Open a folder of Markdown files to start." />
                    <Button x:Name="OpenVaultButton"
                            AutomationProperties.AutomationId="OpenVaultButton"
                            Content="_Open Vault…"
                            Command="{Binding OpenVaultCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Left"
                            Padding="16,8"
                            AutomationProperties.HelpText="Choose a folder to open as a Slate vault." />
                    <StackPanel Visibility="{Binding HasRecentVaults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,32,0,8" FontSize="18" FontWeight="SemiBold" Text="Recent Vaults" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{Binding RecentVaults}"
                                      AutomationProperties.Name="Recent vaults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,2"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            Padding="10,7"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Path}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource Slate.SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkGrid>

            <local:AutomationLandmarkGrid x:Name="WorkspaceRoot"
                  AutomationProperties.AutomationId="WorkspaceView"
                  AutomationProperties.Name="Workspace"
                  Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <local:AutomationLandmarkGrid.Style>
                    <Style TargetType="{x:Type local:AutomationLandmarkGrid}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding QuickSwitcher.IsOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Search.IsOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Palette.IsOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:AutomationLandmarkGrid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource Slate.RaisedSurfaceBrush}" BorderBrush="{DynamicResource Slate.BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding VaultDisplayName}" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Text="{Binding VaultPath}" FontSize="12" Foreground="{DynamicResource Slate.SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="200" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="280" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <local:AutomationLandmarkBorder x:Name="FilesPaneBorder"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="FilesPane"
                            AutomationProperties.Name="Files"
                            Background="{DynamicResource Slate.SurfaceBrush}"
                            BorderBrush="{DynamicResource Slate.BorderBrush}"
                            BorderThickness="0,0,1,0"
                            DataContext="{Binding FileSidebar}">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Files"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <Button DockPanel.Dock="Right"
                                            Padding="6,2"
                                            Content="↻"
                                            ToolTip="Refresh"
                                            AutomationProperties.AutomationId="SidebarRefresh"
                                            AutomationProperties.Name="Refresh files"
                                            Command="{Binding RefreshCommand}" />
                                </DockPanel>
                                <TextBox x:Name="SidebarFilterTextBox"
                                         AutomationProperties.AutomationId="SidebarFilter"
                                         AutomationProperties.Name="Filter files"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         ToolTip="Filter by words, tag:, path:, or @date." />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                    <ComboBox Width="145"
                                              ItemsSource="{Binding SortModes}"
                                              SelectedItem="{Binding SortMode}"
                                              AutomationProperties.AutomationId="SidebarSortOrder"
                                              AutomationProperties.Name="File sort order">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SidebarSortModeLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="Group dates"
                                              AutomationProperties.AutomationId="SidebarGroupDates"
                                              IsChecked="{Binding GroupByDate}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ToggleButton Content="Tags"
                                                  IsChecked="{Binding ShowTags}"
                                                  AutomationProperties.AutomationId="SidebarShowTags"
                                                  AutomationProperties.Name="Show tag tree" />
                                    <ToggleButton Margin="6,0,0,0"
                                                  Content="Dual pane"
                                                  IsChecked="{Binding IsDualPaneEnabled}"
                                                  AutomationProperties.AutomationId="SidebarDualPaneToggle"
                                                  AutomationProperties.Name="Enable dual-pane files sidebar" />
                                </StackPanel>
                                <TreeView MaxHeight="120"
                                          ItemsSource="{Binding Tags}"
                                          ItemTemplate="{StaticResource SidebarTagTemplate}"
                                          SelectedItemChanged="Tags_SelectedItemChanged"
                                          Visibility="{Binding ShowTags, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          AutomationProperties.AutomationId="SidebarTagTree"
                                          AutomationProperties.Name="Tags">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </StackPanel>
                            <ScrollViewer Focusable="False" DockPanel.Dock="Bottom"
                                          MaxHeight="210"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                              <StackPanel>
                                <TextBlock Margin="0,6,0,2"
                                           Text="{Binding BatchSelectionSummary}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                <Expander Header="Batch actions"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarBatchActions">
                                    <StackPanel>
                                        <TextBox Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Tag name" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Add" Command="{Binding AddTagCommand}" />
                                            <Button Margin="4,0,0,0" Content="Remove" Command="{Binding RemoveTagCommand}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Move to…" Command="{Binding MoveToCommand}" />
                                            <Button Margin="4,0,0,0" Content="Move checked to Recycle Bin" Command="{Binding BatchTrashCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="SidebarFileActionsExpander"
                                          Header="File actions"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarFileActions">
                                    <StackPanel>
                                        <TextBox x:Name="SidebarMutationNameTextBox"
                                                 Text="{Binding MutationName, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="SidebarMutationNameTextBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="SidebarMutationName"
                                                 AutomationProperties.Name="File or folder name" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="New note" Command="{Binding CreateNoteCommand}" />
                                            <Button Margin="4,0,0,0" Content="New folder" Command="{Binding CreateFolderCommand}" />
                                            <Button Margin="4,0,0,0" Content="Rename" Command="{Binding RenameCommand}" />
                                            <Button Margin="4,0,0,0" Content="Delete" Command="{Binding DeleteCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" />
                                            <Button Margin="4,0,0,0" Content="Move to…" Command="{Binding MoveToCommand}" />
                                            <Button Margin="4,0,0,0" Content="Copy path" Command="{Binding CopyPathCommand}" />
                                            <Button Margin="4,0,0,0" Content="Reveal in File Explorer" Command="{Binding RevealCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Folder note" Command="{Binding CreateFolderNoteCommand}" />
                                            <Button Margin="4,0,0,0" Content="Delete folder note" Command="{Binding DeleteFolderNoteCommand}" />
                                            <Button Margin="4,0,0,0" Content="Copy link" Command="{Binding CopyWikilinkCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Open" Command="{Binding OpenCurrentCommand}" />
                                            <Button Margin="4,0,0,0" Content="New tab" Command="{Binding OpenNewTabCommand}" />
                                            <Button Margin="4,0,0,0" Content="Split" Command="{Binding OpenSplitCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Pin" Command="{Binding PinCommand}" />
                                            <Button Margin="4,0,0,0" Content="Unpin" Command="{Binding UnpinCommand}" />
                                            <Button Margin="4,0,0,0" Content="Add shortcut" Command="{Binding AddShortcutCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Import…" Command="{Binding ImportCommand}" />
                                            <Button Margin="4,0,0,0" Content="Cancel import" Command="{Binding CancelImportCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Shortcuts"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarShortcutsActions">
                                    <StackPanel>
                                        <ListBox MinHeight="24"
                                                 MaxHeight="100"
                                                 ItemsSource="{Binding Shortcuts}"
                                                 SelectedItem="{Binding SelectedShortcut}"
                                                 DisplayMemberPath="DisplayName"
                                                 AutomationProperties.AutomationId="SidebarShortcuts"
                                                 AutomationProperties.Name="File shortcuts" />
                                        <Button Margin="0,4,0,0"
                                                HorizontalAlignment="Left"
                                                Content="Remove shortcut"
                                                Command="{Binding RemoveShortcutCommand}" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding Status}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </ScrollViewer>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TreeView x:Name="FilesTree"
                                              ItemsSource="{Binding RootNodes}"
                                              ItemTemplate="{StaticResource FileTreeNodeTemplate}"
                                              TextSearch.TextPath="DisplayName"
                                              SelectedItemChanged="FilesTree_SelectedItemChanged"
                                              Visibility="{Binding IsFilterActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              AutomationProperties.AutomationId="FilesTree"
                                              AutomationProperties.Name="Files">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                <!-- W5-4 verification: the VM→view selection
                                                     channel — a mutation's publication re-seats
                                                     selection on the FRESH node, and without this
                                                     binding the restore was invisible and the
                                                     next arrow key jumped to the tree top. -->
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                    <ListBox x:Name="FilterResultsList"
                                             ItemsSource="{Binding FilterResults}"
                                             SelectionChanged="FilterResults_SelectionChanged"
                                             Visibility="{Binding IsFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.AutomationId="SidebarFilterResults"
                                             AutomationProperties.Name="Filtered files">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding Path}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                                <ListBox Grid.Row="1"
                                         MaxHeight="150"
                                         Margin="0,6,0,0"
                                         ItemsSource="{Binding DualPaneFiles}"
                                         SelectionChanged="DualPaneFiles_SelectionChanged"
                                         DisplayMemberPath="DisplayName"
                                         Visibility="{Binding IsDualPaneEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.AutomationId="SidebarDualPane"
                                         AutomationProperties.Name="Files in selected folder" />
                            </Grid>
                        </DockPanel>
                    </local:AutomationLandmarkBorder>
                    <GridSplitter Grid.Column="1"
                                  Background="{DynamicResource Slate.BorderBrush}"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  AutomationProperties.Name="Resize files sidebar" />
                    <local:AutomationLandmarkBorder x:Name="ContentPaneBorder"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="ContentPane"
                            AutomationProperties.Name="Editor workspace"
                            Background="{DynamicResource Slate.WindowBackgroundBrush}"
                            DataContext="{Binding Workspace}">
                        <ContentControl Content="{Binding Root}"
                                        ContentTemplate="{StaticResource WorkspaceNodeTemplate}"
                                        GotKeyboardFocus="WorkspaceContent_GotKeyboardFocus"
                                        AutomationProperties.Name="Workspace editor panes" />
                    </local:AutomationLandmarkBorder>
                    <GridSplitter Grid.Column="3"
                                  Background="{DynamicResource Slate.BorderBrush}"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  AutomationProperties.Name="Resize right pane" />
                    <local:AutomationLandmarkBorder Grid.Column="4"
                            AutomationProperties.AutomationId="InspectorPane"
                            AutomationProperties.Name="Inspector"
                            Background="{DynamicResource Slate.SurfaceBrush}"
                            BorderBrush="{DynamicResource Slate.BorderBrush}"
                            BorderThickness="1,0,0,0"
                            DataContext="{Binding Workspace}"
                            Visibility="{Binding IsRightPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <local:AutomationLandmarkBorder.Resources>
                            <!-- Empty/loading sentence: collapses when the bound
                                 message is null (the list has content). -->
                            <Style x:Key="PanelEmptyMessage" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Slate.SecondaryTextBrush}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="0,8,0,8" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="PanelHeading" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
                            </Style>
                            <!-- Rows carry the composed mac label + per-state hint. -->
                            <Style x:Key="PanelRowContainer" TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                            </Style>
                            <Style x:Key="PanelListBox" TargetType="ListBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            </Style>
                            <!-- W4-3: one note-task row — checkbox (pointer
                                 toggle; Space on the row is the keyboard route)
                                 plus text and the optional metadata caption. -->
                            <DataTemplate x:Key="PanelTaskRowTemplate">
                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Completed, Mode=OneWay}"
                                              Focusable="False"
                                              Margin="0,2,6,0"
                                              VerticalAlignment="Top"
                                              Click="PanelTaskCheckbox_Click"
                                              AutomationProperties.Name="{Binding CheckboxLabel}"
                                              AutomationProperties.HelpText="{Binding CheckboxHelpText}" />
                                    <StackPanel>
                                        <local:AutomationPresentationTextBlock x:Name="TaskText"
                                                                               Text="{Binding DisplayText}"
                                                                               TextWrapping="Wrap" />
                                        <local:AutomationPresentationTextBlock x:Name="TaskMetadata"
                                                                               Text="{Binding MetadataCaption}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Completed}" Value="True">
                                        <Setter TargetName="TaskText" Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                        <Setter TargetName="TaskMetadata" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </local:AutomationLandmarkBorder.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <!-- W4-2 (#734): the four link/structure leaves. The
                                 inactive bodies collapse (out of the UIA tree - the
                                 mac accessibilityHidden gating); collections live on
                                 Workspace.Panels, so switching never refetches. -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="backlinks">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding Panels.BacklinksHeader}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.BacklinksEmptyMessage}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.BacklinksTruncationNotice}" />
                                <ListBox x:Name="PanelBacklinksList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Panels.Backlinks}"
                                         ItemContainerStyle="{StaticResource PanelRowContainer}"
                                         MouseDoubleClick="PanelBacklinks_MouseDoubleClick"
                                         PreviewKeyDown="PanelBacklinks_PreviewKeyDown"
                                         ContextMenuOpening="PanelBacklinks_ContextMenuOpening"
                                         AutomationProperties.AutomationId="PanelBacklinksList"
                                         AutomationProperties.Name="Backlinks">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open" Click="PanelBacklinksOpen_Click" />
                                            <MenuItem Header="Open in New Tab" Click="PanelBacklinksOpenNewTab_Click" />
                                            <MenuItem Header="Open in Split" Click="PanelBacklinksOpenSplit_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <local:AutomationPresentationTextBlock Text="{Binding FileName}"
                                                                                       FontWeight="SemiBold" />
                                                <local:AutomationPresentationTextBlock Text="{Binding Snippet}"
                                                                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                                                       TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outgoingLinks">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding Panels.OutgoingLinksHeader}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.OutgoingLinksEmptyMessage}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.OutgoingLinksTruncationNotice}" />
                                <ListBox x:Name="PanelOutgoingLinksList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Panels.OutgoingLinks}"
                                         ItemContainerStyle="{StaticResource PanelRowContainer}"
                                         MouseDoubleClick="PanelOutgoingLinks_MouseDoubleClick"
                                         PreviewKeyDown="PanelOutgoingLinks_PreviewKeyDown"
                                         ContextMenuOpening="PanelOutgoingLinks_ContextMenuOpening"
                                         AutomationProperties.AutomationId="PanelOutgoingLinksList"
                                         AutomationProperties.Name="Outgoing links">
                                    <ListBox.ContextMenu>
                                        <!-- Items are gated per row state in ContextMenuOpening:
                                             internal rows get the tab/split set, external rows the
                                             browser action, unresolved rows no menu at all. -->
                                        <ContextMenu>
                                            <MenuItem Header="Open" Tag="internal" Click="PanelOutgoingLinksOpen_Click" />
                                            <MenuItem Header="Open in New Tab" Tag="internal" Click="PanelOutgoingLinksOpenNewTab_Click" />
                                            <MenuItem Header="Open in Split" Tag="internal" Click="PanelOutgoingLinksOpenSplit_Click" />
                                            <MenuItem Header="Open in Browser" Tag="external" Click="PanelOutgoingLinksOpenBrowser_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:AutomationPresentationTextBlock x:Name="TargetText"
                                                                                           Text="{Binding DisplayTarget}"
                                                                                           FontWeight="SemiBold" />
                                                    <!-- The state chip: the role is folded into the row
                                                         label, so the chip stays out of the UIA name. -->
                                                    <Border x:Name="BadgeChip"
                                                            Margin="6,0,0,0"
                                                            Padding="6,1"
                                                            CornerRadius="4"
                                                            BorderThickness="0.5"
                                                            BorderBrush="{DynamicResource Slate.BorderBrush}">
                                                        <local:AutomationPresentationTextBlock Text="{Binding Badge}"
                                                                                               FontSize="11"
                                                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <local:AutomationPresentationTextBlock x:Name="SnippetText"
                                                                                       Text="{Binding Snippet}"
                                                                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                                                       TextWrapping="Wrap" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUnresolved}" Value="True">
                                                    <Setter TargetName="TargetText" Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter TargetName="TargetText" Property="Foreground" Value="{DynamicResource Slate.WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                    <Setter TargetName="BadgeChip" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasSnippet}" Value="False">
                                                    <Setter TargetName="SnippetText" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outline">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="Outline" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.OutlineEmptyMessage}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.OutlineTruncationNotice}" />
                                <ListBox x:Name="PanelOutlineList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Panels.Outline}"
                                         MouseDoubleClick="PanelOutline_MouseDoubleClick"
                                         PreviewKeyDown="PanelOutline_PreviewKeyDown"
                                         AutomationProperties.AutomationId="PanelOutlineList"
                                         AutomationProperties.Name="Outline">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Border Width="{Binding Indent}" />
                                                <local:AutomationPresentationTextBlock Text="{Binding Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="embeds">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding Panels.EmbedsHeader}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.EmbedsEmptyMessage}" />
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Panels.Embeds}"
                                                  AutomationProperties.AutomationId="PanelEmbedsList"
                                                  AutomationProperties.Name="Embeds">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <!-- G24: the core preview budgets bound the panel's
                                                         resolution; the clip is explicit, never silent. -->
                                                    <TextBlock x:Name="TruncationNotice"
                                                               Text="Preview truncated."
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                    <local:EditorEmbedPreviewView Root="{Binding Node}"
                                                                                  Loaded="PanelEmbedView_Loaded" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Truncated}" Value="False">
                                                        <Setter TargetName="TruncationNotice" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- W4-3 (#735): the note-scoped Tasks leaf — the mac
                                 TasksPanel shape: header with true totals, Open
                                 then Done sections (grouped by the COMPLETED
                                 derivation), checkbox + activation per row. Rows
                                 are display-capped VM-side, so the non-virtualized
                                 sections stay bounded. -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasks">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding Panels.TasksHeader}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.TasksEmptyMessage}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.TasksTruncationNotice}" />
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock x:Name="PanelTasksOpenHeader"
                                                   Text="{Binding Panels.OpenTasksGroupHeader}"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <ListBox x:Name="PanelTasksOpenList"
                                                 Style="{StaticResource PanelListBox}"
                                                 ItemsSource="{Binding Panels.OpenTasks}"
                                                 ItemContainerStyle="{StaticResource PanelRowContainer}"
                                                 ItemTemplate="{StaticResource PanelTaskRowTemplate}"
                                                 MouseDoubleClick="PanelTasks_MouseDoubleClick"
                                                 PreviewKeyDown="PanelTasks_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PanelTasksOpenList"
                                                 AutomationProperties.Name="Open tasks" />
                                        <TextBlock x:Name="PanelTasksDoneHeader"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding Panels.DoneTasksGroupHeader}"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <ListBox x:Name="PanelTasksDoneList"
                                                 Style="{StaticResource PanelListBox}"
                                                 ItemsSource="{Binding Panels.DoneTasks}"
                                                 ItemContainerStyle="{StaticResource PanelRowContainer}"
                                                 ItemTemplate="{StaticResource PanelTaskRowTemplate}"
                                                 MouseDoubleClick="PanelTasks_MouseDoubleClick"
                                                 PreviewKeyDown="PanelTasks_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PanelTasksDoneList"
                                                 AutomationProperties.Name="Done tasks" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- W4-3 (#735): the vault-wide Tasks Review leaf — the
                                 mac TasksReviewPanel flow: pinned filter chips
                                 (focus-then-activate, never commit-on-arrow), a
                                 paged row list, and an explicit Load more row. -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasksReview">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding TasksReview.Header}" />
                                <!-- Radio buttons, not plain buttons (adversarial
                                     round 3): the active filter is a real UIA
                                     selection state with a non-color visual, and
                                     WPF radios keep the mac chip semantics — arrow
                                     keys move focus without committing; Space or
                                     click commits. -->
                                <WrapPanel DockPanel.Dock="Top"
                                           Margin="0,0,0,6"
                                           AutomationProperties.Name="Filter">
                                    <RadioButton x:Name="PanelReviewFilterAll"
                                                 Content="All"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.AllFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.AllFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to all tasks." />
                                    <RadioButton x:Name="PanelReviewFilterDueToday"
                                                 Content="Due today"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.DueTodayFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.DueTodayFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to due today tasks." />
                                    <RadioButton x:Name="PanelReviewFilterOverdue"
                                                 Content="Overdue"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.OverdueFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.OverdueFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to overdue tasks." />
                                    <RadioButton x:Name="PanelReviewFilterThisWeek"
                                                 Content="This week"
                                                 GroupName="PanelReviewFilters"
                                                 IsChecked="{Binding TasksReview.ThisWeekFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.ThisWeekFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to this week tasks." />
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding TasksReview.EmptyMessage}" />
                                <Button x:Name="PanelReviewLoadMore"
                                        DockPanel.Dock="Bottom"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Content="{Binding TasksReview.LoadMoreLabel}"
                                        Click="PanelReviewLoadMore_Click"
                                        Visibility="{Binding TasksReview.HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="{Binding TasksReview.LoadMoreAutomationName}"
                                        AutomationProperties.HelpText="{Binding TasksReview.LoadMoreHelpText}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TasksReview.IsLoadingMore}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ListBox x:Name="PanelReviewList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding TasksReview.Rows}"
                                         ItemContainerStyle="{StaticResource PanelRowContainer}"
                                         MouseDoubleClick="PanelReview_MouseDoubleClick"
                                         PreviewKeyDown="PanelReview_PreviewKeyDown"
                                         AutomationProperties.AutomationId="PanelReviewList"
                                         AutomationProperties.Name="Tasks Review">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Completed, Mode=OneWay}"
                                                          Focusable="False"
                                                          Margin="0,2,6,0"
                                                          VerticalAlignment="Top"
                                                          Click="PanelReviewCheckbox_Click"
                                                          AutomationProperties.Name="{Binding CheckboxLabel}"
                                                          AutomationProperties.HelpText="{Binding CheckboxHelpText}" />
                                                <StackPanel>
                                                    <local:AutomationPresentationTextBlock Text="{Binding FileName}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                    <local:AutomationPresentationTextBlock x:Name="ReviewTaskText"
                                                                                           Text="{Binding DisplayText}"
                                                                                           TextWrapping="Wrap" />
                                                    <local:AutomationPresentationTextBlock x:Name="ReviewTaskMetadata"
                                                                                           Text="{Binding MetadataCaption}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Completed}" Value="True">
                                                    <Setter TargetName="ReviewTaskText" Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                                    <Setter TargetName="ReviewTaskMetadata" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- ==========================================
                                 W4-5 (#737): the citations leaf. Row text
                                 is the core artifact verbatim (contract
                                 1) and an unresolved row is a real state,
                                 not an error (contract 7). Activation
                                 opens the details overlay, which is an
                                 in-window sheet rather than an anchored
                                 popover (D-1).
                                 ========================================== -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="citations">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{x:Static panels:CitationPhrase.CitationsHeading}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.NoFileText}"
                                           Visibility="{Binding Citations.ShowNoFileState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.LoadingVisibleText}"
                                           Visibility="{Binding Citations.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.EmptyText}"
                                           Visibility="{Binding Citations.ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!-- Load notices are surfaced verbatim and
                                     never swallowed (contract 5). -->
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.ErrorSpoken}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Citations.ErrorSpoken, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                                           Focusable="True"
                                           AutomationProperties.AutomationId="PanelCitationsError" />
                                <ListBox x:Name="PanelCitationsList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Citations.Rows}"
                                         SelectionChanged="PanelCitations_SelectionChanged"
                                         MouseDoubleClick="PanelCitations_MouseDoubleClick"
                                         PreviewKeyDown="PanelCitations_PreviewKeyDown"
                                         AutomationProperties.AutomationId="PanelCitationsList"
                                         AutomationProperties.Name="{x:Static panels:CitationPhrase.CitationsHeading}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <local:AutomationPresentationTextBlock x:Name="CitationBadge"
                                                                                       Text="{Binding UnresolvedBadge}"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource Slate.WarningBrush}" />
                                                <local:AutomationPresentationTextBlock Text="{Binding DisplayText}"
                                                                                       TextWrapping="Wrap" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUnresolved}" Value="False">
                                                    <Setter TargetName="CitationBadge" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- ==========================================
                                 W4-5 (#737): the bibliography leaf. BOTH
                                 segments ride AccessibleDataGrid (contract
                                 8) — including unresolved, which mac
                                 renders as a grouped list (D-6). The grids
                                 are bound in code-behind, as the
                                 bulk-rename preview is; export is null on
                                 both (D-7 / G29).
                                 ========================================== -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="bibliography">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{x:Static panels:CitationPhrase.BibliographyHeading}" />
                                <!-- The group name lives on a
                                     landmark border, not on the
                                     StackPanel: a Panel gets no
                                     automation peer, so the name was
                                     dropped and the two radio buttons
                                     were announced with nothing tying
                                     them to the bibliography. -->
                                <local:AutomationLandmarkBorder DockPanel.Dock="Top"
                                        BorderThickness="0"
                                        Margin="0,0,0,6"
                                        AutomationProperties.AutomationId="BibliographySegmentGroup"
                                        AutomationProperties.Name="{x:Static panels:CitationPhrase.BibliographySegmentName}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BibliographyEntriesSegment"
                                                 GroupName="BibliographySegment"
                                                 Margin="0,0,12,0"
                                                 Content="{x:Static panels:CitationPhrase.SegmentEntries}"
                                                 IsChecked="{Binding Bibliography.ShowEntries, Mode=OneWay}"
                                                 Checked="BibliographyEntriesSegment_Checked"
                                                 AutomationProperties.AutomationId="BibliographySegmentEntries" />
                                    <RadioButton x:Name="BibliographyUnresolvedSegment"
                                                 GroupName="BibliographySegment"
                                                 Content="{x:Static panels:CitationPhrase.SegmentUnresolved}"
                                                 IsChecked="{Binding Bibliography.ShowUnresolved, Mode=OneWay}"
                                                 Checked="BibliographyUnresolvedSegment_Checked"
                                                 AutomationProperties.AutomationId="BibliographySegmentUnresolved" />
                                </StackPanel>
                                </local:AutomationLandmarkBorder>
                                <TextBox x:Name="BibliographySearchBox"
                                         DockPanel.Dock="Top"
                                         Margin="0,0,0,6"
                                         Text="{Binding Bibliography.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding Bibliography.ShowEntries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.AutomationId="BibliographySearch"
                                         AutomationProperties.Name="{x:Static panels:CitationPhrase.BibliographySearchName}"
                                         AutomationProperties.HelpText="{x:Static panels:CitationPhrase.BibliographySearchHelp}" />
                                <!-- Every line below is SEGMENT-SCOPED in
                                     the view model; binding the raw
                                     loading/empty flags let each one
                                     render over the other segment's
                                     grid. -->
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.BibliographyLoading}"
                                           Visibility="{Binding Bibliography.ShowEntriesLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.UnresolvedLoading}"
                                           Visibility="{Binding Bibliography.ShowUnresolvedLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!-- The read-failure surface. Without
                                     these two the grid simply summarised
                                     "0 entries" and the reason was never
                                     spoken at all (contract 5). -->
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Bibliography.EntriesErrorSpoken}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowEntriesError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Focusable="True"
                                           AutomationProperties.AutomationId="BibliographyEntriesError" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Bibliography.UnresolvedErrorSpoken}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowUnresolvedError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Focusable="True"
                                           AutomationProperties.AutomationId="BibliographyUnresolvedError" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.BibliographyNoSources}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowNoSourcesState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           AutomationProperties.AutomationId="BibliographyNoSources" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Bibliography.NoFilterHitsText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowNoFilterHitsState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.UnresolvedEmpty}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowUnresolvedEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!-- Notices verbatim, per segment (contract 5). -->
                                <ItemsControl DockPanel.Dock="Bottom"
                                              Focusable="False"
                                              ItemsSource="{Binding Bibliography.LoadNotices}"
                                              AutomationProperties.AutomationId="BibliographyNotices">
                                    <!-- With no notices this renders at
                                         zero size but stays on-screen in
                                         the UIA tree, which axe flags as
                                         a null bounding rectangle. An
                                         empty notice region should leave
                                         the tree, as the inactive leaf
                                         bodies above do. -->
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bibliography.LoadNotices.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource PanelEmptyMessage}"
                                                       Focusable="True"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Both grids share the fill cell; exactly
                                     one is visible, so the other leaves the
                                     UIA tree entirely rather than sitting
                                     behind it. -->
                                <Grid>
                                    <grids:AccessibleDataGrid x:Name="BibliographyEntriesGrid"
                                                              GridAutomationId="BibliographyEntries"
                                                              Visibility="{Binding Bibliography.ShowEntries, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <grids:AccessibleDataGrid x:Name="BibliographyUnresolvedGrid"
                                                              GridAutomationId="BibliographyUnresolved"
                                                              Visibility="{Binding Bibliography.ShowUnresolved, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DockPanel>
                            <!-- W4-6 (#738): the Queries leaf — the mac
                                 BaseQueriesPanel twin. Saved queries,
                                 base files, dashboards; buttons act on
                                 the selection (AT-reachable, one route
                                 per action shared with the commands). -->
                            <DockPanel Margin="12"
                                       AutomationProperties.AutomationId="QueriesLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="queries">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <TextBlock Text="Queries"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <Button Margin="12,0,0,0"
                                            Content="New dashboard"
                                            AutomationProperties.AutomationId="QueriesNewDashboard"
                                            Click="QueriesNewDashboard_Click" />
                                    <Button Margin="8,0,0,0"
                                            Content="Refresh queries"
                                            AutomationProperties.AutomationId="QueriesRefresh"
                                            Click="QueriesRefresh_Click" />
                                </StackPanel>
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Margin="0,8,0,2" Text="SAVED QUERIES" FontSize="11"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                        <TextBlock Text="No saved queries"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SavedQueries.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox x:Name="QueriesSavedList"
                                                 MaxHeight="200"
                                                 ItemsSource="{Binding SavedQueries}"
                                                 DisplayMemberPath="Name"
                                                 MouseDoubleClick="QueriesSavedList_DoubleClick"
                                                 AutomationProperties.AutomationId="QueriesSavedList"
                                                 AutomationProperties.Name="Saved queries">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SavedQueries.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                        </ListBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <StackPanel.Resources>
                                                <!-- Selection-scoped actions disable without a
                                                     selection instead of clicking into silence
                                                     (red team round 1). -->
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=QueriesSavedList}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Resources>
                                            <Button Content="Run" AutomationProperties.Name="Run saved query" AutomationProperties.AutomationId="QueriesRun" Click="QueriesRun_Click" />
                                            <Button Content="Pin/Unpin" Margin="4,0,0,0" AutomationProperties.Name="Pin or unpin saved query" AutomationProperties.AutomationId="QueriesPin" Click="QueriesPin_Click" />
                                            <Button Content="Edit in Builder" Margin="4,0,0,0" AutomationProperties.Name="Edit saved query in builder" AutomationProperties.AutomationId="QueriesEditInBuilder" Click="QueriesEditInBuilder_Click" />
                                            <Button Content="Rename…" Margin="4,0,0,0" AutomationProperties.Name="Rename saved query" AutomationProperties.AutomationId="QueriesRename" Click="QueriesRename_Click" />
                                            <Button Content="Export as .base…" Margin="4,0,0,0" AutomationProperties.Name="Export saved query as base file" AutomationProperties.AutomationId="QueriesExport" Click="QueriesExport_Click" />
                                            <Button Content="Dock" Margin="4,0,0,0" AutomationProperties.Name="Dock saved query" AutomationProperties.AutomationId="QueriesDockQuery" Click="QueriesDockQuery_Click" />
                                            <Button Content="Delete…" Margin="4,0,0,0" AutomationProperties.Name="Delete saved query" AutomationProperties.AutomationId="QueriesDelete" Click="QueriesDelete_Click" />
                                        </StackPanel>
                                        <DockPanel x:Name="QueriesRenameRow" Visibility="Collapsed" Margin="0,4,0,0">
                                            <TextBlock Text="New name:" VerticalAlignment="Center" />
                                            <TextBox x:Name="QueriesRenameBox"
                                                     Margin="6,0,0,0"
                                                     MinWidth="180"
                                                     KeyDown="QueriesRenameBox_KeyDown"
                                                     AutomationProperties.AutomationId="QueriesRenameBox"
                                                     AutomationProperties.Name="New saved query name" />
                                        </DockPanel>
                                        <TextBlock Margin="0,12,0,2" Text="BASE FILES" FontSize="11"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                        <TextBlock Text="No base files"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BaseFiles.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox x:Name="QueriesBaseFilesList"
                                                 MaxHeight="160"
                                                 ItemsSource="{Binding BaseFiles}"
                                                 DisplayMemberPath="Path"
                                                 MouseDoubleClick="QueriesBaseFilesList_DoubleClick"
                                                 AutomationProperties.AutomationId="QueriesBaseFilesList"
                                                 AutomationProperties.Name="Base files">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BaseFiles.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                        </ListBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <StackPanel.Resources>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=QueriesBaseFilesList}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Resources>
                                            <Button Content="Open" AutomationProperties.Name="Open base file" AutomationProperties.AutomationId="QueriesOpenBaseFile" Click="QueriesOpenBaseFile_Click" />
                                            <Button Content="Dock" Margin="4,0,0,0" AutomationProperties.Name="Dock base file" AutomationProperties.AutomationId="QueriesDockBaseFile" Click="QueriesDockBaseFile_Click" />
                                        </StackPanel>
                                        <TextBlock Margin="0,12,0,2" Text="DASHBOARDS" FontSize="11"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                        <TextBlock Text="No dashboards"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboards.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox x:Name="QueriesDashboardsList"
                                                 MaxHeight="160"
                                                 ItemsSource="{Binding Dashboards}"
                                                 DisplayMemberPath="Name"
                                                 MouseDoubleClick="QueriesDashboardsList_DoubleClick"
                                                 AutomationProperties.AutomationId="QueriesDashboardsList"
                                                 AutomationProperties.Name="Dashboards">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboards.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                        </ListBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <StackPanel.Resources>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=QueriesDashboardsList}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Resources>
                                            <Button Content="Open" AutomationProperties.Name="Open dashboard" AutomationProperties.AutomationId="QueriesOpenDashboard" Click="QueriesOpenDashboard_Click" />
                                            <Button Content="Edit…" Margin="4,0,0,0" AutomationProperties.Name="Edit dashboard" AutomationProperties.AutomationId="QueriesEditDashboard" Click="QueriesEditDashboard_Click" />
                                            <Button Content="Dock" Margin="4,0,0,0" AutomationProperties.Name="Dock dashboard" AutomationProperties.AutomationId="QueriesDockDashboard" Click="QueriesDockDashboard_Click" />
                                            <Button Content="Delete…" Margin="4,0,0,0" AutomationProperties.Name="Delete dashboard" AutomationProperties.AutomationId="QueriesDeleteDashboard" Click="QueriesDeleteDashboard_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- W4-6 (#738): the Base dock leaf — one
                                 docked target following the active note,
                                 read-only. -->
                            <DockPanel Margin="12"
                                       AutomationProperties.AutomationId="BasesDockLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="basesDock">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Base dock"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock x:Name="BasesDockEmptyState"
                                           DockPanel.Dock="Top"
                                           Text="Dock a base, saved query, or dashboard to follow the active note."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           AutomationProperties.AutomationId="BasesDockEmptyState">
                                    <TextBlock.Style>
                                        <!-- Visible only while NOTHING is docked
                                             (red team round 1: it stayed up over
                                             docked content). -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding BasesDockDocument}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding BasesDockDashboard}" Value="{x:Null}" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- A docked DASHBOARD renders its own surface
                                     (red team round 1 blocker: BasesDockDashboard
                                     was bound by no view — docking a dashboard
                                     announced success and showed nothing). -->
                                <bases:DashboardSurfaceView x:Name="BasesDockDashboardSurface"
                                                            AutomationIdRoot="BasesDockDash"
                                                            Model="{Binding BasesDockDashboard}">
                                    <bases:DashboardSurfaceView.Style>
                                        <Style TargetType="bases:DashboardSurfaceView">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BasesDockDashboard}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </bases:DashboardSurfaceView.Style>
                                </bases:DashboardSurfaceView>
                                <bases:BaseSurfaceView x:Name="BasesDockSurface"
                                                       Model="{Binding BasesDockDocument}"
                                                       IsReadOnlySurface="True">
                                    <bases:BaseSurfaceView.Style>
                                        <!-- Hidden with no model: an empty surface
                                             skeleton exposes dead-but-enabled
                                             controls to the accessibility tree. -->
                                        <Style TargetType="bases:BaseSurfaceView">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BasesDockDocument}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </bases:BaseSurfaceView.Style>
                                </bases:BaseSurfaceView>
                            </DockPanel>

                            <!-- W4-7 (#739): the history leaf — two
                                 segments, day-grouped versions, the
                                 structured diff walkthrough, restore
                                 flows (contracts H2-H10). -->
                            <DockPanel Margin="12"
                                       AutomationProperties.AutomationId="HistoryLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="history">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="History"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <panels:HistorySurfaceView Model="{Binding History}" />
                            </DockPanel>

                            <!-- W4-8 (#740): the sync-diagnostics leaf —
                                 five states, per-provider risk rows with
                                 evidence disclosures, and the LiveSync
                                 config section (contracts SD2/SD3). -->
                            <DockPanel Margin="12"
                                       AutomationProperties.AutomationId="SyncDiagnosticsLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="syncDiagnostics">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Sync"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <panels:SyncDiagnosticsSurfaceView Model="{Binding SyncDiagnostics}" />
                            </DockPanel>

                            <StackPanel Grid.Column="0" Margin="12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="citations">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="bibliography">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="queries">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="basesDock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="backlinks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outgoingLinks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outline">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="embeds">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasksReview">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="history">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="syncDiagnostics">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding ActiveLeaf.Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="This panel is docked and ready for its feature surface."
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ListBox x:Name="RightPaneLeavesList"
                                     Grid.Column="1"
                                     ItemsSource="{Binding LeafOptions}"
                                     SelectedItem="{Binding ActiveLeaf, Mode=TwoWay}"
                                     DisplayMemberPath="Title"
                                     VirtualizingStackPanel.IsVirtualizing="False"
                                     AutomationProperties.AutomationId="RightPaneLeaves"
                                     AutomationProperties.Name="Right pane panels">
                                <!-- Explicit names: content-derived ListItem names
                                     are not composed on all sessions (the Quick
                                     Open row precedent), and a rail entry an AT
                                     cannot name is unusable. -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </local:AutomationLandmarkBorder>
                </Grid>
            </local:AutomationLandmarkGrid>
            <!-- A full-window hit-test layer makes Quick Open modal for pointer
                 input. The underlying shell is disabled above, so UIA clients
                 cannot invoke commands behind the visible overlay either. -->
            <Border Background="Transparent"
                    Visibility="{Binding QuickSwitcher.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <local:AutomationLandmarkBorder x:Name="QuickSwitcherOverlay"
                    Width="600"
                    MaxHeight="430"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,72,0,0"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.QuickSwitcher.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                    DataContext="{Binding QuickSwitcher}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="QuickSwitcher"
                    AutomationProperties.Name="Quick Open"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickSwitcherSearchTextBox"
                                 Grid.Column="0"
                                 Padding="10,8"
                                 FontSize="18"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 PreviewKeyDown="QuickSwitcherSearch_PreviewKeyDown"
                                 AutomationProperties.AutomationId="QuickSwitcherSearch"
                                 AutomationProperties.Name="Search files"
                                 AutomationProperties.HelpText="Up and Down move selection. Enter opens. Control Enter opens a new tab. Control Alt Enter opens a split. Escape closes Quick Open." />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Close"
                                Command="{Binding DismissCommand}"
                                Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="QuickSwitcherClose"
                                AutomationProperties.Name="Close Quick Open" />
                    </Grid>
                    <!-- ResultSummary describes the collection, so expose it once on
                         the list rather than repeating it on every result row. -->
                    <local:AutomationVisibilityListBox x:Name="QuickSwitcherResultsList"
                             Grid.Row="1"
                             Margin="0,8"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                             MouseDoubleClick="QuickSwitcherResults_MouseDoubleClick"
                             AutomationProperties.AutomationId="QuickSwitcherResults"
                             AutomationProperties.Name="Quick Open results"
                             AutomationProperties.ItemStatus="{Binding ResultSummary}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Path}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:AutomationPresentationTextBlock Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold" />
                                    <local:AutomationPresentationTextBlock Grid.Column="1"
                                                                           Text="{Binding Path}"
                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </local:AutomationVisibilityListBox>
                    <DockPanel Grid.Row="2">
                        <local:AutomationPresentationTextBlock Text="{Binding ResultSummary}"
                                                               Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        <local:AutomationPresentationTextBlock DockPanel.Dock="Right"
                                                               Text="Enter open · Ctrl+Enter tab · Ctrl+Alt+Enter split · Esc close"
                                                               Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                    </DockPanel>
                </Grid>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W5-2 (#742): the vault-search overlay. Declared BETWEEN
                 Quick Open and the palette (contract S11). Since SD-5
                 the three never coexist outside a palette invoke's
                 transient window, so the position is the stacking
                 invariant's backstop: if exclusivity is ever violated,
                 the palette still paints above search rather than
                 beneath it.

                 Visibility resolves through the WINDOW because this
                 element overrides its own DataContext: the short path
                 would resolve against SearchOverlayViewModel, fail, and
                 stick at FallbackValue=Collapsed forever — shipped
                 broken twice before, in W4-5 and W4-6.
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Search.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <local:AutomationLandmarkBorder x:Name="SearchOverlay"
                    Width="640"
                    MaxHeight="470"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,72,0,0"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Search.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Search}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="SearchOverlay"
                    AutomationProperties.Name="Search Vault"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- "Search vault" with NO trailing period — mac's
                             actual label (its own doc comment claiming the
                             period is recorded stale, contracts doc item 3). -->
                        <TextBox x:Name="SearchOverlaySearchTextBox"
                                 Grid.Column="0"
                                 Padding="10,8"
                                 FontSize="18"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchOverlaySearch_PreviewKeyDown"
                                 AutomationProperties.AutomationId="SearchOverlaySearch"
                                 AutomationProperties.Name="Search vault"
                                 Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.HelpText="Type to search across every note in this vault. Return activates the top result. Up and Down move through results. Escape closes." />
                        <!-- Pointer dismissal (contract S15, red-team
                             round 1): mac's field row ends in a "Close
                             search" button (SearchOverlay.swift:169-198,
                             label and hint verbatim); the Windows shape
                             is Quick Open's "Close Quick Open". Without
                             it, Esc was the only way out of a surface a
                             pointer can open from the menu. -->
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Close"
                                Click="SearchOverlayClose_Click"
                                Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SearchOverlayClose"
                                AutomationProperties.Name="Close search"
                                AutomationProperties.HelpText="Closes the search overlay and returns to the previous view." />
                    </Grid>
                    <!-- The read-only tag chip (divergence SD-3: no scope
                         selector exists on either platform). One named
                         group stop; the visual "Tag: {name}" text is
                         presentation-only; the clear button is its own
                         focusable stop, exactly mac's chip anatomy. -->
                    <local:AutomationNamedRowBorder Grid.Row="1"
                            Margin="0,8,0,0"
                            Padding="8,4"
                            CornerRadius="4"
                            Background="{DynamicResource Slate.RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource Slate.BorderBrush}"
                            BorderThickness="1"
                            Visibility="{Binding TagScopeName, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                            AutomationProperties.AutomationId="SearchOverlayTagChip"
                            AutomationProperties.Name="{Binding TagScopeName, StringFormat='Filtered to tag {0}'}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Padding="6,0"
                                    MinWidth="28"
                                    MinHeight="24"
                                    Content="✕"
                                    Click="SearchOverlayClearTagScope_Click"
                                    AutomationProperties.AutomationId="SearchOverlayClearTagScope"
                                    AutomationProperties.Name="Clear tag filter"
                                    AutomationProperties.HelpText="Removes the tag filter and searches the whole vault." />
                            <local:AutomationPresentationTextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding TagScopeName, StringFormat='Tag: {0}'}" />
                        </DockPanel>
                    </local:AutomationNamedRowBorder>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <!-- ONE accessible stop per result row (contract
                             S4): the container carries the composed name;
                             the emphasis runs and the basename line are
                             presentation-only. Summary rides ItemStatus —
                             the Quick Open precedent for the collection
                             description. -->
                        <local:AutomationVisibilityListBox x:Name="SearchOverlayResults"
                                 ItemsSource="{Binding Rows}"
                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                 Visibility="{Binding ShowsResultRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 SelectionChanged="SearchOverlayResults_SelectionChanged"
                                 MouseDoubleClick="SearchOverlayResults_MouseDoubleClick"
                                 AutomationProperties.AutomationId="SearchOverlayResults"
                                 AutomationProperties.Name="Search results"
                                 AutomationProperties.ItemStatus="{Binding Summary}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <local:AutomationPresentationTextBlock
                                                Text="{Binding Basename}"
                                                FontWeight="SemiBold" />
                                        <!-- Match emphasis. A WrapPanel, not the
                                             palette's horizontal StackPanel: the
                                             snippet is never truncated (accepted
                                             risk SR-2, mac's WCAG 1.4.4 call), so
                                             a long one wraps into a tall row.
                                             The host is peer-suppressed: a plain
                                             ItemsControl publishes an unnamed
                                             List INSIDE the row, breaking S4's
                                             one-stop rule (close-out journey
                                             finding). -->
                                        <local:AutomationPresentationItemsControl
                                                      ItemsSource="{Binding SnippetSegments}"
                                                      Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:AutomationPresentationTextBlock
                                                            Text="{Binding Text}"
                                                            FontSize="12"
                                                            Foreground="{DynamicResource Slate.SecondaryTextBrush}">
                                                        <local:AutomationPresentationTextBlock.Style>
                                                            <Style TargetType="local:AutomationPresentationTextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </local:AutomationPresentationTextBlock.Style>
                                                    </local:AutomationPresentationTextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </local:AutomationPresentationItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </local:AutomationVisibilityListBox>
                        <!-- The mutually exclusive state panels, labels
                             mac-verbatim (contract S14; the strings are
                             pinned by SearchOverlayViewModel's constants
                             and IdleStateLabelsAreMacVerbatim). Each is
                             collapsed when unused — an empty panel left
                             on-screen at zero size fails the axe
                             BoundingRectangleNotNull check — and each
                             publishes through a peer-bearing element: a
                             bare StackPanel publishes nothing. -->
                        <local:AutomationLandmarkGrid
                                Visibility="{Binding ShowsIdleHint, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SearchOverlayIdleHint"
                                AutomationProperties.Name="Type to search.">
                            <local:AutomationPresentationTextBlock Margin="4"
                                    Text="Type to search."
                                    Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </local:AutomationLandmarkGrid>
                        <Grid Visibility="{Binding ShowsRecents, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="4,0">
                                <Button DockPanel.Dock="Right"
                                        Padding="8,2"
                                        Content="Clear"
                                        Click="SearchOverlayClearRecents_Click"
                                        AutomationProperties.AutomationId="SearchOverlayClearRecents"
                                        AutomationProperties.Name="Clear recent searches"
                                        AutomationProperties.HelpText="Forgets every remembered search in this vault." />
                                <TextBlock Text="Recent Searches"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           AutomationProperties.Name="Recent Searches"
                                           AutomationProperties.HeadingLevel="Level2" />
                            </DockPanel>
                            <ScrollViewer Focusable="False" Grid.Row="1"
                                          Margin="0,4,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Recents}"
                                              AutomationProperties.Name="Recent searches">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="4,1"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{Binding}"
                                                    Click="SearchOverlayRecentRow_Click"
                                                    GotKeyboardFocus="SearchOverlayRecentRow_GotKeyboardFocus"
                                                    AutomationProperties.Name="{Binding StringFormat='Recent search: {0}'}"
                                                    AutomationProperties.HelpText="Runs this search again." />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <!-- Visible "Searching…", spoken "Searching." —
                             mac's deliberate split. The transition into
                             this state is SILENT (contract S8): the name
                             is what an AT reads on focus, not a live
                             announcement. -->
                        <local:AutomationLandmarkGrid
                                Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SearchOverlaySearching"
                                AutomationProperties.Name="Searching.">
                            <local:AutomationPresentationTextBlock Margin="4"
                                    Text="Searching…"
                                    Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </local:AutomationLandmarkGrid>
                        <local:AutomationLandmarkGrid
                                Visibility="{Binding ShowsNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SearchOverlayNoResults"
                                AutomationProperties.Name="No results.">
                            <local:AutomationPresentationTextBlock Margin="4"
                                    Text="No results."
                                    Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </local:AutomationLandmarkGrid>
                        <StackPanel Margin="4"
                                    Visibility="{Binding ShowsError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Search error"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="Search error"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <!-- The VM's Summary is the event's own
                                 rendering ("Search error: {message}",
                                 a11y.rs:872) — displayed and spoken from
                                 one template, never two copies (S6). -->
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Summary}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <!-- Visible twin of the summary announcement, hidden
                         from AT like mac's (the announcement is the audio
                         source of truth; ItemStatus carries the UIA copy). -->
                    <local:AutomationPresentationTextBlock Grid.Row="3"
                            Margin="4,8,4,0"
                            Text="{Binding Summary}"
                            Visibility="{Binding ShowsResultRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                </Grid>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W5-1 (#741): the command palette. Built on the Quick Open
                 shape above — an in-window overlay, never a WPF Popup,
                 whose UIA subtree would be a sibling HWND (contract P5).

                 Two bindings here are load-bearing and easy to get wrong.
                 Visibility resolves through the WINDOW, because this
                 element overrides its own DataContext: binding the short
                 path would resolve against CommandPaletteViewModel, fail,
                 and stick at FallbackValue=Collapsed forever — shipped
                 twice before, in W4-5 and W4-6. And the results list gets
                 its ItemsSource from code-behind, not from a binding,
                 because the rows are grouped by the section core PLACED
                 them in; see RefreshPaletteGrouping.
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Palette.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <local:AutomationLandmarkBorder x:Name="CommandPaletteOverlay"
                    Width="640"
                    MaxHeight="470"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,72,0,0"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Palette.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Palette}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="CommandPalette"
                    AutomationProperties.Name="Command Palette"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="CommandPaletteSearchTextBox"
                             Grid.Row="0"
                             Padding="10,8"
                             FontSize="18"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CommandPaletteSearch_PreviewKeyDown"
                             AutomationProperties.AutomationId="CommandPaletteSearch"
                             AutomationProperties.Name="Search commands"
                             Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.HelpText="Up and Down move selection. Home, End, Page Up and Page Down jump. Enter runs the selected command. Escape closes the palette." />
                    <!-- The two Visibility bindings on this list and on the
                         search box above are PRECAUTIONARY, matching the Quick
                         Open precedent. A round-2 mutation removed both and the
                         journey's closed-palette assertion still passed, so the
                         children do leave the UIA tree with their collapsed
                         ancestor on this framework version. A later probe
                         walking the RAW tree showed why: the elements do
                         remain in the raw tree, and it is WPF dropping
                         invisible elements from the CONTROL view that hides
                         them, not these bindings. Kept for consistency with
                         Quick Open; they are redundant, not load-bearing. -->
                    <local:AutomationVisibilityListBox x:Name="CommandPaletteResultsList"
                             Grid.Row="1"
                             Margin="0,8"
                             Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                             SelectionChanged="CommandPaletteResults_SelectionChanged"
                             MouseDoubleClick="CommandPaletteResults_MouseDoubleClick"
                             AutomationProperties.AutomationId="CommandPaletteResults"
                             AutomationProperties.Name="Command results">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- ONE name per row (contract P6): label plus the
                                     spoken chord. The visible chord and the bolded
                                     runs below are presentation-only, so they never
                                     become separate stops. -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibilityHint}" />
                                <Style.Triggers>
                                    <!-- Unavailable rows stay visible, selectable and
                                         in the arrow cycle — only activation is
                                         refused (contract P8). IsEnabled="False" here
                                         would drop them from keyboard navigation AND
                                         from the UIA tree, which is the opposite of
                                         what the contract asks for. -->
                                    <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                        <Setter Property="Opacity" Value="0.65" />
                                        <Setter Property="AutomationProperties.HelpText" Value="{Binding DisabledReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="4,8,4,2"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                   AutomationProperties.Name="{Binding Name}"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <!-- Match bolding. Segments always concatenate
                                             back to the whole label, so a hint-only
                                             match renders as one unbolded segment
                                             rather than bold-everything. -->
                                        <ItemsControl ItemsSource="{Binding LabelSegments}"
                                                      Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:AutomationPresentationTextBlock Text="{Binding Text}">
                                                        <local:AutomationPresentationTextBlock.Style>
                                                            <Style TargetType="local:AutomationPresentationTextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </local:AutomationPresentationTextBlock.Style>
                                                    </local:AutomationPresentationTextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <local:AutomationPresentationTextBlock
                                                Text="{Binding DisabledReason}"
                                                Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                TextWrapping="Wrap"
                                                MaxHeight="34" />
                                    </StackPanel>
                                    <local:AutomationPresentationTextBlock Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Text="{Binding HotkeyHint}"
                                            Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </local:AutomationVisibilityListBox>
                    <!-- Empty states. Collapsed when unused: an empty
                         ItemsControl left on-screen at zero size fails the
                         axe BoundingRectangleNotNull check (the W4-5/W4-6
                         lesson). -->
                    <!-- AutomationLandmarkGrid, not StackPanel: a bare Panel
                         creates NO automation peer, so the composed name
                         below would be silently dropped and the block would
                         publish nothing at all. Both children are
                         presentation-only, so this host is the single stop. -->
                    <local:AutomationLandmarkGrid Grid.Row="2"
                                Margin="4,4,4,0"
                                Visibility="{Binding ShowsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding EmptyStateAccessibleName}">
                        <StackPanel>
                        <local:AutomationPresentationTextBlock Text="{Binding EmptyStateTitle}"
                                                               FontWeight="SemiBold" />
                        <local:AutomationPresentationTextBlock Text="{Binding EmptyStateDetail}"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                               TextWrapping="Wrap" />
                        </StackPanel>
                    </local:AutomationLandmarkGrid>
                    <local:AutomationPresentationTextBlock Grid.Row="3"
                            Margin="4,8,4,0"
                            Text="Enter run · Esc close"
                            Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                </Grid>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W4-4 (#736): the add-property sheet. Focus lands on the
                 Key field at open; Enter = Add, Esc = Cancel (code-behind
                 PreviewKeyDown — no window-global default button).
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.AddPropertySheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="AddPropertyOverlay"
                    Width="460"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.AddPropertySheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.AddPropertySheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="AddPropertyOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="AddPropertySheet"
                    AutomationProperties.Name="Add property"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <StackPanel>
                    <TextBlock Text="Add property"
                               FontSize="16"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <local:AutomationPresentationTextBlock Margin="0,10,0,2" Text="Property key" />
                    <TextBox x:Name="AddPropertyKeyTextBox"
                             Padding="6,4"
                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AddPropertyKey"
                             AutomationProperties.Name="Property key" />
                    <local:AutomationPresentationTextBlock Margin="0,8,0,2" Text="Property type" />
                    <ComboBox ItemsSource="{x:Static panels:AddPropertyViewModel.Kinds}"
                              SelectedItem="{Binding Kind}"
                              AutomationProperties.AutomationId="AddPropertyType"
                              AutomationProperties.Name="Property type" />
                    <!-- Round 3: shape-derived kinds need a shape-valid
                         seed — core classifies stored values by shape,
                         so the chosen type must survive the re-read. -->
                    <local:AutomationPresentationTextBlock Margin="0,8,0,2" Text="Initial value" />
                    <TextBox Padding="6,4"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AddPropertyValue"
                             AutomationProperties.Name="Initial value" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding ValidationError}"
                               Foreground="{DynamicResource Slate.WarningBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}" />
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Padding="10,4"
                                Content="Add"
                                Click="AddPropertyAdd_Click"
                                AutomationProperties.AutomationId="AddPropertyConfirm"
                                AutomationProperties.HelpText="Add this property to the note." />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Cancel"
                                Command="{Binding DataContext.Workspace.CloseAddPropertySheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="AddPropertyCancel" />
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W4-4 (#736): the bulk-rename sheet. Default action is
                 PREVIEW, never Apply; Apply arms only after a preview on
                 the exact key pair (any key edit disarms it); Esc cancels
                 in-flight core work through the CancelToken and closes.
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.BulkRenameSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="BulkRenameOverlay"
                    Width="760"
                    MaxHeight="560"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.BulkRenameSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.BulkRenameSheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="BulkRenameOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="BulkRenameSheet"
                    AutomationProperties.Name="Rename property across the vault"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Rename property across the vault"
                               FontSize="16"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <local:AutomationPresentationTextBlock Margin="0,0,0,2" Text="Old property key" />
                            <TextBox x:Name="BulkRenameOldKeyTextBox"
                                     Padding="6,4"
                                     Text="{Binding OldKey, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="BulkRenameOldKey"
                                     AutomationProperties.Name="Old property key" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <local:AutomationPresentationTextBlock Margin="0,0,0,2" Text="New property key" />
                            <TextBox Padding="6,4"
                                     Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="BulkRenameNewKey"
                                     AutomationProperties.Name="New property key" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                   Visibility="{Binding ProgressText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ErrorText}"
                                   Foreground="{DynamicResource Slate.WarningBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3"
                               Margin="0,12"
                               Text="{Binding EmptyStateText}"
                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.Name="{Binding EmptyStateText}" />
                    <grids:AccessibleDataGrid x:Name="BulkRenamePreviewGrid"
                                              Grid.Row="3"
                                              Margin="0,8"
                                              MinHeight="120"
                                              Visibility="{Binding ShowEmptyState, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding FooterText}"
                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                               AutomationProperties.AutomationId="BulkRenameFooter" />
                    <StackPanel Grid.Row="5"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Padding="10,4"
                                Content="Preview"
                                Click="BulkRenamePreview_Click"
                                IsEnabled="{Binding CanPreview}"
                                AutomationProperties.AutomationId="BulkRenamePreviewButton" />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Apply"
                                Click="BulkRenameApply_Click"
                                IsEnabled="{Binding CanApply}"
                                AutomationProperties.AutomationId="BulkRenameApplyButton"
                                AutomationProperties.HelpText="Apply the previewed property rename across the vault." />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Close"
                                Command="{Binding DataContext.Workspace.CloseBulkRenameSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="BulkRenameClose" />
                    </StackPanel>
                </Grid>
            </local:AutomationLandmarkBorder>

            <!-- ==========================================================
                 W4-5 (#737): the citation details overlay. D-1 — mac
                 anchors a popover to the row; a WPF Popup lives in a
                 separate HWND whose UIA subtree is a sibling window, so
                 this is the in-window sheet instead. The focus-return
                 contract (WCAG 2.4.3 / 2.1.2) is preserved verbatim:
                 Escape returns focus to the row that opened it
                 (contract 11).
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.CitationDetails, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="CitationDetailsOverlay"
                    Width="460"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.CitationDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CitationDetails}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="CitationDetailsOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="CitationDetailsSheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <StackPanel>
                    <!-- An unresolved key is a real state, not an error
                         (contract 7): the sheet says so plainly rather
                         than showing empty fields. -->
                    <StackPanel Visibility="{Binding IsUnresolved, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding UnresolvedHeading}"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding UnresolvedBody}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Absent values never produce a row (contract 10):
                         Fields carries only what is present. -->
                    <!-- A ListBox, not an ItemsControl.
                         An ItemsControl's items were bare StackPanels,
                         and WPF creates NO automation peer for a Panel,
                         so AutomationProperties.Name on it was dropped
                         outright; both children are
                         AutomationPresentationTextBlock, whose peer
                         returns false from IsControlElement AND
                         IsContentElement. The net effect was that every
                         citation field — Title, Authors, Year, Journal,
                         Publisher, DOI, URL — was absent from the UIA
                         tree, in the one surface whose entire job is
                         speaking them. ListBoxItem DOES have a peer, so
                         each field becomes its own navigable AT element,
                         which is what mac's per-field rendering means
                         (CitationPopover.swift:5-10). -->
                    <ListBox ItemsSource="{Binding Fields}"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="220"
                             Visibility="{Binding IsUnresolved, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                             AutomationProperties.AutomationId="CitationDetailsFields"
                             AutomationProperties.Name="{x:Static panels:CitationPhrase.DetailsFieldsLabel}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <local:AutomationPresentationTextBlock Text="{Binding Label}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                    <local:AutomationPresentationTextBlock x:Name="FieldValueText"
                                                                           Text="{Binding Value}"
                                                                           TextWrapping="Wrap" />
                                    <!-- DOI and URL carry a LinkTarget
                                         and are actually followable;
                                         every other field is plain
                                         text. Rendering all of them
                                         identically left the DOI
                                         readable but unreachable. -->
                                    <TextBlock x:Name="FieldValueLink" Visibility="Collapsed">
                                        <Hyperlink Command="{Binding DataContext.Workspace.OpenCitationLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding LinkTarget}">
                                            <Run Text="{Binding Value, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLink}" Value="True">
                                        <Setter TargetName="FieldValueText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="FieldValueLink" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- A real disclosure, matching mac's
                         DisclosureGroup. The abstract used to render
                         unconditionally while its accessible name said
                         "Abstract, collapsed." forever: AbstractExpanded
                         had no writer anywhere in production, so a
                         sighted user read the text and a screen-reader
                         user heard only that it was collapsed, with no
                         control to open it. The body also scrolls now —
                         a long abstract was clipped at MaxHeight with no
                         keyboard route to the rest. -->
                    <Expander Margin="0,6,0,0"
                              IsExpanded="{Binding AbstractExpanded, Mode=TwoWay}"
                              Visibility="{Binding HasAbstract, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="CitationDetailsAbstract"
                              AutomationProperties.Name="{Binding AbstractAutomationName}">
                        <Expander.Header>
                            <TextBlock Text="{x:Static panels:CitationPhrase.FieldAbstract}" />
                        </Expander.Header>
                        <ScrollViewer Focusable="True" AutomationProperties.Name="{Binding AbstractText}" MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <local:AutomationPresentationTextBlock Text="{Binding AbstractText}"
                                                                   TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Expander>
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="CitationDetailsCloseButton"
                                Padding="10,4"
                                Content="{Binding CloseText}"
                                Command="{Binding DataContext.Workspace.CloseCitationDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="CitationDetailsClose"
                                AutomationProperties.HelpText="{Binding CloseHelp}" />
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkBorder>

            <!-- ==========================================================
                 W4-5 (#737): the citation summary sheet (Ctrl+Shift+J).
                 Counts come from the leaf's already-published rows, so
                 the sheet can never disagree with the panel behind it
                 (contract 12).
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.CitationSummary, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="CitationSummaryOverlay"
                    Width="420"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.CitationSummary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CitationSummary}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="CitationSummaryOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="CitationSummarySheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Heading}"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding Body}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="CitationSummaryWalkButton"
                                Padding="10,4"
                                Content="{Binding WalkActionText}"
                                IsEnabled="{Binding CanWalkThrough}"
                                Click="CitationSummaryWalk_Click"
                                AutomationProperties.AutomationId="CitationSummaryWalk"
                                AutomationProperties.HelpText="{Binding WalkActionHelp}" />
                        <Button x:Name="CitationSummaryDismissButton"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Content="{Binding DismissText}"
                                Command="{Binding DataContext.Workspace.CloseCitationSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="CitationSummaryDismiss"
                                AutomationProperties.HelpText="{Binding DismissHelp}" />
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkBorder>

            <!-- ==========================================================
                 W4-5 (#737): files citing this entry, opened from a
                 bibliography row action.
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.FilesCiting, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="FilesCitingOverlay"
                    Width="460"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.FilesCiting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.FilesCiting}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="FilesCitingOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="FilesCitingSheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Heading}"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding EmptyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ListBox x:Name="FilesCitingList"
                             Margin="0,6,0,0"
                             MaxHeight="260"
                             ItemsSource="{Binding Paths}"
                             AutomationProperties.AutomationId="FilesCitingList"
                             AutomationProperties.Name="{Binding Heading}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="FilesCitingCloseButton"
                                Padding="10,4"
                                Content="{x:Static panels:CitationPhrase.DetailsClose}"
                                Command="{Binding DataContext.Workspace.CloseFilesCitingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="FilesCitingClose" />
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkBorder>
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.DashboardEditorSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="DashboardEditorOverlay"
                    Width="560"
                    MaxHeight="520"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.RaisedSurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.DashboardEditorSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.DashboardEditorSheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="DashboardEditorOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="DashboardEditorSheet"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.IsDialog="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <TextBlock Text="Name:" VerticalAlignment="Center" />
                        <TextBox x:Name="DashboardEditorNameBox"
                                 Margin="6,0,0,0"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="DashboardEditorName"
                                 AutomationProperties.Name="Dashboard name" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox x:Name="DashboardEditorQueryPicker"
                                  MinWidth="200"
                                  ItemsSource="{Binding DataContext.Workspace.SavedQueries, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.AutomationId="DashboardEditorQueryPicker"
                                  AutomationProperties.Name="Saved query to add" />
                        <Button Content="Add section"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="DashboardEditorAddSection"
                                Click="DashboardEditorAddSection_Click" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Save"
                                AutomationProperties.AutomationId="DashboardEditorSave"
                                Click="DashboardEditorSave_Click" />
                        <Button Content="Cancel"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="DashboardEditorCancel"
                                Click="DashboardEditorCancel_Click" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Sections}"
                             Margin="0,10,0,0"
                             MaxHeight="280"
                             HorizontalContentAlignment="Stretch"
                             AutomationProperties.AutomationId="DashboardEditorSections"
                             AutomationProperties.Name="Dashboard sections">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Up" Click="DashboardEditorMoveUp_Click"
                                                AutomationProperties.Name="{Binding SavedQueryName, StringFormat=Move {0} up}" />
                                        <Button Content="Down" Margin="4,0,0,0" Click="DashboardEditorMoveDown_Click"
                                                AutomationProperties.Name="{Binding SavedQueryName, StringFormat=Move {0} down}" />
                                        <Button Content="Remove" Margin="4,0,0,0" Click="DashboardEditorRemoveSection_Click"
                                                AutomationProperties.Name="{Binding SavedQueryName, StringFormat=Remove {0}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SavedQueryName}" FontWeight="SemiBold" />
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock Text="Heading:" VerticalAlignment="Center" />
                                            <TextBox Margin="6,0,0,0"
                                                     Text="{Binding HeadingOverride, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding SavedQueryName, StringFormat=Heading override for {0}}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock Text="View:" VerticalAlignment="Center" />
                                            <ComboBox Margin="6,0,0,0"
                                                      MinWidth="120"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding ViewOverride}"
                                                      AutomationProperties.Name="{Binding SavedQueryName, StringFormat=View override for {0}}">
                                                <ComboBoxItem Content="Default" Tag="" />
                                                <ComboBoxItem Content="Table" Tag="table" />
                                                <ComboBoxItem Content="List" Tag="list" />
                                            </ComboBox>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </local:AutomationLandmarkBorder>
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.BaseQueryBuilderSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="BaseQueryBuilderOverlay"
                    Width="640"
                    MaxHeight="560"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.RaisedSurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.BaseQueryBuilderSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.BaseQueryBuilderSheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="BaseQueryBuilderOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="BaseQueryBuilderSheet"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.IsDialog="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Save to View"
                                AutomationProperties.AutomationId="BuilderSaveToView"
                                Click="BuilderSaveToView_Click">
                            <Button.Style>
                                <!-- Only an edit-view context can save to a view
                                     (red team round 1: the button sat enabled in
                                     every context and clicked into silence). -->
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Context.ViewPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Update Saved Query"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="BuilderUpdateSavedQuery"
                                Click="BuilderUpdateSavedQuery_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Context.SavedQueryId}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Save as Saved Query"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="BuilderSaveAsSavedQuery"
                                Click="BuilderSaveAsSavedQuery_Click" />
                        <Button Content="Save as .base"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="BuilderSaveAsBase"
                                Click="BuilderSaveAsBase_Click" />
                        <Button Content="Done"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="BuilderDone"
                                Click="BuilderDone_Click" />
                    </StackPanel>
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Match:" VerticalAlignment="Center" />
                                <ComboBox x:Name="BuilderCombinatorBox"
                                          Margin="6,0,0,0"
                                          MinWidth="90"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Combinator}"
                                          AutomationProperties.AutomationId="BuilderCombinator"
                                          AutomationProperties.Name="Condition combinator">
                                    <ComboBoxItem Content="All" Tag="and" />
                                    <ComboBoxItem Content="Any" Tag="or" />
                                </ComboBox>
                                <Button Content="Add condition"
                                        Margin="12,0,0,0"
                                        AutomationProperties.AutomationId="BuilderAddCondition"
                                        Click="BuilderAddCondition_Click" />
                                <Button Content="Add group"
                                        Margin="6,0,0,0"
                                        AutomationProperties.AutomationId="BuilderAddGroup"
                                        Click="BuilderAddGroup_Click" />
                            </StackPanel>
                            <ItemsControl Focusable="False" ItemsSource="{Binding ConditionRows}"
                                          Margin="0,6,0,0"
                                          AutomationProperties.AutomationId="BuilderConditions">
                                <ItemsControl.Style>
                                    <!-- Empty collections collapse: a zero-size
                                         list is an axe BoundingRectangle
                                         violation (the queries-leaf rule). -->
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConditionRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Label}" MinWidth="70" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right"
                                                        Content="Remove"
                                                        Click="BuilderRemoveCondition_Click"
                                                        AutomationProperties.Name="{Binding Label, StringFormat=Remove {0}}" />
                                                <TextBox Margin="6,0,6,0"
                                                         Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="BuilderExpression_TextChanged"
                                                         AutomationProperties.Name="Raw filter expression">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPreserved}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ValidationMessage}"
                                                       Foreground="{DynamicResource Slate.WarningBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl Focusable="False" ItemsSource="{Binding GroupMembers}" Margin="24,0,0,0">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GroupMembers}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <TextBox Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextChanged="BuilderExpression_TextChanged"
                                                                     AutomationProperties.Name="Group member expression" />
                                                            <!-- A group member's refusal renders like a
                                                                 top-level row's (red team round 1: it was
                                                                 invisible). -->
                                                            <TextBlock Text="{Binding ValidationMessage}"
                                                                       Foreground="{DynamicResource Slate.WarningBrush}"
                                                                       TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </Trigger>
                                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SaveError}"
                                       Foreground="{DynamicResource Slate.WarningBrush}"
                                       TextWrapping="Wrap"
                                       Focusable="True"
                                       AutomationProperties.AutomationId="BuilderSaveError">
                                <TextBlock.Style>
                                    <!-- An EMPTY focusable text is a tab stop
                                         announcing nothing — collapsed until
                                         there is an error to read. -->
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,10,0,2" Text="PREVIEW" FontSize="11"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            <TextBlock x:Name="BuilderPreviewLine"
                                       Text="Preview not loaded."
                                       TextWrapping="Wrap"
                                       Focusable="True"
                                       AutomationProperties.AutomationId="BuilderPreviewLine" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="BuilderSavePathBox"
                                         MinWidth="180"
                                         AutomationProperties.AutomationId="BuilderSavePathBox"
                                         AutomationProperties.Name="New .base path" />
                                <TextBox x:Name="BuilderSaveNameBox"
                                         MinWidth="140"
                                         Margin="8,0,0,0"
                                         AutomationProperties.AutomationId="BuilderSaveNameBox"
                                         AutomationProperties.Name="Saved query name" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W5-3 (#743): the template picker sheet. Focus lands per
                 state (first row / Try Again / Cancel); Enter activates
                 the selected row, Esc cancels (code-behind
                 PreviewKeyDown). Declared after every earlier sheet —
                 ModalSurface paint order is XAML declaration order.
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.TemplatePickerSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="TemplatePickerOverlay"
                    Width="520"
                    MaxHeight="440"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.TemplatePickerSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.TemplatePickerSheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="TemplatePickerOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="TemplatePickerSheet"
                    AutomationProperties.Name="Choose a template"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Choose a template"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <!-- A plain TextBlock, deliberately: the subtitle
                             carries the DESTINATION, which an AT user can
                             learn nowhere else on this sheet — mac exposes
                             it (TemplatePicker.swift:75-80). Presentation
                             suppression here was a red-team High. -->
                        <TextBlock Margin="0,4,0,8"
                                   Text="{Binding Subtitle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="TemplatePickerSubtitle"
                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="TemplatePickerCancelButton"
                                Padding="10,4"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="TemplatePickerCancel"
                                AutomationProperties.HelpText="Closes the template picker without creating a note." />
                    </StackPanel>
                    <Grid>
                        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="24,0" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Loading templates…"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                       AutomationProperties.Name="Loading templates." />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="No templates found."
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,8"
                                       Text="{x:Static templates:TemplatePickerViewModel.EmptyStateDetail}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            <Button x:Name="TemplatePickerTryAgainButton"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Content="Try Again"
                                    Command="{Binding RetryCommand}"
                                    AutomationProperties.AutomationId="TemplatePickerTryAgain"
                                    AutomationProperties.HelpText="Reloads templates for the same destination." />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Couldn’t load templates"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,8"
                                       Text="{x:Static templates:TemplatePickerViewModel.FailedStateDetail}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            <Button x:Name="TemplatePickerFailedTryAgainButton"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Content="Try Again"
                                    Command="{Binding RetryCommand}"
                                    AutomationProperties.AutomationId="TemplatePickerFailedTryAgain"
                                    AutomationProperties.HelpText="Reloads templates for the same destination." />
                        </StackPanel>
                        <ListBox x:Name="TemplatePickerList"
                                 Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 ItemsSource="{Binding Rows}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MouseDoubleClick="TemplatePickerList_MouseDoubleClick"
                                 AutomationProperties.AutomationId="TemplatePickerList"
                                 AutomationProperties.Name="Templates">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="Activate to use this template for a new note." />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Presentation text: the ListBoxItem
                                         carries the composed accessible name;
                                         plain TextBlocks would republish both
                                         fragments as duplicate text peers
                                         (AutomationLandmark.cs documents the
                                         detached-peer hazard this prevents —
                                         every other row template does this). -->
                                    <StackPanel>
                                        <local:AutomationPresentationTextBlock
                                                Text="{Binding Name}" FontWeight="SemiBold" />
                                        <local:AutomationPresentationTextBlock
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W5-3 (#743): the prompt/name flow sheet — one sheet, two
                 steps (contracts TD-5). Enter is Next on the prompt step
                 and Create on the name step; Esc cancels the whole flow
                 and nothing is written (T7).
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.TemplateFlowSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="TemplateFlowOverlay"
                    Width="520"
                    MaxHeight="480"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.TemplateFlowSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.TemplateFlowSheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="TemplateFlowOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="TemplateFlowSheet"
                    AutomationProperties.Name="Create from template"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <Grid>
                    <DockPanel Visibility="{Binding IsPromptStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Fill in template details"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <!-- Plain TextBlock: carries the template name
                                 and destination, which AT can learn nowhere
                                 else on this step (mac exposes it). -->
                            <TextBlock Margin="0,4,0,8"
                                       Text="{Binding PromptStepSubtitle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="TemplatePromptsSubtitle"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Padding="10,4"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    AutomationProperties.AutomationId="TemplatePromptsCancel"
                                    AutomationProperties.HelpText="Cancels the create-from-template flow." />
                            <Button Margin="8,0,0,0"
                                    Padding="10,4"
                                    Content="Next"
                                    Command="{Binding NextCommand}"
                                    AutomationProperties.AutomationId="TemplatePromptsNext"
                                    AutomationProperties.HelpText="Continue to choose the new note's name. Enter." />
                        </StackPanel>
                        <!-- Focusable=False on BOTH layout hosts: ScrollViewer
                             and ItemsControl are Controls, whose Focusable
                             default is TRUE — the journey's axe scan caught
                             the ItemsControl as a focusable unnamed List (the
                             W4-5 class), and the red team caught the
                             ScrollViewer as the same class one level up,
                             where axe's Pane rules cannot see it. The prompt
                             TextBoxes are the tab stops; these are layout. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Focusable="False">
                            <ItemsControl x:Name="TemplateFlowPromptsList"
                                          Focusable="False"
                                          ItemsSource="{Binding PromptFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <local:AutomationPresentationTextBlock Margin="0,0,0,2"
                                                    Text="{Binding Label}" />
                                            <TextBox Padding="6,4"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsNameStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Name the new note"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <!-- Plain TextBlock: the template name lives
                                 here (mac exposes it). -->
                            <TextBlock Margin="0,4,0,8"
                                       Text="{Binding NameStepSubtitle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="TemplateNameSubtitle"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Padding="10,4"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    AutomationProperties.AutomationId="TemplateNameCancel"
                                    AutomationProperties.HelpText="Cancels the create-from-template flow. No file is written." />
                            <Button Margin="8,0,0,0"
                                    Padding="10,4"
                                    Content="Create"
                                    Command="{Binding CreateCommand}"
                                    PreviewMouseLeftButtonDown="TemplateNameCreate_PreviewMouseLeftButtonDown"
                                    AutomationProperties.AutomationId="TemplateNameCreate"
                                    AutomationProperties.HelpText="Render the template and open the new note. Enter." />
                        </StackPanel>
                        <StackPanel>
                            <local:AutomationPresentationTextBlock Margin="0,0,0,2" Text="New note name" />
                            <local:AutomationPresentationTextBlock Margin="0,0,0,4"
                                    Text="{Binding NameHint}"
                                    Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            <TextBox x:Name="TemplateFlowNameTextBox"
                                     Padding="6,4"
                                     Text="{Binding NoteName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="TemplateFlowName"
                                     AutomationProperties.Name="{Binding NameFieldAccessibleName}"
                                     AutomationProperties.HelpText=".md extension added automatically." />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding ValidationError}"
                                       Foreground="{DynamicResource Slate.WarningBrush}"
                                       TextWrapping="Wrap"
                                       Focusable="True"
                                       AutomationProperties.Name="{Binding ValidationErrorAccessibleName}"
                                       Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W5-4 (#744) F4: the Move-To folder picker — the keyboard-
                 first, drag-free move path. Filter-as-you-type; Enter
                 moves to the selected row; Esc cancels and nothing moves.
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding FileSidebar.MoveToSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="MoveToOverlay"
                    Width="520"
                    MaxHeight="440"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.FileSidebar.MoveToSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding FileSidebar.MoveToSheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="MoveToOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="MoveToSheet"
                    AutomationProperties.Name="Move to folder"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Margin="0,4,0,8"
                                   Text="{Binding Subtitle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="MoveToSubtitle"
                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        <TextBox x:Name="MoveToFilterTextBox"
                                 Padding="6,4"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="MoveToFilter"
                                 AutomationProperties.Name="Filter folders"
                                 AutomationProperties.HelpText="Type to filter destination folders, or type a new folder name." />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="MoveToCancelButton"
                                Padding="10,4"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="MoveToCancel"
                                AutomationProperties.HelpText="Closes the folder picker without moving anything." />
                    </StackPanel>
                    <!-- MinHeight: an EMPTY destination list (a vault
                         with no folders, or a filter with no matches)
                         must keep UIA extent — a zero-size list is an
                         axe BoundingRectangleNotNull violation (W5-4
                         journey finding). -->
                    <ListBox x:Name="MoveToList"
                             MinHeight="48"
                             Margin="0,8,0,0"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow}"
                             BorderThickness="0"
                             Background="Transparent"
                             MouseDoubleClick="MoveToList_MouseDoubleClick"
                             AutomationProperties.AutomationId="MoveToList"
                             AutomationProperties.Name="Destination folders">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="Activate to move here." />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <local:AutomationPresentationTextBlock
                                            Text="{Binding Label}" FontWeight="SemiBold" />
                                    <local:AutomationPresentationTextBlock
                                            Text="{Binding Detail}"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                            Visibility="{Binding Detail, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </local:AutomationLandmarkBorder>

            <local:AutomationLandmarkBorder x:Name="CanvasCardEditorOverlay"
                    Padding="16"
                    MinWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.CanvasCardEditorSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CanvasCardEditorSheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="CanvasCardEditorSheet"
                    AutomationProperties.Name="Card editor"
                    AutomationProperties.IsDialog="True">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="120"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="CanvasCardEditorText"
                             AutomationProperties.Name="Card text. Escape saves and returns to the canvas."
                             AutomationProperties.HelpText="Escape commits; discard with the editor's own undo first." />
                </StackPanel>
            </local:AutomationLandmarkBorder>
        </Grid>
    </DockPanel>
</Window>
