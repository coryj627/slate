<Window x:Class="SlateWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SlateWindows"
        xmlns:cmd="clr-namespace:SlateWindows.Commands"
        xmlns:panels="clr-namespace:SlateWindows.Panels"
        xmlns:bases="clr-namespace:SlateWindows.Bases"
        xmlns:grids="clr-namespace:SlateWindows.Grids"
        xmlns:templates="clr-namespace:SlateWindows.Templates"
        xmlns:graph="clr-namespace:SlateWindows.Graph"
        Title="{Binding WindowTitle, FallbackValue=Slate}"
        Height="720" Width="1120"
        MinHeight="480" MinWidth="500"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Slate.FontFamilyText}"
        FontSize="{DynamicResource Slate.FontSizeBody}"
        AutomationProperties.AutomationId="Slate.MainWindow"
        Background="{DynamicResource Slate.WindowBackgroundBrush}"
        Foreground="{DynamicResource Slate.TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseUp="Window_PreviewMouseUp"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <!-- DS-12 (#1813): one 48 row for the title bar and the menus. WindowChrome keeps resize,
         Snap, Win+arrow and Alt+Space native; the caption height follows the row, which grows
         with text size (TitleBar_SizeChanged). Any glass frame, WindowChrome's default
         included, takes ClearType from the whole window, so there is none. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- #1762: a row with its own style loses Fluent's and falls back to WPF's
                 classic template, which hard-codes a blue selection. Every ListBoxItem
                 style in this window is based on this one. -->
            <Style x:Key="Slate.PanelRowBase" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource Slate.RowFocusVisual}" />
                <Setter Property="Template" Value="{DynamicResource Slate.PanelRowTemplate}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenVaultCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding QuickSwitcher.OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Workspace.SaveActiveCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding Workspace.ToggleReadingModeCommand}" />
        <!-- WB-22 (#1112): Ctrl+F bubbles here only when no surface claimed it
             (a Base's grid and a canvas take it first); never a case in
             Window_PreviewKeyDown, which tunnels ahead of every surface.
             Ctrl+G / Ctrl+Shift+G are routed commands whose CanExecute sets
             ContinueRouting, so they pass through when no focused note's bar
             is open (a plain-ICommand binding would swallow the key). -->
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindInNoteChordCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{x:Static local:FindInNoteKeyRoute.FindNext}" />
        <KeyBinding Key="G" Modifiers="Control+Shift" Command="{x:Static local:FindInNoteKeyRoute.FindPrevious}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding Workspace.CloseActiveTabCommand}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding Workspace.CloseActiveTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding Workspace.DuplicateTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding Workspace.ReopenClosedTabCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding Workspace.OpenTasksReviewCommand}" />
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding Workspace.OpenBulkRenameSheetCommand}" />
        <KeyBinding Key="Oem5" Modifiers="Control" Command="{Binding Workspace.SplitRightCommand}" />
        <KeyBinding Key="Oem5" Modifiers="Control+Alt" Command="{Binding Workspace.SplitDownCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control+Shift" Command="{Binding Workspace.NextTabCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control+Shift" Command="{Binding Workspace.PreviousTabCommand}" />
        <KeyBinding Key="Left" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneLeftCommand}" />
        <!-- W7-6 (#1240): F6 / Shift+F6 cycle the shell regions; the verbs
             were the PR-4 orphans focusNextPane / focusPreviousPane. -->
        <KeyBinding Key="F6" Command="{Binding Workspace.FocusNextPaneCommand}" />
        <KeyBinding Key="F6" Modifiers="Shift" Command="{Binding Workspace.FocusPreviousPaneCommand}" />
        <KeyBinding Key="Right" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneRightCommand}" />
        <KeyBinding Key="Up" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneAboveCommand}" />
        <KeyBinding Key="Down" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneBelowCommand}" />
        <KeyBinding Key="Left" Modifiers="Control+Alt+Shift" Command="{Binding Workspace.MoveTabLeftCommand}" />
        <KeyBinding Key="Right" Modifiers="Control+Alt+Shift" Command="{Binding Workspace.MoveTabRightCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control+Alt" Command="{Binding FileSidebar.HistoryBackCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control+Alt" Command="{Binding FileSidebar.HistoryForwardCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control+Alt" Command="{Binding Workspace.GrowPaneCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control+Alt" Command="{Binding Workspace.ShrinkPaneCommand}" />
        <KeyBinding Key="I" Modifiers="Control+Alt" Command="{Binding Workspace.ToggleRightPaneCommand}" />
        <!-- W4-5 (#737). Ctrl+J is enabled only while a citation is
             expanded, mirroring mac. -->
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding Workspace.JumpToBibliographyCommand}" />
        <KeyBinding Key="J" Modifiers="Control+Shift" Command="{Binding Workspace.OpenCitationSummaryCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Workspace.ActiveGroup.ActiveTab.EditorInteractions.ClosePopoverCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}}" />
    </Window.InputBindings>

    <DockPanel KeyDown="TrashFallback_KeyDown">
        <!-- W7-5 (#1239): two things the first NVDA field pass found, both
             owned here. (1) WPF's Menu defaults TabNavigation to Cycle, so a
             Tab that enters the bar never leaves it (File > ... > Files >
             File, five times over in the log); None keeps Tab out of the bar
             entirely, as in every Win32 app, and Alt / Alt+letter / F6 (W7-6)
             remain its routes. (2) The LOCAL Menu.Style below replaces
             Fluent's implicit Menu style, and with it the style's
             Foreground = MenuBarForeground; the bar then fell back to the
             OS theme's dark MenuText, which every item INHERITED, so in the
             dark theme enabled items drew near-black on the popup while
             disabled ones kept Fluent's translucent white. The reference is
             declared here so the inheritance chain starts at Fluent's
             token again; MenuItemForegroundTests renders it. (3) W7-7
             PR 4 (#1247, R-5): the arrows stay out as well. Menu's
             default DirectionalNavigation is Cycle, which makes the bar a
             directional GROUP any arrow search in the window can choose:
             from the empty editor stop Down and Up reached Canvas, Left
             Graph and Right File (NVDA pass F4). None refuses entry from
             outside. (4) DS-13 (#1814, plan 46 DSD7): the bar holds one item,
             the logo, with File to Graph inside its popup, so Left and Right
             between headers became Up and Down between rows, and the row's
             wrapping panel went. The menus' letters aren't live inside a
             closed popup, so Alt+F, W, B, E, N and G open it at their menu in
             the window's key handler (AppMenuKeys), and F10 opens it.
             MenuBarCensus pins all of it. -->
        <Grid x:Name="TitleBar"
              DockPanel.Dock="Top"
              MinHeight="48"
              Background="{DynamicResource Slate.WindowBackgroundBrush}"
              SizeChanged="TitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The menus' logo takes what the quick commands and captions leave (DS-13: one
                 item where six headers wrapped). The title takes what the logo leaves. -->
            <DockPanel>
        <Menu x:Name="MainMenu"
              DockPanel.Dock="Left"
              VerticalAlignment="Center"
              WindowChrome.IsHitTestVisibleInChrome="True"
              Focusable="False"
              KeyboardNavigation.TabNavigation="None"
              KeyboardNavigation.DirectionalNavigation="None"
              FontFamily="{DynamicResource Slate.FontFamilyText}"
              FontSize="{DynamicResource Slate.FontSizeBody}"
              Foreground="{DynamicResource MenuBarForeground}"
              Background="{DynamicResource Slate.WindowBackgroundBrush}"
              AutomationProperties.Name="Application commands"
              PreviewKeyDown="MainMenu_PreviewKeyDown">
            <!-- The menu disables under EVERY modal surface — mac
                 parity: AppKit disables the menu bar while a sheet is
                 up, which is why mac's unguarded menu commands are
                 safe. Red-team round 1 (W5-2): only the three overlays
                 were listed here, so Workspace ▸ Search Vault… (and,
                 pre-existing since W1, File ▸ Quick Open…) opened its
                 overlay INVISIBLY beneath any of the seven sheets. One
                 trigger per ModalSurface member, in paint order; the
                 sheets are object properties (open == non-null), so
                 they route through IsNotNullConverter. Gated by
                 ModalSurfaceTests.TheMenuDisablesUnderEveryModalSurface,
                 so surface #11 cannot be forgotten. -->
            <Menu.Style>
                <Style TargetType="Menu">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding QuickSwitcher.IsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Search.IsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Palette.IsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.AddPropertySheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.BulkRenameSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.CitationDetails, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.CitationSummary, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.FilesCiting, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.DashboardEditorSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.BaseQueryBuilderSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.TemplatePickerSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.TemplateFlowSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FileSidebar.MoveToSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.CanvasCardEditorSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.CanvasCardPickerSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Workspace.CanvasPromptSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SettingsSheet, Converter={StaticResource IsNotNullConverter}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <!-- #1690: last, so they win over the overlays' triggers above. A
                             chord pressed with the keys in the menu opens Quick Open, search
                             or the palette over it, and the overlay's field takes the keys in
                             the same turn. Those triggers may run first, and off while it held
                             the keys, the menu said "unavailable" in NVDA before the field. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding QuickSwitcher.IsOpen}" Value="True" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsEnabled" Value="True" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Search.IsOpen}" Value="True" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsEnabled" Value="True" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Palette.IsOpen}" Value="True" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsEnabled" Value="True" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Menu.Style>
            <!-- DS-13: the logo, named "Slate menu", with Alt+F as its key
                 (design/windows/readme.md:127). The header stays text and the
                 template draws the image: with an image as the header itself,
                 NVDA said nothing for any row of the popup (the field pass).
                 MenuBarCensus pins the shape. -->
            <MenuItem x:Name="AppMenuItem"
                      Header="Slate"
                      AutomationProperties.AutomationId="AppMenu"
                      AutomationProperties.Name="Slate menu"
                      AutomationProperties.AcceleratorKey="Alt+F">
                <MenuItem.HeaderTemplate>
                    <DataTemplate>
                        <Image Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <BitmapImage UriSource="pack://application:,,,/SlateWindows;component/Assets/slate-gold.png" DecodePixelWidth="64" />
                            </Image.Source>
                        </Image>
                    </DataTemplate>
                </MenuItem.HeaderTemplate>
                <MenuItem Header="_File"
                          AutomationProperties.AutomationId="FileMenu">
                    <MenuItem Header="_Open Vault…"
                              AutomationProperties.AutomationId="OpenVaultMenuItem"
                              InputGestureText="{cmd:ChordText slate.vault.open}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}"
                              Command="{Binding OpenVaultCommand}" />
                    <MenuItem Header="_Quick Open…"
                              AutomationProperties.AutomationId="QuickOpenMenuItem"
                              InputGestureText="{cmd:ChordText slate.workspace.quickOpen}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}"
                              Click="QuickOpen_Click" />
                    <Separator />
                    <!-- W5-3 (#743): create-from-template. mac homes this in
                         the sidebar action catalog + ⇧⌘N; the Windows menu
                         home is File per the W4 convention. Invokes the
                         workspace command; the modal admission runs inside
                         the open (T9), so a menu invocation under a sheet
                         refuses instead of presenting beneath it (#1118's
                         class). -->
                    <MenuItem Header="New Note from _Template…"
                              AutomationProperties.AutomationId="NewFromTemplateMenuItem"
                              InputGestureText="{cmd:ChordText slate.file.newFromTemplate}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}"
                              Command="{Binding Workspace.NewFromTemplateCommand}" />
                    <!-- §E TE-10 (IE-21): the vault-scoped create — mac's
                         File-menu New Canvas, chordless on both hosts. -->
                    <MenuItem Header="New _Canvas"
                              AutomationProperties.AutomationId="NewCanvasMenuItem"
                              Command="{Binding FileSidebar.CreateCanvasCommand}" />
                    <Separator />
                    <MenuItem Header="_Close Vault"
                              AutomationProperties.AutomationId="CloseVaultMenuItem"
                              Command="{Binding CloseVaultCommand}" />
                    <Separator />
                    <Separator />
                    <!-- W7-5 (#1239): the file-sidebar verbs. They shipped as a
                         SEVENTH top-level menu named "Files" beside "File", both on
                         Alt+F: WPF answers a shared mnemonic by focusing the first
                         match and waiting, so Alt+F opened nothing, and a reader
                         heard two menus a trailing "s" apart. One File menu, the
                         sidebar verbs a submenu of it; MenuBarCensus keeps the
                         top level unique. -->
                    <MenuItem Header="Files _Sidebar"
                              AutomationProperties.AutomationId="FilesSidebarMenu">
                        <MenuItem Header="_Open"
                                  AutomationProperties.AutomationId="FilesSidebarOpenMenuItem"
                                  Command="{Binding FileSidebar.OpenCurrentCommand}" />
                        <MenuItem Header="Open in New _Tab"
                                  AutomationProperties.AutomationId="FilesSidebarOpenInNewTabMenuItem"
                                  Command="{Binding FileSidebar.OpenNewTabCommand}" />
                        <MenuItem Header="Open in _Split"
                                  AutomationProperties.AutomationId="FilesSidebarOpenInSplitMenuItem"
                                  Command="{Binding FileSidebar.OpenSplitCommand}" />
                        <Separator />
                        <MenuItem Header="_Import Files and Folders…"
                                  AutomationProperties.AutomationId="FilesSidebarImportFilesAndFoldersMenuItem"
                                  Command="{Binding FileSidebar.ImportCommand}" />
                        <MenuItem Header="_Cancel Import"
                                  AutomationProperties.AutomationId="FilesSidebarCancelImportMenuItem"
                                  Command="{Binding FileSidebar.CancelImportCommand}" />
                        <Separator />
                        <MenuItem Header="_Refresh"
                                  AutomationProperties.AutomationId="FilesSidebarRefreshMenuItem"
                                  Command="{Binding FileSidebar.RefreshCommand}" />
                        <MenuItem Header="_Collapse All"
                                  AutomationProperties.AutomationId="FilesSidebarCollapseAllMenuItem"
                                  Command="{Binding FileSidebar.CollapseAllCommand}" />
                        <MenuItem Header="_Expand Loaded"
                                  AutomationProperties.AutomationId="FilesSidebarExpandLoadedMenuItem"
                                  Command="{Binding FileSidebar.ExpandLoadedCommand}" />
                        <MenuItem Header="Focus _Filter"
                                  AutomationProperties.AutomationId="FilesSidebarFocusFilterMenuItem"
                                  InputGestureText="{cmd:ChordText slate.sidebar.focusFilter}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Click="FocusFilter_Click" />
                        <MenuItem Header="_Back"
                                  AutomationProperties.AutomationId="FilesSidebarBackMenuItem"
                                  InputGestureText="{cmd:ChordText slate.sidebar.historyBack}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding FileSidebar.HistoryBackCommand}" />
                        <MenuItem Header="_Forward"
                                  AutomationProperties.AutomationId="FilesSidebarForwardMenuItem"
                                  InputGestureText="{cmd:ChordText slate.sidebar.historyForward}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding FileSidebar.HistoryForwardCommand}" />
                        <Separator />
                        <MenuItem Header="_Pin Note"
                                  AutomationProperties.AutomationId="FilesSidebarPinNoteMenuItem"
                                  Command="{Binding FileSidebar.PinCommand}" />
                        <MenuItem Header="_Unpin Note"
                                  AutomationProperties.AutomationId="FilesSidebarUnpinNoteMenuItem"
                                  Command="{Binding FileSidebar.UnpinCommand}" />
                        <MenuItem Header="Unpin _All in Folder"
                                  AutomationProperties.AutomationId="FilesSidebarUnpinAllInFolderMenuItem"
                                  Command="{Binding FileSidebar.UnpinAllCommand}" />
                        <MenuItem Header="Add to _Shortcuts"
                                  AutomationProperties.AutomationId="FilesSidebarAddToShortcutsMenuItem"
                                  Command="{Binding FileSidebar.AddShortcutCommand}" />
                        <MenuItem Header="_Remove Shortcut"
                                  AutomationProperties.AutomationId="FilesSidebarRemoveShortcutMenuItem"
                                  Command="{Binding FileSidebar.RemoveShortcutCommand}" />
                        <MenuItem Header="Use Vault Default _Sort"
                                  AutomationProperties.AutomationId="FilesSidebarUseVaultDefaultSortMenuItem"
                                  Command="{Binding FileSidebar.UseVaultDefaultSortCommand}" />
                        <MenuItem Header="Clear _Recents"
                                  AutomationProperties.AutomationId="FilesSidebarClearRecentsMenuItem"
                                  Command="{Binding FileSidebar.ClearRecentsCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="S_ettings…"
                              AutomationProperties.AutomationId="SettingsMenuItem"
                              InputGestureText="{cmd:ChordText slate.settings.open}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}"
                              Command="{Binding OpenSettingsCommand}" />
                    <Separator />
                    <MenuItem Header="E_xit" Command="{x:Static ApplicationCommands.Close}" />
                </MenuItem>
                <MenuItem Header="_Workspace"
                          AutomationProperties.AutomationId="WorkspaceMenu">
                    <MenuItem Header="_Duplicate Tab" InputGestureText="{cmd:ChordText slate.workspace.newTab}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.DuplicateTabCommand}" />
                    <MenuItem Header="_Close Tab" InputGestureText="{cmd:ChordText slate.workspace.closeTab}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.CloseActiveTabCommand}" />
                    <MenuItem Header="_Reopen Closed Tab" InputGestureText="{cmd:ChordText slate.workspace.reopenClosedTab}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.ReopenClosedTabCommand}" />
                    <Separator />
                    <MenuItem Header="Split _Right" AutomationProperties.AutomationId="SplitRightMenuItem" InputGestureText="{cmd:ChordText slate.workspace.splitRight}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.SplitRightCommand}" />
                    <MenuItem Header="Split _Down" AutomationProperties.AutomationId="SplitDownMenuItem" InputGestureText="{cmd:ChordText slate.workspace.splitDown}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.SplitDownCommand}" />
                    <MenuItem Header="Close _Pane" AutomationProperties.AutomationId="ClosePaneMenuItem" Command="{Binding Workspace.ClosePaneCommand}" />
                    <Separator />
                    <MenuItem Header="Focus Pane _Left" InputGestureText="{cmd:ChordText slate.workspace.focusPaneLeft}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.FocusPaneLeftCommand}" />
                    <MenuItem Header="Focus Pane _Right" InputGestureText="{cmd:ChordText slate.workspace.focusPaneRight}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.FocusPaneRightCommand}" />
                    <MenuItem Header="Focus Pane _Above" InputGestureText="{cmd:ChordText slate.workspace.focusPaneAbove}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.FocusPaneAboveCommand}" />
                    <MenuItem Header="Focus Pane _Below" InputGestureText="{cmd:ChordText slate.workspace.focusPaneBelow}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.FocusPaneBelowCommand}" />
                    <MenuItem Header="Focus Next _Region"
                              AutomationProperties.AutomationId="WorkspaceFocusNextRegionMenuItem"
                              InputGestureText="{cmd:ChordText slate.workspace.focusNextPane}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}"
                              Command="{Binding Workspace.FocusNextPaneCommand}" />
                    <MenuItem Header="Focus Previous Re_gion"
                              AutomationProperties.AutomationId="WorkspaceFocusPreviousRegionMenuItem"
                              InputGestureText="{cmd:ChordText slate.workspace.focusPreviousPane}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}"
                              Command="{Binding Workspace.FocusPreviousPaneCommand}" />
                    <MenuItem Header="Move Tab Left" InputGestureText="{cmd:ChordText slate.workspace.moveTabLeft}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.MoveTabLeftCommand}" />
                    <MenuItem Header="Move Tab Right" InputGestureText="{cmd:ChordText slate.workspace.moveTabRight}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.MoveTabRightCommand}" />
                    <!-- W7-7 PR 4b (#1247, AR-38): the keyboard's sidebar resize. -->
                    <MenuItem Header="Widen _Files Sidebar"
                              AutomationProperties.AutomationId="WorkspaceWidenFilesSidebarMenuItem"
                              Command="{Binding Workspace.WidenFilesSidebarCommand}" />
                    <MenuItem Header="Narrow F_iles Sidebar"
                              AutomationProperties.AutomationId="WorkspaceNarrowFilesSidebarMenuItem"
                              Command="{Binding Workspace.NarrowFilesSidebarCommand}" />
                    <MenuItem Header="Widen Right Pa_ne"
                              AutomationProperties.AutomationId="WorkspaceWidenRightPaneMenuItem"
                              Command="{Binding Workspace.WidenRightPaneCommand}" />
                    <MenuItem Header="Narrow Right Pan_e"
                              AutomationProperties.AutomationId="WorkspaceNarrowRightPaneMenuItem"
                              Command="{Binding Workspace.NarrowRightPaneCommand}" />
                    <MenuItem Header="_Grow Pane" InputGestureText="{cmd:ChordText slate.workspace.growPane}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.GrowPaneCommand}" />
                    <MenuItem Header="_Shrink Pane" InputGestureText="{cmd:ChordText slate.workspace.shrinkPane}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.ShrinkPaneCommand}" />
                    <Separator />
                    <MenuItem Header="_Toggle Files Sidebar"
                              AutomationProperties.AutomationId="WorkspaceToggleFilesSidebarMenuItem"
                              Command="{Binding Workspace.ToggleFilesSidebarCommand}" />
                    <MenuItem Header="Toggle Right _Pane" InputGestureText="{cmd:ChordText slate.view.toggleRightPane}" AutomationProperties.AcceleratorKey="{Binding InputGestureText, RelativeSource={RelativeSource Self}}" Command="{Binding Workspace.ToggleRightPaneCommand}" />
                    <MenuItem Header="Switch T_heme…"
                              AutomationProperties.AutomationId="SwitchThemeMenuItem"
                              Command="{Binding SwitchThemeCommand}" />
                    <!-- W5-2 close-out (#742): slate.view.toggleSearch. mac
                         homes "Search Vault…" in Edit; Windows has no Edit
                         menu, and its view-section verbs live here beside
                         Toggle Right Pane. Invokes the same unguarded
                         ToggleSearchCommand the palette runs; the
                         Ctrl+Shift+F chord stays imperative in
