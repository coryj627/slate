<Window x:Class="SlateWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SlateWindows"
        xmlns:panels="clr-namespace:SlateWindows.Panels"
        xmlns:grids="clr-namespace:SlateWindows.Grids"
        Title="Slate"
        Height="720" Width="1120"
        MinHeight="480" MinWidth="760"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="Slate.MainWindow"
        Background="{DynamicResource Slate.WindowBackgroundBrush}"
        Foreground="{DynamicResource Slate.TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenVaultCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding QuickSwitcher.OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Workspace.SaveActiveCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding Workspace.ToggleReadingModeCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding Workspace.CloseActiveTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding Workspace.DuplicateTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding Workspace.ReopenClosedTabCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding Workspace.OpenTasksReviewCommand}" />
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding Workspace.OpenBulkRenameSheetCommand}" />
        <KeyBinding Key="Oem5" Modifiers="Control" Command="{Binding Workspace.SplitRightCommand}" />
        <KeyBinding Key="Oem5" Modifiers="Control+Alt" Command="{Binding Workspace.SplitDownCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control+Shift" Command="{Binding Workspace.NextTabCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control+Shift" Command="{Binding Workspace.PreviousTabCommand}" />
        <KeyBinding Key="Left" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneLeftCommand}" />
        <KeyBinding Key="Right" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneRightCommand}" />
        <KeyBinding Key="Up" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneAboveCommand}" />
        <KeyBinding Key="Down" Modifiers="Control+Alt" Command="{Binding Workspace.FocusPaneBelowCommand}" />
        <KeyBinding Key="Left" Modifiers="Control+Alt+Shift" Command="{Binding Workspace.MoveTabLeftCommand}" />
        <KeyBinding Key="Right" Modifiers="Control+Alt+Shift" Command="{Binding Workspace.MoveTabRightCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control+Alt" Command="{Binding FileSidebar.HistoryBackCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control+Alt" Command="{Binding FileSidebar.HistoryForwardCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control+Alt" Command="{Binding Workspace.GrowPaneCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control+Alt" Command="{Binding Workspace.ShrinkPaneCommand}" />
        <KeyBinding Key="I" Modifiers="Control+Alt" Command="{Binding Workspace.ToggleRightPaneCommand}" />
        <!-- W4-5 (#737). Ctrl+J is enabled only while a citation is
             expanded, mirroring mac. -->
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding Workspace.JumpToBibliographyCommand}" />
        <KeyBinding Key="J" Modifiers="Control+Shift" Command="{Binding Workspace.OpenCitationSummaryCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Workspace.ActiveGroup.ActiveTab.EditorInteractions.ClosePopoverCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu x:Name="MainMenu"
              DockPanel.Dock="Top"
              AutomationProperties.Name="Application commands">
            <Menu.Style>
                <Style TargetType="Menu">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding QuickSwitcher.IsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Menu.Style>
            <MenuItem Header="_File"
                      AutomationProperties.AutomationId="FileMenu">
                <MenuItem Header="_Open Vault…"
                          AutomationProperties.AutomationId="OpenVaultMenuItem"
                          InputGestureText="Ctrl+Shift+O"
                          Command="{Binding OpenVaultCommand}" />
                <MenuItem Header="_Quick Open…"
                          AutomationProperties.AutomationId="QuickOpenMenuItem"
                          InputGestureText="Ctrl+O"
                          Click="QuickOpen_Click" />
                <Separator />
                <MenuItem Header="_Close Vault"
                          AutomationProperties.AutomationId="CloseVaultMenuItem"
                          Command="{Binding CloseVaultCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{x:Static ApplicationCommands.Close}" />
            </MenuItem>
            <MenuItem Header="_Workspace"
                      AutomationProperties.AutomationId="WorkspaceMenu">
                <MenuItem Header="_Duplicate Tab" InputGestureText="Ctrl+T" Command="{Binding Workspace.DuplicateTabCommand}" />
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Command="{Binding Workspace.CloseActiveTabCommand}" />
                <MenuItem Header="_Reopen Closed Tab" InputGestureText="Ctrl+Shift+T" Command="{Binding Workspace.ReopenClosedTabCommand}" />
                <Separator />
                <MenuItem Header="Split _Right" AutomationProperties.AutomationId="SplitRightMenuItem" InputGestureText="Ctrl+\" Command="{Binding Workspace.SplitRightCommand}" />
                <MenuItem Header="Split _Down" AutomationProperties.AutomationId="SplitDownMenuItem" InputGestureText="Ctrl+Alt+\" Command="{Binding Workspace.SplitDownCommand}" />
                <MenuItem Header="Close _Pane" AutomationProperties.AutomationId="ClosePaneMenuItem" Command="{Binding Workspace.ClosePaneCommand}" />
                <Separator />
                <MenuItem Header="Focus Pane _Left" InputGestureText="Ctrl+Alt+Left" Command="{Binding Workspace.FocusPaneLeftCommand}" />
                <MenuItem Header="Focus Pane _Right" InputGestureText="Ctrl+Alt+Right" Command="{Binding Workspace.FocusPaneRightCommand}" />
                <MenuItem Header="Focus Pane _Above" InputGestureText="Ctrl+Alt+Up" Command="{Binding Workspace.FocusPaneAboveCommand}" />
                <MenuItem Header="Focus Pane _Below" InputGestureText="Ctrl+Alt+Down" Command="{Binding Workspace.FocusPaneBelowCommand}" />
                <MenuItem Header="Move Tab Left" InputGestureText="Ctrl+Alt+Shift+Left" Command="{Binding Workspace.MoveTabLeftCommand}" />
                <MenuItem Header="Move Tab Right" InputGestureText="Ctrl+Alt+Shift+Right" Command="{Binding Workspace.MoveTabRightCommand}" />
                <MenuItem Header="_Grow Pane" InputGestureText="Ctrl+Alt+=" Command="{Binding Workspace.GrowPaneCommand}" />
                <MenuItem Header="_Shrink Pane" InputGestureText="Ctrl+Alt+-" Command="{Binding Workspace.ShrinkPaneCommand}" />
                <Separator />
                <MenuItem Header="Toggle Right _Pane" InputGestureText="Ctrl+Alt+I" Command="{Binding Workspace.ToggleRightPaneCommand}" />
                <MenuItem Header="Show Tasks _Review"
                          AutomationProperties.AutomationId="ShowTasksReviewMenuItem"
                          InputGestureText="Ctrl+R"
                          Command="{Binding Workspace.OpenTasksReviewCommand}" />
            </MenuItem>
            <MenuItem Header="_Editor"
                      AutomationProperties.AutomationId="EditorMenu">
                <MenuItem Header="_Activate at Cursor"
                          AutomationProperties.AutomationId="EditorActivateMenuItem"
                          InputGestureText="Ctrl+Enter"
                          Command="{Binding Workspace.ActiveGroup.ActiveTab.EditorInteractions.ActivateAtCaretCommand}" />
                <MenuItem Header="Preview _Embed"
                          AutomationProperties.AutomationId="EditorPreviewEmbedMenuItem"
                          InputGestureText="Ctrl+E"
                          Command="{Binding Workspace.ActiveGroup.ActiveTab.EditorInteractions.PreviewEmbedCommand}" />
                <MenuItem Header="Toggle _Reading Mode"
                          AutomationProperties.AutomationId="EditorToggleReadingModeMenuItem"
                          InputGestureText="Ctrl+Shift+E"
                          Command="{Binding Workspace.ToggleReadingModeCommand}" />
                <Separator />
                <!-- W4-4 (#736): menu-homed so bulk rename works when
                     the properties header isn't mounted; both disable
                     without a session (null Workspace). -->
                <MenuItem Header="Add _Property…"
                          AutomationProperties.AutomationId="AddPropertyMenuItem"
                          Command="{Binding Workspace.OpenAddPropertySheetCommand}" />
                <MenuItem Header="Bulk Rename Pr_operties…"
                          AutomationProperties.AutomationId="BulkRenamePropertiesMenuItem"
                          InputGestureText="Ctrl+Shift+R"
                          Command="{Binding Workspace.OpenBulkRenameSheetCommand}" />
                <Separator />
                <MenuItem Header="Check _Spelling While Typing"
                          AutomationProperties.AutomationId="EditorToggleSpellCheckMenuItem"
                          IsCheckable="True"
                          IsChecked="{Binding Workspace.EditorPreferences.IsSpellCheckEnabled, Mode=OneWay}"
                          Command="{Binding Workspace.EditorPreferences.ToggleSpellCheckCommand}" />
                <MenuItem Header="Open Reading Lin_ks in New Tab"
                          AutomationProperties.AutomationId="EditorToggleReadingLinkTargetMenuItem"
                          IsCheckable="True"
                          IsChecked="{Binding Workspace.EditorPreferences.OpenReadingLinksInNewTab, Mode=OneWay}"
                          Command="{Binding Workspace.EditorPreferences.ToggleReadingLinkTargetCommand}" />
                <MenuItem Header="_Math"
                          AutomationProperties.AutomationId="EditorMathPrefsMenu">
                    <MenuItem Header="Speech Style: _ClearSpeak"
                              AutomationProperties.AutomationId="EditorMathClearSpeakMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathSpeechClearSpeak, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathSpeechStyleCommand}"
                              CommandParameter="clearSpeak" />
                    <MenuItem Header="Speech Style: _MathSpeak (unavailable)"
                              AutomationProperties.AutomationId="EditorMathMathSpeakMenuItem"
                              IsEnabled="False"
                              ToolTip="Not yet implemented by the speech engine (#1056)."
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathSpeechMathSpeak, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Header="Verbosity: _Terse"
                              AutomationProperties.AutomationId="EditorMathTerseMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathVerbosityTerse, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathVerbosityCommand}"
                              CommandParameter="terse" />
                    <MenuItem Header="Verbosity: M_edium"
                              AutomationProperties.AutomationId="EditorMathMediumMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathVerbosityMedium, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathVerbosityCommand}"
                              CommandParameter="medium" />
                    <MenuItem Header="Verbosity: _Verbose"
                              AutomationProperties.AutomationId="EditorMathVerboseMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathVerbosityVerbose, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathVerbosityCommand}"
                              CommandParameter="verbose" />
                    <Separator />
                    <MenuItem Header="Braille: _Nemeth"
                              AutomationProperties.AutomationId="EditorMathNemethMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathBrailleNemeth, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathBrailleCodeCommand}"
                              CommandParameter="nemeth" />
                    <MenuItem Header="Braille: _UEB"
                              AutomationProperties.AutomationId="EditorMathUebMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsMathBrailleUeb, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetMathBrailleCodeCommand}"
                              CommandParameter="ueb" />
                </MenuItem>
                <MenuItem Header="Code Preamble _Verbosity"
                          AutomationProperties.AutomationId="EditorCodeVerbosityMenu">
                    <MenuItem Header="Preamble _Only"
                              AutomationProperties.AutomationId="EditorCodeVerbosityPreambleOnlyMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsCodeVerbosityPreambleOnly, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetCodePreambleVerbosityCommand}"
                              CommandParameter="preambleOnly" />
                    <MenuItem Header="Preamble + _First Line"
                              AutomationProperties.AutomationId="EditorCodeVerbosityFirstLineMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsCodeVerbosityFirstLine, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetCodePreambleVerbosityCommand}"
                              CommandParameter="preambleFirstLine" />
                    <MenuItem Header="Preamble + _All Tokens"
                              AutomationProperties.AutomationId="EditorCodeVerbosityAllTokensMenuItem"
                              IsCheckable="True"
                              IsChecked="{Binding Workspace.EditorPreferences.IsCodeVerbosityAllTokens, Mode=OneWay}"
                              Command="{Binding Workspace.EditorPreferences.SetCodePreambleVerbosityCommand}"
                              CommandParameter="preambleAllTokens" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Zoom _In"
                          AutomationProperties.AutomationId="EditorZoomInMenuItem"
                          Command="{Binding Workspace.EditorPreferences.ZoomInCommand}" />
                <MenuItem Header="Zoom _Out"
                          AutomationProperties.AutomationId="EditorZoomOutMenuItem"
                          Command="{Binding Workspace.EditorPreferences.ZoomOutCommand}" />
                <MenuItem Header="_Actual Size"
                          AutomationProperties.AutomationId="EditorActualSizeMenuItem"
                          Command="{Binding Workspace.EditorPreferences.ActualSizeCommand}" />
            </MenuItem>
            <MenuItem Header="_Files">
                <MenuItem Header="_Open" Command="{Binding FileSidebar.OpenCurrentCommand}" />
                <MenuItem Header="Open in New _Tab" Command="{Binding FileSidebar.OpenNewTabCommand}" />
                <MenuItem Header="Open in _Split" Command="{Binding FileSidebar.OpenSplitCommand}" />
                <Separator />
                <MenuItem Header="_Import Files and Folders…" Command="{Binding FileSidebar.ImportCommand}" />
                <MenuItem Header="_Cancel Import" Command="{Binding FileSidebar.CancelImportCommand}" />
                <Separator />
                <MenuItem Header="_Refresh" Command="{Binding FileSidebar.RefreshCommand}" />
                <MenuItem Header="_Collapse All" Command="{Binding FileSidebar.CollapseAllCommand}" />
                <MenuItem Header="_Expand Loaded" Command="{Binding FileSidebar.ExpandLoadedCommand}" />
                <MenuItem Header="Focus _Filter" InputGestureText="Ctrl+Alt+F" Click="FocusFilter_Click" />
                <MenuItem Header="_Back" InputGestureText="Ctrl+Alt+[" Command="{Binding FileSidebar.HistoryBackCommand}" />
                <MenuItem Header="_Forward" InputGestureText="Ctrl+Alt+]" Command="{Binding FileSidebar.HistoryForwardCommand}" />
                <Separator />
                <MenuItem Header="_Pin Note" Command="{Binding FileSidebar.PinCommand}" />
                <MenuItem Header="_Unpin Note" Command="{Binding FileSidebar.UnpinCommand}" />
                <MenuItem Header="Unpin _All in Folder" Command="{Binding FileSidebar.UnpinAllCommand}" />
                <MenuItem Header="Add to _Shortcuts" Command="{Binding FileSidebar.AddShortcutCommand}" />
                <MenuItem Header="_Remove Shortcut" Command="{Binding FileSidebar.RemoveShortcutCommand}" />
                <MenuItem Header="Use Vault Default _Sort" Command="{Binding FileSidebar.UseVaultDefaultSortCommand}" />
                <MenuItem Header="Clear _Recents" Command="{Binding FileSidebar.ClearRecentsCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock"
                           AutomationProperties.AutomationId="VaultStatus"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Vault status" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch" Width="180">
                <ProgressBar Minimum="0"
                             AutomationProperties.AutomationId="VaultScanProgress"
                             Maximum="{Binding ProgressMaximum}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Height="6"
                             AutomationProperties.Name="Vault scan progress" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <local:AutomationLandmarkGrid x:Name="WelcomeRoot"
                  Background="{DynamicResource Slate.WindowBackgroundBrush}"
                  AutomationProperties.AutomationId="WelcomeView"
                  AutomationProperties.Name="Welcome"
                  Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  FocusManager.FocusedElement="{Binding ElementName=OpenVaultButton}">
                <local:AutomationLandmarkGrid.Style>
                    <Style TargetType="{x:Type local:AutomationLandmarkGrid}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding QuickSwitcher.IsOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:AutomationLandmarkGrid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="520" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Margin="0,56,0,32">
                    <TextBlock Text="Welcome to Slate" FontSize="30" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Margin="0,8,0,24" FontSize="15" Foreground="{DynamicResource Slate.SecondaryTextBrush}" Text="Open a folder of Markdown files to start." />
                    <Button x:Name="OpenVaultButton"
                            AutomationProperties.AutomationId="OpenVaultButton"
                            Content="_Open Vault…"
                            Command="{Binding OpenVaultCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Left"
                            Padding="16,8"
                            AutomationProperties.HelpText="Choose a folder to open as a Slate vault." />
                    <StackPanel Visibility="{Binding HasRecentVaults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,32,0,8" FontSize="18" FontWeight="SemiBold" Text="Recent Vaults" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{Binding RecentVaults}"
                                      AutomationProperties.Name="Recent vaults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,2"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            Padding="10,7"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Path}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource Slate.SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkGrid>

            <local:AutomationLandmarkGrid x:Name="WorkspaceRoot"
                  AutomationProperties.AutomationId="WorkspaceView"
                  AutomationProperties.Name="Workspace"
                  Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <local:AutomationLandmarkGrid.Style>
                    <Style TargetType="{x:Type local:AutomationLandmarkGrid}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding QuickSwitcher.IsOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:AutomationLandmarkGrid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource Slate.RaisedSurfaceBrush}" BorderBrush="{DynamicResource Slate.BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding VaultDisplayName}" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Text="{Binding VaultPath}" FontSize="12" Foreground="{DynamicResource Slate.SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="200" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="280" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <local:AutomationLandmarkBorder x:Name="FilesPaneBorder"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="FilesPane"
                            AutomationProperties.Name="Files"
                            Background="{DynamicResource Slate.SurfaceBrush}"
                            BorderBrush="{DynamicResource Slate.BorderBrush}"
                            BorderThickness="0,0,1,0"
                            DataContext="{Binding FileSidebar}">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Files"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <Button DockPanel.Dock="Right"
                                            Padding="6,2"
                                            Content="↻"
                                            ToolTip="Refresh"
                                            AutomationProperties.AutomationId="SidebarRefresh"
                                            AutomationProperties.Name="Refresh files"
                                            Command="{Binding RefreshCommand}" />
                                </DockPanel>
                                <TextBox x:Name="SidebarFilterTextBox"
                                         AutomationProperties.AutomationId="SidebarFilter"
                                         AutomationProperties.Name="Filter files"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         ToolTip="Filter by words, tag:, path:, or @date." />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                    <ComboBox Width="145"
                                              ItemsSource="{Binding SortModes}"
                                              SelectedItem="{Binding SortMode}"
                                              AutomationProperties.AutomationId="SidebarSortOrder"
                                              AutomationProperties.Name="File sort order">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SidebarSortModeLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="Group dates"
                                              AutomationProperties.AutomationId="SidebarGroupDates"
                                              IsChecked="{Binding GroupByDate}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ToggleButton Content="Tags"
                                                  IsChecked="{Binding ShowTags}"
                                                  AutomationProperties.AutomationId="SidebarShowTags"
                                                  AutomationProperties.Name="Show tag tree" />
                                    <ToggleButton Margin="6,0,0,0"
                                                  Content="Dual pane"
                                                  IsChecked="{Binding IsDualPaneEnabled}"
                                                  AutomationProperties.AutomationId="SidebarDualPaneToggle"
                                                  AutomationProperties.Name="Enable dual-pane files sidebar" />
                                </StackPanel>
                                <TreeView MaxHeight="120"
                                          ItemsSource="{Binding Tags}"
                                          ItemTemplate="{StaticResource SidebarTagTemplate}"
                                          SelectedItemChanged="Tags_SelectedItemChanged"
                                          Visibility="{Binding ShowTags, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          AutomationProperties.AutomationId="SidebarTagTree"
                                          AutomationProperties.Name="Tags">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </StackPanel>
                            <ScrollViewer DockPanel.Dock="Bottom"
                                          MaxHeight="210"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                              <StackPanel>
                                <TextBlock Margin="0,6,0,2"
                                           Text="{Binding BatchSelectionSummary}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                <Expander Header="Batch actions"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarBatchActions">
                                    <StackPanel>
                                        <TextBox Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Tag name" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Add" Command="{Binding AddTagCommand}" />
                                            <Button Margin="4,0,0,0" Content="Remove" Command="{Binding RemoveTagCommand}" />
                                        </StackPanel>
                                        <TextBox Margin="0,6,0,0"
                                                 Text="{Binding MoveDestination, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Move destination folder"
                                                 ToolTip="Vault-relative destination folder" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Move selected" Command="{Binding BatchMoveCommand}" />
                                            <Button Margin="4,0,0,0" Content="Trash selected" Command="{Binding BatchTrashCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="SidebarFileActionsExpander"
                                          Header="File actions"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarFileActions">
                                    <StackPanel>
                                        <TextBox x:Name="SidebarMutationNameTextBox"
                                                 Text="{Binding MutationName, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="SidebarMutationNameTextBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="SidebarMutationName"
                                                 AutomationProperties.Name="File or folder name" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="New note" Command="{Binding CreateNoteCommand}" />
                                            <Button Margin="4,0,0,0" Content="New folder" Command="{Binding CreateFolderCommand}" />
                                            <Button Margin="4,0,0,0" Content="Rename" Command="{Binding RenameCommand}" />
                                            <Button Margin="4,0,0,0" Content="Delete" Command="{Binding DeleteCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Folder note" Command="{Binding CreateFolderNoteCommand}" />
                                            <Button Margin="4,0,0,0" Content="Delete folder note" Command="{Binding DeleteFolderNoteCommand}" />
                                            <Button Margin="4,0,0,0" Content="Copy link" Command="{Binding CopyWikilinkCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Open" Command="{Binding OpenCurrentCommand}" />
                                            <Button Margin="4,0,0,0" Content="New tab" Command="{Binding OpenNewTabCommand}" />
                                            <Button Margin="4,0,0,0" Content="Split" Command="{Binding OpenSplitCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Pin" Command="{Binding PinCommand}" />
                                            <Button Margin="4,0,0,0" Content="Unpin" Command="{Binding UnpinCommand}" />
                                            <Button Margin="4,0,0,0" Content="Add shortcut" Command="{Binding AddShortcutCommand}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Import…" Command="{Binding ImportCommand}" />
                                            <Button Margin="4,0,0,0" Content="Cancel import" Command="{Binding CancelImportCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Shortcuts"
                                          Margin="0,2"
                                          AutomationProperties.AutomationId="SidebarShortcutsActions">
                                    <StackPanel>
                                        <ListBox MinHeight="24"
                                                 MaxHeight="100"
                                                 ItemsSource="{Binding Shortcuts}"
                                                 SelectedItem="{Binding SelectedShortcut}"
                                                 DisplayMemberPath="DisplayName"
                                                 AutomationProperties.AutomationId="SidebarShortcuts"
                                                 AutomationProperties.Name="File shortcuts" />
                                        <Button Margin="0,4,0,0"
                                                HorizontalAlignment="Left"
                                                Content="Remove shortcut"
                                                Command="{Binding RemoveShortcutCommand}" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding Status}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </ScrollViewer>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TreeView x:Name="FilesTree"
                                              ItemsSource="{Binding RootNodes}"
                                              ItemTemplate="{StaticResource FileTreeNodeTemplate}"
                                              TextSearch.TextPath="DisplayName"
                                              SelectedItemChanged="FilesTree_SelectedItemChanged"
                                              Visibility="{Binding IsFilterActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              AutomationProperties.AutomationId="FilesTree"
                                              AutomationProperties.Name="Files">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                    <ListBox x:Name="FilterResultsList"
                                             ItemsSource="{Binding FilterResults}"
                                             SelectionChanged="FilterResults_SelectionChanged"
                                             Visibility="{Binding IsFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.AutomationId="SidebarFilterResults"
                                             AutomationProperties.Name="Filtered files">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding Path}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                                <ListBox Grid.Row="1"
                                         MaxHeight="150"
                                         Margin="0,6,0,0"
                                         ItemsSource="{Binding DualPaneFiles}"
                                         SelectionChanged="DualPaneFiles_SelectionChanged"
                                         DisplayMemberPath="DisplayName"
                                         Visibility="{Binding IsDualPaneEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.AutomationId="SidebarDualPane"
                                         AutomationProperties.Name="Files in selected folder" />
                            </Grid>
                        </DockPanel>
                    </local:AutomationLandmarkBorder>
                    <GridSplitter Grid.Column="1"
                                  Background="{DynamicResource Slate.BorderBrush}"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  AutomationProperties.Name="Resize files sidebar" />
                    <local:AutomationLandmarkBorder x:Name="ContentPaneBorder"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="ContentPane"
                            AutomationProperties.Name="Editor workspace"
                            Background="{DynamicResource Slate.WindowBackgroundBrush}"
                            DataContext="{Binding Workspace}">
                        <ContentControl Content="{Binding Root}"
                                        ContentTemplate="{StaticResource WorkspaceNodeTemplate}"
                                        GotKeyboardFocus="WorkspaceContent_GotKeyboardFocus"
                                        AutomationProperties.Name="Workspace editor panes" />
                    </local:AutomationLandmarkBorder>
                    <GridSplitter Grid.Column="3"
                                  Background="{DynamicResource Slate.BorderBrush}"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  AutomationProperties.Name="Resize right pane" />
                    <local:AutomationLandmarkBorder Grid.Column="4"
                            AutomationProperties.AutomationId="InspectorPane"
                            AutomationProperties.Name="Inspector"
                            Background="{DynamicResource Slate.SurfaceBrush}"
                            BorderBrush="{DynamicResource Slate.BorderBrush}"
                            BorderThickness="1,0,0,0"
                            DataContext="{Binding Workspace}"
                            Visibility="{Binding IsRightPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <local:AutomationLandmarkBorder.Resources>
                            <!-- Empty/loading sentence: collapses when the bound
                                 message is null (the list has content). -->
                            <Style x:Key="PanelEmptyMessage" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Slate.SecondaryTextBrush}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="0,8,0,8" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="PanelHeading" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
                            </Style>
                            <!-- Rows carry the composed mac label + per-state hint. -->
                            <Style x:Key="PanelRowContainer" TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                            </Style>
                            <Style x:Key="PanelListBox" TargetType="ListBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            </Style>
                            <!-- W4-3: one note-task row — checkbox (pointer
                                 toggle; Space on the row is the keyboard route)
                                 plus text and the optional metadata caption. -->
                            <DataTemplate x:Key="PanelTaskRowTemplate">
                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Completed, Mode=OneWay}"
                                              Focusable="False"
                                              Margin="0,2,6,0"
                                              VerticalAlignment="Top"
                                              Click="PanelTaskCheckbox_Click"
                                              AutomationProperties.Name="{Binding CheckboxLabel}"
                                              AutomationProperties.HelpText="{Binding CheckboxHelpText}" />
                                    <StackPanel>
                                        <local:AutomationPresentationTextBlock x:Name="TaskText"
                                                                               Text="{Binding DisplayText}"
                                                                               TextWrapping="Wrap" />
                                        <local:AutomationPresentationTextBlock x:Name="TaskMetadata"
                                                                               Text="{Binding MetadataCaption}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Completed}" Value="True">
                                        <Setter TargetName="TaskText" Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                        <Setter TargetName="TaskMetadata" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </local:AutomationLandmarkBorder.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <!-- W4-2 (#734): the four link/structure leaves. The
                                 inactive bodies collapse (out of the UIA tree - the
                                 mac accessibilityHidden gating); collections live on
                                 Workspace.Panels, so switching never refetches. -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="backlinks">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding Panels.BacklinksHeader}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.BacklinksEmptyMessage}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.BacklinksTruncationNotice}" />
                                <ListBox x:Name="PanelBacklinksList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Panels.Backlinks}"
                                         ItemContainerStyle="{StaticResource PanelRowContainer}"
                                         MouseDoubleClick="PanelBacklinks_MouseDoubleClick"
                                         PreviewKeyDown="PanelBacklinks_PreviewKeyDown"
                                         ContextMenuOpening="PanelBacklinks_ContextMenuOpening"
                                         AutomationProperties.AutomationId="PanelBacklinksList"
                                         AutomationProperties.Name="Backlinks">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open" Click="PanelBacklinksOpen_Click" />
                                            <MenuItem Header="Open in New Tab" Click="PanelBacklinksOpenNewTab_Click" />
                                            <MenuItem Header="Open in Split" Click="PanelBacklinksOpenSplit_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <local:AutomationPresentationTextBlock Text="{Binding FileName}"
                                                                                       FontWeight="SemiBold" />
                                                <local:AutomationPresentationTextBlock Text="{Binding Snippet}"
                                                                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                                                       TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outgoingLinks">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding Panels.OutgoingLinksHeader}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.OutgoingLinksEmptyMessage}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.OutgoingLinksTruncationNotice}" />
                                <ListBox x:Name="PanelOutgoingLinksList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Panels.OutgoingLinks}"
                                         ItemContainerStyle="{StaticResource PanelRowContainer}"
                                         MouseDoubleClick="PanelOutgoingLinks_MouseDoubleClick"
                                         PreviewKeyDown="PanelOutgoingLinks_PreviewKeyDown"
                                         ContextMenuOpening="PanelOutgoingLinks_ContextMenuOpening"
                                         AutomationProperties.AutomationId="PanelOutgoingLinksList"
                                         AutomationProperties.Name="Outgoing links">
                                    <ListBox.ContextMenu>
                                        <!-- Items are gated per row state in ContextMenuOpening:
                                             internal rows get the tab/split set, external rows the
                                             browser action, unresolved rows no menu at all. -->
                                        <ContextMenu>
                                            <MenuItem Header="Open" Tag="internal" Click="PanelOutgoingLinksOpen_Click" />
                                            <MenuItem Header="Open in New Tab" Tag="internal" Click="PanelOutgoingLinksOpenNewTab_Click" />
                                            <MenuItem Header="Open in Split" Tag="internal" Click="PanelOutgoingLinksOpenSplit_Click" />
                                            <MenuItem Header="Open in Browser" Tag="external" Click="PanelOutgoingLinksOpenBrowser_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:AutomationPresentationTextBlock x:Name="TargetText"
                                                                                           Text="{Binding DisplayTarget}"
                                                                                           FontWeight="SemiBold" />
                                                    <!-- The state chip: the role is folded into the row
                                                         label, so the chip stays out of the UIA name. -->
                                                    <Border x:Name="BadgeChip"
                                                            Margin="6,0,0,0"
                                                            Padding="6,1"
                                                            CornerRadius="4"
                                                            BorderThickness="0.5"
                                                            BorderBrush="{DynamicResource Slate.BorderBrush}">
                                                        <local:AutomationPresentationTextBlock Text="{Binding Badge}"
                                                                                               FontSize="11"
                                                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <local:AutomationPresentationTextBlock x:Name="SnippetText"
                                                                                       Text="{Binding Snippet}"
                                                                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                                                       TextWrapping="Wrap" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUnresolved}" Value="True">
                                                    <Setter TargetName="TargetText" Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter TargetName="TargetText" Property="Foreground" Value="{DynamicResource Slate.WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                    <Setter TargetName="BadgeChip" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasSnippet}" Value="False">
                                                    <Setter TargetName="SnippetText" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outline">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="Outline" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.OutlineEmptyMessage}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.OutlineTruncationNotice}" />
                                <ListBox x:Name="PanelOutlineList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Panels.Outline}"
                                         MouseDoubleClick="PanelOutline_MouseDoubleClick"
                                         PreviewKeyDown="PanelOutline_PreviewKeyDown"
                                         AutomationProperties.AutomationId="PanelOutlineList"
                                         AutomationProperties.Name="Outline">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Border Width="{Binding Indent}" />
                                                <local:AutomationPresentationTextBlock Text="{Binding Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="embeds">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding Panels.EmbedsHeader}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.EmbedsEmptyMessage}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Panels.Embeds}"
                                                  AutomationProperties.AutomationId="PanelEmbedsList"
                                                  AutomationProperties.Name="Embeds">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <!-- G24: the core preview budgets bound the panel's
                                                         resolution; the clip is explicit, never silent. -->
                                                    <TextBlock x:Name="TruncationNotice"
                                                               Text="Preview truncated."
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                    <local:EditorEmbedPreviewView Root="{Binding Node}"
                                                                                  Loaded="PanelEmbedView_Loaded" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Truncated}" Value="False">
                                                        <Setter TargetName="TruncationNotice" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- W4-3 (#735): the note-scoped Tasks leaf — the mac
                                 TasksPanel shape: header with true totals, Open
                                 then Done sections (grouped by the COMPLETED
                                 derivation), checkbox + activation per row. Rows
                                 are display-capped VM-side, so the non-virtualized
                                 sections stay bounded. -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasks">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding Panels.TasksHeader}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.TasksEmptyMessage}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.TasksTruncationNotice}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock x:Name="PanelTasksOpenHeader"
                                                   Text="{Binding Panels.OpenTasksGroupHeader}"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <ListBox x:Name="PanelTasksOpenList"
                                                 Style="{StaticResource PanelListBox}"
                                                 ItemsSource="{Binding Panels.OpenTasks}"
                                                 ItemContainerStyle="{StaticResource PanelRowContainer}"
                                                 ItemTemplate="{StaticResource PanelTaskRowTemplate}"
                                                 MouseDoubleClick="PanelTasks_MouseDoubleClick"
                                                 PreviewKeyDown="PanelTasks_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PanelTasksOpenList"
                                                 AutomationProperties.Name="Open tasks" />
                                        <TextBlock x:Name="PanelTasksDoneHeader"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding Panels.DoneTasksGroupHeader}"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <ListBox x:Name="PanelTasksDoneList"
                                                 Style="{StaticResource PanelListBox}"
                                                 ItemsSource="{Binding Panels.DoneTasks}"
                                                 ItemContainerStyle="{StaticResource PanelRowContainer}"
                                                 ItemTemplate="{StaticResource PanelTaskRowTemplate}"
                                                 MouseDoubleClick="PanelTasks_MouseDoubleClick"
                                                 PreviewKeyDown="PanelTasks_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PanelTasksDoneList"
                                                 AutomationProperties.Name="Done tasks" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- W4-3 (#735): the vault-wide Tasks Review leaf — the
                                 mac TasksReviewPanel flow: pinned filter chips
                                 (focus-then-activate, never commit-on-arrow), a
                                 paged row list, and an explicit Load more row. -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasksReview">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{Binding TasksReview.Header}" />
                                <!-- Radio buttons, not plain buttons (adversarial
                                     round 3): the active filter is a real UIA
                                     selection state with a non-color visual, and
                                     WPF radios keep the mac chip semantics — arrow
                                     keys move focus without committing; Space or
                                     click commits. -->
                                <WrapPanel DockPanel.Dock="Top"
                                           Margin="0,0,0,6"
                                           AutomationProperties.Name="Filter">
                                    <RadioButton x:Name="PanelReviewFilterAll"
                                                 Content="All"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.AllFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.AllFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to all tasks." />
                                    <RadioButton x:Name="PanelReviewFilterDueToday"
                                                 Content="Due today"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.DueTodayFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.DueTodayFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to due today tasks." />
                                    <RadioButton x:Name="PanelReviewFilterOverdue"
                                                 Content="Overdue"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.OverdueFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.OverdueFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to overdue tasks." />
                                    <RadioButton x:Name="PanelReviewFilterThisWeek"
                                                 Content="This week"
                                                 GroupName="PanelReviewFilters"
                                                 IsChecked="{Binding TasksReview.ThisWeekFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.ThisWeekFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to this week tasks." />
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding TasksReview.EmptyMessage}" />
                                <Button x:Name="PanelReviewLoadMore"
                                        DockPanel.Dock="Bottom"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Content="{Binding TasksReview.LoadMoreLabel}"
                                        Click="PanelReviewLoadMore_Click"
                                        Visibility="{Binding TasksReview.HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="{Binding TasksReview.LoadMoreAutomationName}"
                                        AutomationProperties.HelpText="{Binding TasksReview.LoadMoreHelpText}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TasksReview.IsLoadingMore}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ListBox x:Name="PanelReviewList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding TasksReview.Rows}"
                                         ItemContainerStyle="{StaticResource PanelRowContainer}"
                                         MouseDoubleClick="PanelReview_MouseDoubleClick"
                                         PreviewKeyDown="PanelReview_PreviewKeyDown"
                                         AutomationProperties.AutomationId="PanelReviewList"
                                         AutomationProperties.Name="Tasks Review">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Completed, Mode=OneWay}"
                                                          Focusable="False"
                                                          Margin="0,2,6,0"
                                                          VerticalAlignment="Top"
                                                          Click="PanelReviewCheckbox_Click"
                                                          AutomationProperties.Name="{Binding CheckboxLabel}"
                                                          AutomationProperties.HelpText="{Binding CheckboxHelpText}" />
                                                <StackPanel>
                                                    <local:AutomationPresentationTextBlock Text="{Binding FileName}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                    <local:AutomationPresentationTextBlock x:Name="ReviewTaskText"
                                                                                           Text="{Binding DisplayText}"
                                                                                           TextWrapping="Wrap" />
                                                    <local:AutomationPresentationTextBlock x:Name="ReviewTaskMetadata"
                                                                                           Text="{Binding MetadataCaption}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Completed}" Value="True">
                                                    <Setter TargetName="ReviewTaskText" Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                                    <Setter TargetName="ReviewTaskMetadata" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- ==========================================
                                 W4-5 (#737): the citations leaf. Row text
                                 is the core artifact verbatim (contract
                                 1) and an unresolved row is a real state,
                                 not an error (contract 7). Activation
                                 opens the details overlay, which is an
                                 in-window sheet rather than an anchored
                                 popover (D-1).
                                 ========================================== -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="citations">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{x:Static panels:CitationPhrase.CitationsHeading}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.NoFileText}"
                                           Visibility="{Binding Citations.ShowNoFileState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.LoadingVisibleText}"
                                           Visibility="{Binding Citations.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.EmptyText}"
                                           Visibility="{Binding Citations.ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!-- Load notices are surfaced verbatim and
                                     never swallowed (contract 5). -->
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.ErrorSpoken}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Citations.ErrorSpoken, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                                           AutomationProperties.AutomationId="PanelCitationsError" />
                                <ListBox x:Name="PanelCitationsList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Citations.Rows}"
                                         MouseDoubleClick="PanelCitations_MouseDoubleClick"
                                         PreviewKeyDown="PanelCitations_PreviewKeyDown"
                                         AutomationProperties.AutomationId="PanelCitationsList"
                                         AutomationProperties.Name="{x:Static panels:CitationPhrase.CitationsHeading}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <local:AutomationPresentationTextBlock x:Name="CitationBadge"
                                                                                       Text="{Binding UnresolvedBadge}"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource Slate.WarningBrush}" />
                                                <local:AutomationPresentationTextBlock Text="{Binding DisplayText}"
                                                                                       TextWrapping="Wrap" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUnresolved}" Value="False">
                                                    <Setter TargetName="CitationBadge" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- ==========================================
                                 W4-5 (#737): the bibliography leaf. BOTH
                                 segments ride AccessibleDataGrid (contract
                                 8) — including unresolved, which mac
                                 renders as a grouped list (D-6). The grids
                                 are bound in code-behind, as the
                                 bulk-rename preview is; export is null on
                                 both (D-7 / G29).
                                 ========================================== -->
                            <DockPanel Grid.Column="0" Margin="12">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="bibliography">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelHeading}"
                                           Text="{x:Static panels:CitationPhrase.BibliographyHeading}" />
                                <StackPanel DockPanel.Dock="Top"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,6"
                                            AutomationProperties.Name="{x:Static panels:CitationPhrase.BibliographySegmentName}">
                                    <RadioButton x:Name="BibliographyEntriesSegment"
                                                 GroupName="BibliographySegment"
                                                 Margin="0,0,12,0"
                                                 Content="{x:Static panels:CitationPhrase.SegmentEntries}"
                                                 IsChecked="{Binding Bibliography.ShowEntries, Mode=OneWay}"
                                                 Checked="BibliographyEntriesSegment_Checked"
                                                 AutomationProperties.AutomationId="BibliographySegmentEntries" />
                                    <RadioButton x:Name="BibliographyUnresolvedSegment"
                                                 GroupName="BibliographySegment"
                                                 Content="{x:Static panels:CitationPhrase.SegmentUnresolved}"
                                                 IsChecked="{Binding Bibliography.ShowUnresolved, Mode=OneWay}"
                                                 Checked="BibliographyUnresolvedSegment_Checked"
                                                 AutomationProperties.AutomationId="BibliographySegmentUnresolved" />
                                </StackPanel>
                                <TextBox x:Name="BibliographySearchBox"
                                         DockPanel.Dock="Top"
                                         Margin="0,0,0,6"
                                         Text="{Binding Bibliography.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding Bibliography.ShowEntries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.AutomationId="BibliographySearch"
                                         AutomationProperties.Name="{x:Static panels:CitationPhrase.BibliographySearchName}"
                                         AutomationProperties.HelpText="{x:Static panels:CitationPhrase.BibliographySearchHelp}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.BibliographyLoading}"
                                           Visibility="{Binding Bibliography.IsLoadingEntries, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.BibliographyNoSources}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowNoSourcesState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           AutomationProperties.AutomationId="BibliographyNoSources" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Bibliography.NoFilterHitsText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowNoFilterHitsState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.UnresolvedEmpty}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowUnresolvedEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!-- Notices verbatim, per segment (contract 5). -->
                                <ItemsControl DockPanel.Dock="Bottom"
                                              ItemsSource="{Binding Bibliography.LoadNotices}"
                                              AutomationProperties.AutomationId="BibliographyNotices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource PanelEmptyMessage}"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Both grids share the fill cell; exactly
                                     one is visible, so the other leaves the
                                     UIA tree entirely rather than sitting
                                     behind it. -->
                                <Grid>
                                    <grids:AccessibleDataGrid x:Name="BibliographyEntriesGrid"
                                                              GridAutomationId="BibliographyEntries"
                                                              Visibility="{Binding Bibliography.ShowEntries, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <grids:AccessibleDataGrid x:Name="BibliographyUnresolvedGrid"
                                                              GridAutomationId="BibliographyUnresolved"
                                                              Visibility="{Binding Bibliography.ShowUnresolved, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DockPanel>
                            <StackPanel Grid.Column="0" Margin="12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="citations">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="bibliography">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="backlinks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outgoingLinks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outline">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="embeds">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasksReview">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding ActiveLeaf.Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="This panel is docked and ready for its feature surface."
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ListBox x:Name="RightPaneLeavesList"
                                     Grid.Column="1"
                                     ItemsSource="{Binding LeafOptions}"
                                     SelectedItem="{Binding ActiveLeaf, Mode=TwoWay}"
                                     DisplayMemberPath="Title"
                                     VirtualizingStackPanel.IsVirtualizing="False"
                                     AutomationProperties.AutomationId="RightPaneLeaves"
                                     AutomationProperties.Name="Right pane panels">
                                <!-- Explicit names: content-derived ListItem names
                                     are not composed on all sessions (the Quick
                                     Open row precedent), and a rail entry an AT
                                     cannot name is unusable. -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </local:AutomationLandmarkBorder>
                </Grid>
            </local:AutomationLandmarkGrid>
            <!-- A full-window hit-test layer makes Quick Open modal for pointer
                 input. The underlying shell is disabled above, so UIA clients
                 cannot invoke commands behind the visible overlay either. -->
            <Border Background="Transparent"
                    Visibility="{Binding QuickSwitcher.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <local:AutomationLandmarkBorder x:Name="QuickSwitcherOverlay"
                    Width="600"
                    MaxHeight="430"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,72,0,0"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.QuickSwitcher.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                    DataContext="{Binding QuickSwitcher}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="QuickSwitcher"
                    AutomationProperties.Name="Quick Open"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickSwitcherSearchTextBox"
                                 Grid.Column="0"
                                 Padding="10,8"
                                 FontSize="18"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 PreviewKeyDown="QuickSwitcherSearch_PreviewKeyDown"
                                 AutomationProperties.AutomationId="QuickSwitcherSearch"
                                 AutomationProperties.Name="Search files"
                                 AutomationProperties.HelpText="Up and Down move selection. Enter opens. Control Enter opens a new tab. Control Alt Enter opens a split. Escape closes Quick Open." />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Close"
                                Command="{Binding DismissCommand}"
                                Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="QuickSwitcherClose"
                                AutomationProperties.Name="Close Quick Open" />
                    </Grid>
                    <!-- ResultSummary describes the collection, so expose it once on
                         the list rather than repeating it on every result row. -->
                    <local:AutomationVisibilityListBox x:Name="QuickSwitcherResultsList"
                             Grid.Row="1"
                             Margin="0,8"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                             MouseDoubleClick="QuickSwitcherResults_MouseDoubleClick"
                             AutomationProperties.AutomationId="QuickSwitcherResults"
                             AutomationProperties.Name="Quick Open results"
                             AutomationProperties.ItemStatus="{Binding ResultSummary}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Path}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:AutomationPresentationTextBlock Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold" />
                                    <local:AutomationPresentationTextBlock Grid.Column="1"
                                                                           Text="{Binding Path}"
                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </local:AutomationVisibilityListBox>
                    <DockPanel Grid.Row="2">
                        <local:AutomationPresentationTextBlock Text="{Binding ResultSummary}"
                                                               Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        <local:AutomationPresentationTextBlock DockPanel.Dock="Right"
                                                               Text="Enter open · Ctrl+Enter tab · Ctrl+Alt+Enter split · Esc close"
                                                               Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                    </DockPanel>
                </Grid>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W4-4 (#736): the add-property sheet. Focus lands on the
                 Key field at open; Enter = Add, Esc = Cancel (code-behind
                 PreviewKeyDown — no window-global default button).
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.AddPropertySheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="AddPropertyOverlay"
                    Width="460"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.AddPropertySheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.AddPropertySheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="AddPropertyOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="AddPropertySheet"
                    AutomationProperties.Name="Add property"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <StackPanel>
                    <TextBlock Text="Add property"
                               FontSize="16"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <local:AutomationPresentationTextBlock Margin="0,10,0,2" Text="Property key" />
                    <TextBox x:Name="AddPropertyKeyTextBox"
                             Padding="6,4"
                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AddPropertyKey"
                             AutomationProperties.Name="Property key" />
                    <local:AutomationPresentationTextBlock Margin="0,8,0,2" Text="Property type" />
                    <ComboBox ItemsSource="{x:Static panels:AddPropertyViewModel.Kinds}"
                              SelectedItem="{Binding Kind}"
                              AutomationProperties.AutomationId="AddPropertyType"
                              AutomationProperties.Name="Property type" />
                    <!-- Round 3: shape-derived kinds need a shape-valid
                         seed — core classifies stored values by shape,
                         so the chosen type must survive the re-read. -->
                    <local:AutomationPresentationTextBlock Margin="0,8,0,2" Text="Initial value" />
                    <TextBox Padding="6,4"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AddPropertyValue"
                             AutomationProperties.Name="Initial value" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding ValidationError}"
                               Foreground="{DynamicResource Slate.WarningBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}" />
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Padding="10,4"
                                Content="Add"
                                Click="AddPropertyAdd_Click"
                                AutomationProperties.AutomationId="AddPropertyConfirm"
                                AutomationProperties.HelpText="Add this property to the note." />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Cancel"
                                Command="{Binding DataContext.Workspace.CloseAddPropertySheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="AddPropertyCancel" />
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkBorder>
            <!-- ==========================================================
                 W4-4 (#736): the bulk-rename sheet. Default action is
                 PREVIEW, never Apply; Apply arms only after a preview on
                 the exact key pair (any key edit disarms it); Esc cancels
                 in-flight core work through the CancelToken and closes.
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.BulkRenameSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="BulkRenameOverlay"
                    Width="760"
                    MaxHeight="560"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.BulkRenameSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.BulkRenameSheet}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="BulkRenameOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="BulkRenameSheet"
                    AutomationProperties.Name="Rename property across the vault"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Rename property across the vault"
                               FontSize="16"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <local:AutomationPresentationTextBlock Margin="0,0,0,2" Text="Old property key" />
                            <TextBox x:Name="BulkRenameOldKeyTextBox"
                                     Padding="6,4"
                                     Text="{Binding OldKey, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="BulkRenameOldKey"
                                     AutomationProperties.Name="Old property key" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <local:AutomationPresentationTextBlock Margin="0,0,0,2" Text="New property key" />
                            <TextBox Padding="6,4"
                                     Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="BulkRenameNewKey"
                                     AutomationProperties.Name="New property key" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                   Visibility="{Binding ProgressText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ErrorText}"
                                   Foreground="{DynamicResource Slate.WarningBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3"
                               Margin="0,12"
                               Text="{Binding EmptyStateText}"
                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.Name="{Binding EmptyStateText}" />
                    <grids:AccessibleDataGrid x:Name="BulkRenamePreviewGrid"
                                              Grid.Row="3"
                                              Margin="0,8"
                                              MinHeight="120"
                                              Visibility="{Binding ShowEmptyState, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding FooterText}"
                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                               AutomationProperties.AutomationId="BulkRenameFooter" />
                    <StackPanel Grid.Row="5"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Padding="10,4"
                                Content="Preview"
                                Click="BulkRenamePreview_Click"
                                IsEnabled="{Binding CanPreview}"
                                AutomationProperties.AutomationId="BulkRenamePreviewButton" />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Apply"
                                Click="BulkRenameApply_Click"
                                IsEnabled="{Binding CanApply}"
                                AutomationProperties.AutomationId="BulkRenameApplyButton"
                                AutomationProperties.HelpText="Apply the previewed property rename across the vault." />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Close"
                                Command="{Binding DataContext.Workspace.CloseBulkRenameSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="BulkRenameClose" />
                    </StackPanel>
                </Grid>
            </local:AutomationLandmarkBorder>

            <!-- ==========================================================
                 W4-5 (#737): the citation details overlay. D-1 — mac
                 anchors a popover to the row; a WPF Popup lives in a
                 separate HWND whose UIA subtree is a sibling window, so
                 this is the in-window sheet instead. The focus-return
                 contract (WCAG 2.4.3 / 2.1.2) is preserved verbatim:
                 Escape returns focus to the row that opened it
                 (contract 11).
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.CitationDetails, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="CitationDetailsOverlay"
                    Width="460"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.CitationDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CitationDetails}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="CitationDetailsOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="CitationDetailsSheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <StackPanel>
                    <!-- An unresolved key is a real state, not an error
                         (contract 7): the sheet says so plainly rather
                         than showing empty fields. -->
                    <StackPanel Visibility="{Binding IsUnresolved, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding UnresolvedHeading}"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding UnresolvedBody}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Absent values never produce a row (contract 10):
                         Fields carries only what is present. -->
                    <ItemsControl ItemsSource="{Binding Fields}"
                                  Visibility="{Binding IsUnresolved, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  AutomationProperties.AutomationId="CitationDetailsFields">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                    <local:AutomationPresentationTextBlock Text="{Binding Label}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                    <local:AutomationPresentationTextBlock Text="{Binding Value}"
                                                                           TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding AbstractText}"
                               TextWrapping="Wrap"
                               MaxHeight="160"
                               Visibility="{Binding HasAbstract, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.AutomationId="CitationDetailsAbstract"
                               AutomationProperties.Name="{Binding AbstractAutomationName}" />
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="CitationDetailsCloseButton"
                                Padding="10,4"
                                Content="{Binding CloseText}"
                                Command="{Binding DataContext.Workspace.CloseCitationDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="CitationDetailsClose"
                                AutomationProperties.HelpText="{Binding CloseHelp}" />
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkBorder>

            <!-- ==========================================================
                 W4-5 (#737): the citation summary sheet (Ctrl+Shift+J).
                 Counts come from the leaf's already-published rows, so
                 the sheet can never disagree with the panel behind it
                 (contract 12).
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.CitationSummary, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="CitationSummaryOverlay"
                    Width="420"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.CitationSummary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CitationSummary}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="CitationSummaryOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="CitationSummarySheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Heading}"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding Body}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="CitationSummaryWalkButton"
                                Padding="10,4"
                                Content="{Binding WalkActionText}"
                                IsEnabled="{Binding CanWalkThrough}"
                                Click="CitationSummaryWalk_Click"
                                AutomationProperties.AutomationId="CitationSummaryWalk"
                                AutomationProperties.HelpText="{Binding WalkActionHelp}" />
                        <Button x:Name="CitationSummaryDismissButton"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Content="{Binding DismissText}"
                                Command="{Binding DataContext.Workspace.CloseCitationSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="CitationSummaryDismiss"
                                AutomationProperties.HelpText="{Binding DismissHelp}" />
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkBorder>

            <!-- ==========================================================
                 W4-5 (#737): files citing this entry, opened from a
                 bibliography row action.
                 ========================================================== -->
            <Border Background="Transparent"
                    Visibility="{Binding Workspace.FilesCiting, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <local:AutomationLandmarkBorder x:Name="FilesCitingOverlay"
                    Width="460"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.Workspace.FilesCiting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.FilesCiting}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="FilesCitingOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="FilesCitingSheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <local:AutomationLandmarkBorder.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                </local:AutomationLandmarkBorder.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Heading}"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding EmptyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ListBox x:Name="FilesCitingList"
                             Margin="0,6,0,0"
                             MaxHeight="260"
                             ItemsSource="{Binding Paths}"
                             AutomationProperties.AutomationId="FilesCitingList"
                             AutomationProperties.Name="{Binding Heading}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="FilesCitingCloseButton"
                                Padding="10,4"
                                Content="{x:Static panels:CitationPhrase.DetailsClose}"
                                Command="{Binding DataContext.Workspace.CloseFilesCitingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="FilesCitingClose" />
                    </StackPanel>
                </StackPanel>
            </local:AutomationLandmarkBorder>
        </Grid>
    </DockPanel>
</Window>
