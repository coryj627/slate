                                           Focusable="{Binding Panels.TasksNoticeIsAStop}"
                                           AutomationProperties.AutomationId="PanelTasksNotice" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Panels.TasksTruncationNotice}" />
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock x:Name="PanelTasksOpenHeader"
                                                   Text="{Binding Panels.OpenTasksGroupHeader}"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <ListBox x:Name="PanelTasksOpenList"
                                                 Style="{StaticResource PanelListBox}"
                                                 ItemsSource="{Binding Panels.OpenTasks}"
                                                 ItemContainerStyle="{StaticResource PanelRowContainer}"
                                                 ItemTemplate="{StaticResource PanelTaskRowTemplate}"
                                                 MouseDoubleClick="PanelTasks_MouseDoubleClick"
                                                 PreviewKeyDown="PanelTasks_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PanelTasksOpenList" local:SiblingNames.NamePath="AutomationName" local:SiblingNames.Noun="task"
                                                 AutomationProperties.Name="Open tasks" />
                                        <TextBlock x:Name="PanelTasksDoneHeader"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding Panels.DoneTasksGroupHeader}"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <ListBox x:Name="PanelTasksDoneList"
                                                 Style="{StaticResource PanelListBox}"
                                                 ItemsSource="{Binding Panels.DoneTasks}"
                                                 ItemContainerStyle="{StaticResource PanelRowContainer}"
                                                 ItemTemplate="{StaticResource PanelTaskRowTemplate}"
                                                 MouseDoubleClick="PanelTasks_MouseDoubleClick"
                                                 PreviewKeyDown="PanelTasks_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PanelTasksDoneList" local:SiblingNames.NamePath="AutomationName" local:SiblingNames.Noun="task"
                                                 AutomationProperties.Name="Done tasks" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- W4-3 (#735): the vault-wide Tasks Review leaf — the
                                 mac TasksReviewPanel flow: pinned filter chips, a
                                 paged row list, and an explicit Load more row. -->
                            <DockPanel x:Name="TasksReviewLeafBody" Grid.Column="0" Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasksReview">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <local:PanelToolbarView DockPanel.Dock="Top" Title="{Binding TasksReview.Header}" />
                                <!-- Radio buttons, not plain buttons (adversarial
                                     round 3): the active filter is a real UIA
                                     selection state with a non-color visual.
                                     W7-7 PR 4 (#1247, R-5): and a Windows radio
                                     group — an arrow checks the filter it moves
                                     to (RadioGroupArrows), where WPF's radios
                                     moved focus alone and Down from "All" walked
                                     into the menu bar (NVDA pass F4); Cycle keeps
                                     every other arrow inside the group, and the
                                     group is ONE Tab stop (Once), as the canvas
                                     and graph switchers are: Tab visited all four
                                     filters. The group is a named UIA Group, which a
                                     plain WrapPanel is not (G22). -->
                                <local:AutomationNamedWrapPanel DockPanel.Dock="Top"
                                           Margin="0,0,0,6"
                                           KeyboardNavigation.TabNavigation="Once"
                                           KeyboardNavigation.DirectionalNavigation="Cycle"
                                           local:RadioGroupArrows.IsEnabled="True"
                                           AutomationProperties.AutomationId="PanelReviewFilters"
                                           AutomationProperties.Name="Filter">
                                    <RadioButton x:Name="PanelReviewFilterAll"
                                                 Content="All"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.AllFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.AllFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to all tasks." />
                                    <RadioButton x:Name="PanelReviewFilterDueToday"
                                                 Content="Due today"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.DueTodayFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.DueTodayFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to due today tasks." />
                                    <RadioButton x:Name="PanelReviewFilterOverdue"
                                                 Content="Overdue"
                                                 GroupName="PanelReviewFilters"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding TasksReview.OverdueFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.OverdueFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to overdue tasks." />
                                    <RadioButton x:Name="PanelReviewFilterThisWeek"
                                                 Content="This week"
                                                 GroupName="PanelReviewFilters"
                                                 IsChecked="{Binding TasksReview.ThisWeekFilterActive, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding TasksReview.ThisWeekFilterName}"
                                                 AutomationProperties.HelpText="Filter the review to this week tasks." />
                                </local:AutomationNamedWrapPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding TasksReview.EmptyMessage}" />
                                <Button x:Name="PanelReviewLoadMore"
                                        DockPanel.Dock="Bottom"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Content="{Binding TasksReview.LoadMoreLabel}"
                                        Click="PanelReviewLoadMore_Click"
                                        Visibility="{Binding TasksReview.HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="{Binding TasksReview.LoadMoreAutomationName}"
                                        AutomationProperties.HelpText="{Binding TasksReview.LoadMoreHelpText}" />
                                <!-- W7-7 PR 4b (#1247, R-5; the sweep's G4): never
                                     disabled under the keys. A trigger disabled the
                                     focused button while a page loaded, and WPF
                                     handed its keys to the window; LoadMore refuses
                                     while loading, and the name says "Loading more
                                     tasks". The last page collapses it, and its keys
                                     go to the first row that page appended
                                     (MainWindow.LandAfterLoadMore). -->
                                <ListBox x:Name="PanelReviewList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding TasksReview.Rows}"
                                         ItemContainerStyle="{StaticResource PanelRowContainer}"
                                         MouseDoubleClick="PanelReview_MouseDoubleClick"
                                         PreviewKeyDown="PanelReview_PreviewKeyDown"
                                         AutomationProperties.AutomationId="PanelReviewList" local:SiblingNames.NamePath="AutomationName" local:SiblingNames.DistinguisherPath="Path" local:SiblingNames.Noun="task"
                                         AutomationProperties.Name="Tasks Review">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Completed, Mode=OneWay}"
                                                          Focusable="False"
                                                          Margin="0,2,6,0"
                                                          VerticalAlignment="Top"
                                                          Click="PanelReviewCheckbox_Click"
                                                          AutomationProperties.Name="{Binding CheckboxLabel}"
                                                          AutomationProperties.HelpText="{Binding CheckboxHelpText}" />
                                                <StackPanel Grid.Column="1">
                                                    <local:AutomationPresentationTextBlock Text="{Binding FileName}"
                                                                                           Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                    <local:AutomationPresentationTextBlock x:Name="ReviewTaskText"
                                                                                           Text="{Binding DisplayText}"
                                                                                           TextWrapping="Wrap" />
                                                    <local:AutomationPresentationTextBlock x:Name="ReviewTaskMetadata"
                                                                                           Text="{Binding MetadataCaption}"
                                                                                           Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                                                                           TextWrapping="Wrap"
                                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Completed}" Value="True">
                                                    <Setter TargetName="ReviewTaskText" Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                                    <Setter TargetName="ReviewTaskMetadata" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- ==========================================
                                 W4-5 (#737): the citations leaf. Row text
                                 is the core artifact verbatim (contract
                                 1) and an unresolved row is a real state,
                                 not an error (contract 7). Activation
                                 opens the details overlay, which is an
                                 in-window sheet rather than an anchored
                                 popover (D-1).
                                 ========================================== -->
                            <!-- W7-7 PR 4 (#1247, R-5; codex round 4): the leaf
                                 contains its arrows - an arrow from its notice, whose
                                 own group this body is, stays in the leaf. -->
                            <DockPanel x:Name="CitationsLeafBody" Grid.Column="0" Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="citations">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <local:PanelToolbarView DockPanel.Dock="Top" Title="{x:Static panels:CitationPhrase.CitationsHeading}" Count="{Binding Citations.Rows.Count}" />
                                <!-- W7-7 PR 4 (#1247, R-5; spec §5.2.2): an EMPTY list's
                                     stop is its notice — the no-file and no-citations
                                     sentences take the keys and read their reason
                                     (their text is their name), where the bare empty
                                     list said only "Citations, list". Loading stays a
                                     decoration: it collapses under the keys within
                                     moments. The ring reaches them as the leaf's first
                                     stop; the restores through SelectorFocus. -->
                                <TextBlock x:Name="PanelCitationsNoFile"
                                           DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.NoFileText}"
                                           Visibility="{Binding Citations.ShowNoFileState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Focusable="True"
                                           AutomationProperties.AutomationId="PanelCitationsNoFile" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.LoadingVisibleText}"
                                           Visibility="{Binding Citations.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock x:Name="PanelCitationsEmpty"
                                           DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.EmptyText}"
                                           Visibility="{Binding Citations.ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Focusable="True"
                                           AutomationProperties.AutomationId="PanelCitationsEmpty" />
                                <!-- Load notices are surfaced verbatim and
                                     never swallowed (contract 5). -->
                                <TextBlock x:Name="PanelCitationsError"
                                           DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Citations.ErrorSpoken}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Citations.ErrorSpoken, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                                           Focusable="True"
                                           AutomationProperties.AutomationId="PanelCitationsError" />
                                <ListBox x:Name="PanelCitationsList"
                                         Style="{StaticResource PanelListBox}"
                                         ItemsSource="{Binding Citations.Rows}"
                                         SelectionChanged="PanelCitations_SelectionChanged"
                                         MouseDoubleClick="PanelCitations_MouseDoubleClick"
                                         PreviewKeyDown="PanelCitations_PreviewKeyDown"
                                         AutomationProperties.AutomationId="PanelCitationsList" local:SiblingNames.NamePath="AutomationName" local:SiblingNames.Noun="citation"
                                         AutomationProperties.Name="{x:Static panels:CitationPhrase.CitationsHeading}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <local:AutomationPresentationTextBlock x:Name="CitationBadge"
                                                                                       Text="{Binding UnresolvedBadge}"
                                                                                       Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                                                                       Foreground="{DynamicResource Slate.WarningBrush}" />
                                                <local:AutomationPresentationTextBlock Text="{Binding DisplayText}"
                                                                                       TextWrapping="Wrap" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUnresolved}" Value="False">
                                                    <Setter TargetName="CitationBadge" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- ==========================================
                                 W4-5 (#737): the bibliography leaf. BOTH
                                 segments ride AccessibleDataGrid (contract
                                 8) — including unresolved, which mac
                                 renders as a grouped list (D-6). The grids
                                 are bound in code-behind, as the
                                 bulk-rename preview is; export is null on
                                 both (D-7 / G29).
                                 ========================================== -->
                            <DockPanel x:Name="BibliographyLeafBody" Grid.Column="0" Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="bibliography">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <local:PanelToolbarView DockPanel.Dock="Top" Title="{x:Static panels:CitationPhrase.BibliographyHeading}" />
                                <!-- The group name lives on a
                                     landmark border, not on the
                                     StackPanel: a Panel gets no
                                     automation peer, so the name was
                                     dropped and the two radio buttons
                                     were announced with nothing tying
                                     them to the bibliography. -->
                                <local:AutomationLandmarkBorder DockPanel.Dock="Top"
                                        BorderThickness="0"
                                        Margin="0,0,0,6"
                                        AutomationProperties.AutomationId="BibliographySegmentGroup"
                                        AutomationProperties.Name="{x:Static panels:CitationPhrase.BibliographySegmentName}">
                                <!-- W7-7 PR 4 (#1247, R-5; the owner's S2, the sweep's G2):
                                     a Windows radio group — an arrow checks the segment
                                     it reaches (it moved focus alone, and the Entries
                                     grid stayed on screen), Cycle keeps every other
                                     arrow in the group, one Tab stop, the checked
                                     segment its stop. -->
                                <WrapPanel Orientation="Horizontal"
                                            KeyboardNavigation.TabNavigation="Once"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            local:RadioGroupArrows.IsEnabled="True">
                                    <RadioButton x:Name="BibliographyEntriesSegment"
                                                 GroupName="BibliographySegment"
                                                 Margin="0,0,12,0"
                                                 Content="{x:Static panels:CitationPhrase.SegmentEntries}"
                                                 IsChecked="{Binding Bibliography.ShowEntries, Mode=OneWay}"
                                                 Checked="BibliographyEntriesSegment_Checked"
                                                 AutomationProperties.AutomationId="BibliographySegmentEntries" />
                                    <RadioButton x:Name="BibliographyUnresolvedSegment"
                                                 GroupName="BibliographySegment"
                                                 Content="{x:Static panels:CitationPhrase.SegmentUnresolved}"
                                                 IsChecked="{Binding Bibliography.ShowUnresolved, Mode=OneWay}"
                                                 Checked="BibliographyUnresolvedSegment_Checked"
                                                 AutomationProperties.AutomationId="BibliographySegmentUnresolved" />
                                </WrapPanel>
                                </local:AutomationLandmarkBorder>
                                <TextBox x:Name="BibliographySearchBox" local:FieldPrompt.IsEnabled="True" local:SearchGlyph.IsEnabled="True"
                                         DockPanel.Dock="Top"
                                         Margin="0,0,0,6"
                                         Text="{Binding Bibliography.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding Bibliography.ShowEntries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.AutomationId="BibliographySearch"
                                         AutomationProperties.Name="{x:Static panels:CitationPhrase.BibliographySearchName}"
                                         AutomationProperties.HelpText="{x:Static panels:CitationPhrase.BibliographySearchHelp}" />
                                <!-- Every line below is SEGMENT-SCOPED in
                                     the view model; binding the raw
                                     loading/empty flags let each one
                                     render over the other segment's
                                     grid. -->
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.BibliographyLoading}"
                                           Visibility="{Binding Bibliography.ShowEntriesLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.UnresolvedLoading}"
                                           Visibility="{Binding Bibliography.ShowUnresolvedLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!-- The read-failure surface. Without
                                     these two the grid simply summarised
                                     "0 entries" and the reason was never
                                     spoken at all (contract 5). -->
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Bibliography.EntriesErrorSpoken}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowEntriesError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Focusable="True"
                                           AutomationProperties.AutomationId="BibliographyEntriesError" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Bibliography.UnresolvedErrorSpoken}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowUnresolvedError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Focusable="True"
                                           AutomationProperties.AutomationId="BibliographyUnresolvedError" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.BibliographyNoSources}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowNoSourcesState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           AutomationProperties.AutomationId="BibliographyNoSources" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{Binding Bibliography.NoFilterHitsText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowNoFilterHitsState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource PanelEmptyMessage}"
                                           Text="{x:Static panels:CitationPhrase.UnresolvedEmpty}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Bibliography.ShowUnresolvedEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!-- Notices verbatim, per segment (contract 5). Each
                                     notice's focusable text is the stop, so its
                                     container is layout (R-4, #1246). -->
                                <local:LayoutItemsControl DockPanel.Dock="Bottom"
                                                          Focusable="False"
                                                          ItemsSource="{Binding Bibliography.LoadNotices, Converter={x:Static local:SiblingText.Rows}}"
                                                          AutomationProperties.AutomationId="BibliographyNotices" local:SiblingNames.NamePath="Text" local:SiblingNames.Noun="notice">
                                    <!-- With no notices this renders at
                                         zero size but stays on-screen in
                                         the UIA tree, which axe flags as
                                         a null bounding rectangle. An
                                         empty notice region should leave
                                         the tree, as the inactive leaf
                                         bodies above do. -->
                                    <local:LayoutItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bibliography.LoadNotices.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:LayoutItemsControl.Style>
                                    <local:LayoutItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                        </Style>
                                    </local:LayoutItemsControl.ItemContainerStyle>
                                    <local:LayoutItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource PanelEmptyMessage}"
                                                       Focusable="True"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                        </DataTemplate>
                                    </local:LayoutItemsControl.ItemTemplate>
                                </local:LayoutItemsControl>
                                <!-- Both grids share the fill cell; exactly
                                     one is visible, so the other leaves the
                                     UIA tree entirely rather than sitting
                                     behind it. -->
                                <Grid>
                                    <grids:AccessibleDataGrid x:Name="BibliographyEntriesGrid"
                                                              GridAutomationId="BibliographyEntries"
                                                              Visibility="{Binding Bibliography.ShowEntries, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <grids:AccessibleDataGrid x:Name="BibliographyUnresolvedGrid"
                                                              GridAutomationId="BibliographyUnresolved"
                                                              Visibility="{Binding Bibliography.ShowUnresolved, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DockPanel>
                            <!-- W4-6 (#738): the Queries leaf — the mac
                                 BaseQueriesPanel twin. Saved queries,
                                 base files, dashboards; buttons act on
                                 the selection (AT-reachable, one route
                                 per action shared with the commands). -->
                            <DockPanel Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained"
                                       AutomationProperties.AutomationId="QueriesLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="queries">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <local:PanelToolbarView DockPanel.Dock="Top" Title="Queries">
                                    <Button Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                            Content="&#xE710;"
                                            AutomationProperties.AutomationId="QueriesNewDashboard"
                                            AutomationProperties.Name="New dashboard"
                                            Click="QueriesNewDashboard_Click" />
                                    <Button Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                            Content="&#xE72C;"
                                            AutomationProperties.AutomationId="QueriesRefresh"
                                            AutomationProperties.Name="Refresh queries"
                                            Click="QueriesRefresh_Click" />
                                </local:PanelToolbarView>
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                    <!-- #1790: the scroll bar draws over its content, so nothing sits under it. -->
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Margin="0,8,0,2" Text="SAVED QUERIES" Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                        <TextBlock Text="No saved queries"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SavedQueries.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox x:Name="QueriesSavedList"
                                                 MaxHeight="200"
                                                 ItemsSource="{Binding SavedQueries}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MouseDoubleClick="QueriesSavedList_DoubleClick"
                                                 AutomationProperties.AutomationId="QueriesSavedList" local:SiblingNames.NamePath="Name" local:SiblingNames.Noun="query"
                                                 AutomationProperties.Name="Saved queries">
                                            <!-- #1790: a long row wraps, rather than running under the leaf's scroll bar. -->
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <!-- R-4 (#1246): the template draws the text only;
                                                 the container read the saved query record dump. -->
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource Slate.PanelListBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SavedQueries.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                        </ListBox>
                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <WrapPanel.Resources>
                                                <!-- Selection-scoped actions disable without a
                                                     selection instead of clicking into silence
                                                     (red team round 1). -->
                                                <Style TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=QueriesSavedList}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button Margin="0,0,4,4" Content="Run" AutomationProperties.Name="Run saved query" AutomationProperties.AutomationId="QueriesRun" Click="QueriesRun_Click" />
                                            <Button Content="Pin/Unpin" Margin="0,0,4,4" AutomationProperties.Name="Pin or unpin saved query" AutomationProperties.AutomationId="QueriesPin" Click="QueriesPin_Click" />
                                            <Button Content="Edit in Builder" Margin="0,0,4,4" AutomationProperties.Name="Edit saved query in builder" AutomationProperties.AutomationId="QueriesEditInBuilder" Click="QueriesEditInBuilder_Click" />
                                            <Button Content="Rename…" Margin="0,0,4,4" AutomationProperties.Name="Rename saved query" AutomationProperties.AutomationId="QueriesRename" Click="QueriesRename_Click" />
                                            <Button Content="Export as .base…" Margin="0,0,4,4" AutomationProperties.Name="Export saved query as base file" AutomationProperties.AutomationId="QueriesExport" Click="QueriesExport_Click" />
                                            <Button Content="Dock" Margin="0,0,4,4" AutomationProperties.Name="Dock saved query" AutomationProperties.AutomationId="QueriesDockQuery" Click="QueriesDockQuery_Click" />
                                            <Button Content="Delete…" Margin="0,0,4,4" AutomationProperties.Name="Delete saved query" AutomationProperties.AutomationId="QueriesDelete" Click="QueriesDelete_Click" />
                                        </WrapPanel>
                                        <DockPanel x:Name="QueriesRenameRow" Visibility="Collapsed" Margin="0,4,0,0">
                                            <TextBlock Text="New name:" VerticalAlignment="Center" />
                                            <TextBox x:Name="QueriesRenameBox" local:FieldPrompt.IsEnabled="True"
                                                     Margin="6,0,0,0"
                                                     MinWidth="180"
                                                     KeyDown="QueriesRenameBox_KeyDown"
                                                     AutomationProperties.AutomationId="QueriesRenameBox"
                                                     AutomationProperties.Name="New saved query name" />
                                        </DockPanel>
                                        <TextBlock Margin="0,12,0,2" Text="BASE FILES" Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                        <TextBlock Text="No base files"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BaseFiles.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox x:Name="QueriesBaseFilesList"
                                                 MaxHeight="160"
                                                 ItemsSource="{Binding BaseFiles}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MouseDoubleClick="QueriesBaseFilesList_DoubleClick"
                                                 AutomationProperties.AutomationId="QueriesBaseFilesList"
                                                 AutomationProperties.Name="Base files">
                                            <!-- #1790: a long row wraps, rather than running under the leaf's scroll bar. -->
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <!-- R-4 (#1246): the template draws the text only;
                                                 the container read the base file record dump. -->
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource Slate.PanelListBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BaseFiles.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                        </ListBox>
                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <WrapPanel.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=QueriesBaseFilesList}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button Margin="0,0,4,4" Content="Open" AutomationProperties.Name="Open base file" AutomationProperties.AutomationId="QueriesOpenBaseFile" Click="QueriesOpenBaseFile_Click" />
                                            <Button Content="Dock" Margin="0,0,4,4" AutomationProperties.Name="Dock base file" AutomationProperties.AutomationId="QueriesDockBaseFile" Click="QueriesDockBaseFile_Click" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,12,0,2" Text="DASHBOARDS" Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                        <TextBlock Text="No dashboards"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboards.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox x:Name="QueriesDashboardsList"
                                                 MaxHeight="160"
                                                 ItemsSource="{Binding Dashboards}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MouseDoubleClick="QueriesDashboardsList_DoubleClick"
                                                 AutomationProperties.AutomationId="QueriesDashboardsList" local:SiblingNames.NamePath="Name" local:SiblingNames.Noun="dashboard"
                                                 AutomationProperties.Name="Dashboards">
                                            <!-- #1790: a long row wraps, rather than running under the leaf's scroll bar. -->
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <!-- R-4 (#1246): the template draws the text only;
                                                 the container read the dashboard record dump. -->
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource Slate.PanelListBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboards.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                        </ListBox>
                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <WrapPanel.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=QueriesDashboardsList}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button Margin="0,0,4,4" Content="Open" AutomationProperties.Name="Open dashboard" AutomationProperties.AutomationId="QueriesOpenDashboard" Click="QueriesOpenDashboard_Click" />
                                            <Button Content="Edit…" Margin="0,0,4,4" AutomationProperties.Name="Edit dashboard" AutomationProperties.AutomationId="QueriesEditDashboard" Click="QueriesEditDashboard_Click" />
                                            <Button Content="Dock" Margin="0,0,4,4" AutomationProperties.Name="Dock dashboard" AutomationProperties.AutomationId="QueriesDockDashboard" Click="QueriesDockDashboard_Click" />
                                            <Button Content="Delete…" Margin="0,0,4,4" AutomationProperties.Name="Delete dashboard" AutomationProperties.AutomationId="QueriesDeleteDashboard" Click="QueriesDeleteDashboard_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- W4-6 (#738): the Base dock leaf — one
                                 docked target following the active note,
                                 read-only. -->
                            <DockPanel Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained"
                                       AutomationProperties.AutomationId="BasesDockLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="basesDock">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <local:PanelToolbarView DockPanel.Dock="Top" Title="Base dock" />
                                <TextBlock x:Name="BasesDockEmptyState"
                                           DockPanel.Dock="Top"
                                           Text="Dock a base, saved query, or dashboard to follow the active note."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           AutomationProperties.AutomationId="BasesDockEmptyState">
                                    <TextBlock.Style>
                                        <!-- Visible only while NOTHING is docked
                                             (red team round 1: it stayed up over
                                             docked content). -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding BasesDockDocument}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding BasesDockDashboard}" Value="{x:Null}" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- A docked DASHBOARD renders its own surface
                                     (red team round 1 blocker: BasesDockDashboard
                                     was bound by no view — docking a dashboard
                                     announced success and showed nothing). -->
                                <bases:DashboardSurfaceView x:Name="BasesDockDashboardSurface"
                                                            AutomationIdRoot="BasesDockDash"
                                                            Model="{Binding BasesDockDashboard}">
                                    <bases:DashboardSurfaceView.Style>
                                        <Style TargetType="bases:DashboardSurfaceView">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BasesDockDashboard}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </bases:DashboardSurfaceView.Style>
                                </bases:DashboardSurfaceView>
                                <bases:BaseSurfaceView x:Name="BasesDockSurface"
                                                       Model="{Binding BasesDockDocument}"
                                                       IsReadOnlySurface="True">
                                    <bases:BaseSurfaceView.Style>
                                        <!-- Hidden with no model: an empty surface
                                             skeleton exposes dead-but-enabled
                                             controls to the accessibility tree. -->
                                        <Style TargetType="bases:BaseSurfaceView">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BasesDockDocument}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </bases:BaseSurfaceView.Style>
                                </bases:BaseSurfaceView>
                            </DockPanel>

                            <!-- W6-2 PR B (#746): the Connections leaf —
                                 the note in view's local graph as a tree
                                 (rule C; contracts B-13, B-16, B-18). The
                                 heading lives inside the view: its text is
                                 the note's file name, the mac's headerTitle. -->
                            <DockPanel Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained"
                                       AutomationProperties.AutomationId="ConnectionsLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="connections">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <graph:ConnectionsLeafView x:Name="ConnectionsLeafSurface"
                                                           Model="{Binding Connections}" />
                            </DockPanel>

                            <!-- W6-2 PR E (#746): the graph inspector leaf —
                                 filters, colour groups, display and forces over
                                 the workspace's one view model (rule I, Term I1;
                                 contracts E-1, E-15). -->
                            <DockPanel Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained"
                                       AutomationProperties.AutomationId="GraphInspectorBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="inspector">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <!-- DS-18: the leaf's toolbar, titled as the rail names it (T37). -->
                                <local:PanelToolbarView DockPanel.Dock="Top" Title="{Binding ActiveLeaf.Title}" />
                                <graph:GraphInspectorView x:Name="GraphInspectorSurface"
                                                          Model="{Binding Inspector}" />
                            </DockPanel>

                            <!-- W4-7 (#739): the history leaf — two
                                 segments, day-grouped versions, the
                                 structured diff walkthrough, restore
                                 flows (contracts H2-H10). -->
                            <DockPanel Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained"
                                       AutomationProperties.AutomationId="HistoryLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="history">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <local:PanelToolbarView DockPanel.Dock="Top" Title="History" />
                                <panels:HistorySurfaceView Model="{Binding History}" />
                            </DockPanel>

                            <!-- W4-8 (#740): the sync-diagnostics leaf —
                                 five states, per-provider risk rows with
                                 evidence disclosures, and the LiveSync
                                 config section (contracts SD2/SD3). -->
                            <DockPanel Margin="12"
                                       KeyboardNavigation.DirectionalNavigation="Contained"
                                       AutomationProperties.AutomationId="SyncDiagnosticsLeafBody">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="syncDiagnostics">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <local:PanelToolbarView DockPanel.Dock="Top" Title="Sync" />
                                <panels:SyncDiagnosticsSurfaceView Model="{Binding SyncDiagnostics}" />
                            </DockPanel>

                            <StackPanel x:Name="RightPaneDockedPlaceholder"
                                        Grid.Column="0" Margin="12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="citations">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="bibliography">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="queries">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="basesDock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="backlinks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outgoingLinks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="outline">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="embeds">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasks">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="tasksReview">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="history">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="syncDiagnostics">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <!-- W6-2 PR B (B-13): the placeholder retires for the leaf. -->
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="connections">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <!-- W7-5 (#1239): the graph inspector has had a body since
                                                 W6-2 PR E, but never retired the placeholder, so its
                                                 heading painted over the inspector's notice. Pinned by
                                                 RightPaneLeafBodyCensus. -->
                                            <DataTrigger Binding="{Binding ActiveLeaf.Id}" Value="inspector">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <local:PanelToolbarView Title="{Binding ActiveLeaf.Title}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="This panel is docked and ready for its feature surface."
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- DS-16 (DSD8): the rail is a strip of five icons and More panels,
                                 which holds the other twelve. Arrows move in the strip, and More
                                 panels is the next Tab stop. A short window scrolls them both. -->
                            <ScrollViewer x:Name="RightPaneRailStrip"
                                          Grid.Column="1"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4">
                                    <ListBox x:Name="RightPaneLeavesList"
                                             KeyboardNavigation.DirectionalNavigation="Contained"
                                             ItemsSource="{Binding StripLeafOptions}"
                                             SelectedItem="{Binding StripLeaf, Mode=TwoWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             VirtualizingStackPanel.IsVirtualizing="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             AutomationProperties.AutomationId="RightPaneLeaves"
                                             AutomationProperties.Name="Right pane panels">
                                        <!-- Explicit names: content-derived ListItem names
                                             are not composed on all sessions (the Quick
                                             Open row precedent), and a rail entry an AT
                                             cannot name is unusable. The icon names nothing. -->
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                                <Setter Property="Width" Value="40" />
                                                <Setter Property="Height" Value="40" />
                                                <!-- Room for the pill, which sits 7 out from the content. -->
                                                <Setter Property="Padding" Value="10,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Setter Property="ToolTip" Value="{Binding Title}" />
                                                <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="False" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <local:LeafIcon Leaf="{Binding}" IconSize="20" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <!-- The menu is built as it opens (RightPaneMorePanels_Click). While
                                         one of its panels is open, the button looks selected, with the
                                         pill, and its name, from core, says that panel is open. -->
                                    <Button x:Name="RightPaneMorePanelsButton"
                                            Content="&#xE712;"
                                            Width="40"
                                            Height="40"
                                            HorizontalAlignment="Left"
                                            KeyboardNavigation.DirectionalNavigation="Contained"
                                            ToolTip="{Binding MorePanelsName, FallbackValue=More panels}"
                                            ToolTipService.ShowsToolTipOnKeyboardFocus="False"
                                            Click="RightPaneMorePanels_Click"
                                            AutomationProperties.AutomationId="RightPaneMorePanels"
                                            AutomationProperties.Name="{Binding MorePanelsName, FallbackValue=More panels}">
                                        <Button.Style>
                                            <!-- Slate.SubtleIconButtonStyle's look (the theme's styles load
                                                 after this window's), at the strip's 40 with its pill. -->
                                            <Style TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource Slate.TextBrush}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="4"
                                                                    SnapsToDevicePixels="True">
                                                                <Grid>
                                                                    <Rectangle x:Name="Pill"
                                                                               Width="3"
                                                                               Height="16"
                                                                               Margin="3,0,0,0"
                                                                               RadiusX="1.5"
                                                                               RadiusY="1.5"
                                                                               HorizontalAlignment="Left"
                                                                               VerticalAlignment="Center"
                                                                               Fill="{DynamicResource Slate.AccentIndicatorBrush}"
                                                                               Visibility="Collapsed" />
                                                                    <local:AutomationPresentationTextBlock Text="{TemplateBinding Content}"
                                                                                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                                                           FontSize="20"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Slate.HoverOverlayBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Slate.PressedOverlayBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding MoreLeafTitle, Converter={StaticResource IsNotNullConverter}}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Slate.SelectedSurfaceBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Slate.SelectedTextBrush}" />
                                                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </local:AutomationLandmarkBorder>
                </Grid>
                </local:WorkspaceRowHost>
            </local:AutomationLandmarkGrid>
            <!-- A full-window hit-test layer makes Quick Open modal for pointer
                 input. The underlying shell is disabled above, so UIA clients
                 cannot invoke commands behind the visible overlay either. -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding QuickSwitcher.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="600" MaxHeight="430" Margin="24,72,24,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Border Style="{DynamicResource Slate.OverlayShadow28}"
                    Visibility="{Binding Visibility, ElementName=QuickSwitcherOverlay}" />
            <local:AutomationLandmarkBorder x:Name="QuickSwitcherOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.QuickSwitcher.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding QuickSwitcher}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="QuickSwitcher"
                    AutomationProperties.Name="Quick Open"
                    AutomationProperties.IsDialog="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickSwitcherSearchTextBox" local:FieldPrompt.IsEnabled="True" local:SearchGlyph.IsEnabled="True"
                                 Grid.Column="0"
                                 Padding="10,8"
                                 FontSize="{DynamicResource Slate.FontSizeBodyLarge}"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                 PreviewKeyDown="QuickSwitcherSearch_PreviewKeyDown"
                                 AutomationProperties.AutomationId="QuickSwitcherSearch"
                                 AutomationProperties.Name="Search files"
                                 AutomationProperties.HelpText="{x:Static cmd:NavigationHelp.QuickOpen}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Close"
                                Command="{Binding DismissCommand}"
                                Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                AutomationProperties.AutomationId="QuickSwitcherClose"
                                AutomationProperties.Name="Close Quick Open" />
                    </Grid>
                    <!-- ResultSummary describes the collection, so expose it once on
                         the list rather than repeating it on every result row. -->
                    <local:AutomationVisibilityListBox x:Name="QuickSwitcherResultsList"
                             Grid.Row="1"
                             Margin="0,8"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                             MouseDoubleClick="QuickSwitcherResults_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="QuickSwitcherResults" local:SiblingNames.NamePath="DisplayName" local:SiblingNames.DistinguisherPath="Path" local:SiblingNames.Noun="result"
                             AutomationProperties.Name="Quick Open results"
                             AutomationProperties.ItemStatus="{Binding ResultSummary}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Path}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- DS-5: the 180 this column always was, times the text
                                         size. Two notes with one name differ by their paths,
                                         so a long name has to leave them room. -->
                                    <local:AutomationPresentationTextBlock Text="{Binding DisplayName}"
                                                                           Width="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource QuickOpenNameWidthConverter}}"
                                                                           Padding="0,0,8,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           FontWeight="SemiBold" />
                                    <local:AutomationPresentationTextBlock Grid.Column="1"
                                                                           Text="{Binding Path}"
                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </local:AutomationVisibilityListBox>
                    <WrapPanel Grid.Row="2">
                        <local:AutomationPresentationTextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap"
                                                               Margin="0,0,12,0"
                                                               Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        <local:AutomationPresentationTextBlock Text="Enter open · Ctrl+Enter tab · Ctrl+Alt+Enter split · Esc close"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                    </WrapPanel>
                </Grid>
            </local:AutomationLandmarkBorder>
            </Grid>
            <!-- ==========================================================
                 W5-2 (#742): the vault-search overlay. Declared BETWEEN
                 Quick Open and the palette (contract S11). Since SD-5
                 the three never coexist outside a palette invoke's
                 transient window, so the position is the stacking
                 invariant's backstop: if exclusivity is ever violated,
                 the palette still paints above search rather than
                 beneath it.

                 Visibility resolves through the WINDOW because this
                 element overrides its own DataContext: the short path
                 would resolve against SearchOverlayViewModel, fail, and
                 stick at FallbackValue=Collapsed forever — shipped
                 broken twice before, in W4-5 and W4-6.
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Search.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Grid MaxWidth="640" MaxHeight="470" Margin="24,72,24,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Border Style="{DynamicResource Slate.OverlayShadow28}"
                    Visibility="{Binding Visibility, ElementName=SearchOverlay}" />
            <local:AutomationLandmarkBorder x:Name="SearchOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Search.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Search}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="SearchOverlay"
                    AutomationProperties.Name="Search Vault"
                    AutomationProperties.IsDialog="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- "Search vault" with NO trailing period — mac's
                             actual label (its own doc comment claiming the
                             period is recorded stale, contracts doc item 3). -->
                        <TextBox local:FieldPrompt.IsEnabled="True" local:SearchGlyph.IsEnabled="True" x:Name="SearchOverlaySearchTextBox"
                                 Grid.Column="0"
                                 Padding="10,8"
                                 FontSize="{DynamicResource Slate.FontSizeBodyLarge}"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchOverlaySearch_PreviewKeyDown"
                                 AutomationProperties.AutomationId="SearchOverlaySearch"
                                 AutomationProperties.Name="Search vault"
                                 Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.HelpText="Type to search across every note in this vault. Return activates the top result. Up and Down move through results. Escape closes." />
                        <!-- Pointer dismissal (contract S15, red-team
                             round 1): mac's field row ends in a "Close
                             search" button (SearchOverlay.swift:169-198,
                             label and hint verbatim); the Windows shape
                             is Quick Open's "Close Quick Open". Without
                             it, Esc was the only way out of a surface a
                             pointer can open from the menu. -->
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Close"
                                Click="SearchOverlayClose_Click"
                                Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SearchOverlayClose"
                                AutomationProperties.Name="Close search"
                                AutomationProperties.HelpText="Closes the search overlay and returns to the previous view." />
                    </Grid>
                    <!-- The read-only tag chip (divergence SD-3: no scope
                         selector exists on either platform). One named
                         group stop; the visual "Tag: {name}" text is
                         presentation-only; the clear button is its own
                         focusable stop, exactly mac's chip anatomy. -->
                    <local:AutomationNamedRowBorder Grid.Row="1"
                            Margin="0,8,0,0"
                            Padding="8,4"
                            CornerRadius="4"
                            Background="{DynamicResource Slate.RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource Slate.BorderBrush}"
                            BorderThickness="1"
                            Visibility="{Binding TagScopeName, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                            AutomationProperties.AutomationId="SearchOverlayTagChip"
                            AutomationProperties.Name="{Binding TagScopeName, StringFormat='Filtered to tag {0}'}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                    Content="&#xE711;"
                                    Click="SearchOverlayClearTagScope_Click"
                                    AutomationProperties.AutomationId="SearchOverlayClearTagScope"
                                    AutomationProperties.Name="Clear tag filter"
                                    AutomationProperties.HelpText="Removes the tag filter and searches the whole vault." />
                            <local:AutomationPresentationTextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding TagScopeName, StringFormat='Tag: {0}'}" TextWrapping="Wrap" />
                        </DockPanel>
                    </local:AutomationNamedRowBorder>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <!-- ONE accessible stop per result row (contract
                             S4): the container carries the composed name;
                             the emphasis runs and the basename line are
                             presentation-only. Summary rides ItemStatus —
                             the Quick Open precedent for the collection
                             description. -->
                        <local:AutomationVisibilityListBox x:Name="SearchOverlayResults"
                                 ItemsSource="{Binding Rows}"
                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                 Visibility="{Binding ShowsResultRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 SelectionChanged="SearchOverlayResults_SelectionChanged"
                                 MouseDoubleClick="SearchOverlayResults_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.AutomationId="SearchOverlayResults" local:SiblingNames.NamePath="AccessibleName" local:SiblingNames.DistinguisherPath="Path" local:SiblingNames.Noun="result"
                                 AutomationProperties.Name="Search results"
                                 AutomationProperties.ItemStatus="{Binding Summary}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <local:AutomationPresentationTextBlock
                                                Text="{Binding Basename}"
                                                TextWrapping="Wrap"
                                                FontWeight="SemiBold" />
                                        <!-- Match emphasis. A WrapPanel, not the
                                             palette's horizontal StackPanel: the
                                             snippet is never truncated (accepted
                                             risk SR-2, mac's WCAG 1.4.4 call), so
                                             a long one wraps into a tall row.
                                             The host is peer-suppressed: a plain
                                             ItemsControl publishes an unnamed
                                             List INSIDE the row, breaking S4's
                                             one-stop rule (close-out journey
                                             finding). -->
                                        <local:AutomationPresentationItemsControl
                                                      ItemsSource="{Binding SnippetSegments}"
                                                      Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:AutomationPresentationTextBlock
                                                            Text="{Binding Text}"
                                                            TextWrapping="Wrap"
                                                            FontSize="{DynamicResource Slate.FontSizeCaption}" FontFamily="{DynamicResource Slate.FontFamilySmall}" LineHeight="{DynamicResource Slate.LineHeightCaption}" LineStackingStrategy="BlockLineHeight"
                                                            Foreground="{DynamicResource Slate.SecondaryTextBrush}">
                                                        <local:AutomationPresentationTextBlock.Style>
                                                            <Style TargetType="local:AutomationPresentationTextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </local:AutomationPresentationTextBlock.Style>
                                                    </local:AutomationPresentationTextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </local:AutomationPresentationItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </local:AutomationVisibilityListBox>
                        <!-- The mutually exclusive state panels, labels
                             mac-verbatim (contract S14; the strings are
                             pinned by SearchOverlayViewModel's constants
                             and IdleStateLabelsAreMacVerbatim). Each is
                             collapsed when unused — an empty panel left
                             on-screen at zero size fails the axe
                             BoundingRectangleNotNull check — and each
                             publishes through a peer-bearing element: a
                             bare StackPanel publishes nothing. -->
                        <local:AutomationLandmarkGrid
                                Visibility="{Binding ShowsIdleHint, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SearchOverlayIdleHint"
                                AutomationProperties.Name="Type to search.">
                            <local:AutomationPresentationTextBlock Margin="4"
                                    Text="Type to search."
                                    Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </local:AutomationLandmarkGrid>
                        <Grid Visibility="{Binding ShowsRecents, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="4,0">
                                <Button DockPanel.Dock="Right"
                                        Padding="8,2"
                                        Content="Clear"
                                        Click="SearchOverlayClearRecents_Click"
                                        AutomationProperties.AutomationId="SearchOverlayClearRecents"
                                        AutomationProperties.Name="Clear recent searches"
                                        AutomationProperties.HelpText="Forgets every remembered search in this vault." />
                                <TextBlock Text="Recent Searches"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                           AutomationProperties.Name="Recent Searches"
                                           AutomationProperties.HeadingLevel="Level2" />
                            </DockPanel>
                            <ScrollViewer Focusable="False" Grid.Row="1"
                                          Margin="0,4,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <!-- R-4 (#1246): each Button is the stop; its container
                                     is layout. -->
                                <local:LayoutItemsControl ItemsSource="{Binding Recents}"
                                                          AutomationProperties.Name="Recent searches" local:SiblingNames.NamePath="" local:SiblingNames.Noun="search" local:SiblingNames.Prefix="Recent search: ">
                                    <local:LayoutItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                        </Style>
                                    </local:LayoutItemsControl.ItemContainerStyle>
                                    <local:LayoutItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="4,1"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="SearchOverlayRecentRow_Click"
                                                    GotKeyboardFocus="SearchOverlayRecentRow_GotKeyboardFocus"
                                                    AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                    AutomationProperties.HelpText="Runs this search again.">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </Button>
                                        </DataTemplate>
                                    </local:LayoutItemsControl.ItemTemplate>
                                </local:LayoutItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <!-- Visible "Searching…", spoken "Searching." —
                             mac's deliberate split. The transition into
                             this state is SILENT (contract S8): the name
                             is what an AT reads on focus, not a live
                             announcement. -->
                        <local:AutomationLandmarkGrid
                                Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SearchOverlaySearching"
                                AutomationProperties.Name="Searching.">
                            <local:AutomationPresentationTextBlock Margin="4"
                                    Text="Searching…"
                                    Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </local:AutomationLandmarkGrid>
                        <local:AutomationLandmarkGrid
                                Visibility="{Binding ShowsNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SearchOverlayNoResults"
                                AutomationProperties.Name="No results.">
                            <local:AutomationPresentationTextBlock Margin="4"
                                    Text="No results."
                                    Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </local:AutomationLandmarkGrid>
                        <StackPanel Margin="4"
                                    Visibility="{Binding ShowsError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Search error"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="Search error"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <!-- The VM's Summary is the event's own
                                 rendering ("Search error: {message}",
                                 a11y.rs:872) — displayed and spoken from
                                 one template, never two copies (S6). -->
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Summary}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <!-- Visible twin of the summary announcement, hidden
                         from AT like mac's (the announcement is the audio
                         source of truth; ItemStatus carries the UIA copy). -->
                    <local:AutomationPresentationTextBlock Grid.Row="3"
                            Margin="4,8,4,0"
                            Text="{Binding Summary}" TextWrapping="Wrap"
                            Visibility="{Binding ShowsResultRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                </Grid>
            </local:AutomationLandmarkBorder>
            </Grid>
            <!-- ==========================================================
                 W5-1 (#741): the command palette. Built on the Quick Open
                 shape above — an in-window overlay, never a WPF Popup,
                 whose UIA subtree would be a sibling HWND (contract P5).

                 Two bindings here are load-bearing and easy to get wrong.
                 Visibility resolves through the WINDOW, because this
                 element overrides its own DataContext: binding the short
                 path would resolve against CommandPaletteViewModel, fail,
                 and stick at FallbackValue=Collapsed forever — shipped
                 twice before, in W4-5 and W4-6. And the results list gets
                 its ItemsSource from code-behind, not from a binding,
                 because the rows are grouped by the section core PLACED
                 them in; see CommandPaletteResultsPresenter.
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Palette.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Grid MaxWidth="640" MaxHeight="470" Margin="24,72,24,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Border Style="{DynamicResource Slate.OverlayShadow28}"
                    Visibility="{Binding Visibility, ElementName=CommandPaletteOverlay}" />
            <local:AutomationLandmarkBorder x:Name="CommandPaletteOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Palette.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Palette}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="CommandPalette"
                    AutomationProperties.Name="Command Palette"
                    AutomationProperties.IsDialog="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="CommandPaletteSearchTextBox"
                             Grid.Row="0"
                             Padding="10,8"
                             FontSize="{DynamicResource Slate.FontSizeBodyLarge}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CommandPaletteSearch_PreviewKeyDown"
                             local:FieldPrompt.IsEnabled="True"
                             local:SearchGlyph.IsEnabled="True"
                                 AutomationProperties.AutomationId="CommandPaletteSearch"
                             AutomationProperties.Name="{Binding SearchFieldName}"
                             Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.HelpText="{Binding SearchFieldHelp}" />
                    <!-- The two Visibility bindings on this list and on the
                         search box above are PRECAUTIONARY, matching the Quick
                         Open precedent. A round-2 mutation removed both and the
                         journey's closed-palette assertion still passed, so the
                         children do leave the UIA tree with their collapsed
                         ancestor on this framework version. A later probe
                         walking the RAW tree showed why: the elements do
                         remain in the raw tree, and it is WPF dropping
                         invisible elements from the CONTROL view that hides
                         them, not these bindings. Kept for consistency with
                         Quick Open; they are redundant, not load-bearing. -->
                    <!-- R-11 (#1254), two settings the palette's speed and
                         speech depend on. Never synchronized with the view's
                         current item: every query change swaps in a fresh
                         grouped view, and a synchronized list selects that
                         view's FIRST row on the swap — the stale "Selected:
                         New Canvas" the NVDA pass heard. The view model's
                         selection is the only one; the presenter pushes it
                         in (CommandPaletteResultsPresenter). And the grouped
                         rows virtualize: a grouped ListBox otherwise
                         realizes EVERY row, so the first keystroke
                         re-templated 174 of them before one could be read.
                         Standard mode, never Recycling — recycled containers
                         are the UIA crash class the data grid pins against
                         (dotnet/wpf #8528) — and pixel scrolling, which
                         grouped virtualization wants. -->
                    <local:AutomationVisibilityListBox x:Name="CommandPaletteResultsList"
                             Grid.Row="1"
                             Margin="0,8"
                             Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                             IsSynchronizedWithCurrentItem="False"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="CommandPaletteResults_MouseDoubleClick"
                             AutomationProperties.AutomationId="CommandPaletteResults"
                             AutomationProperties.Name="Command results">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <!-- ONE name per row (contract P6): label plus the
                                     spoken chord. The visible chord and the bolded
                                     runs below are presentation-only, so they never
                                     become separate stops. -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibilityHint}" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding ItemStatus}" />
                                <Style.Triggers>
                                    <!-- Unavailable rows stay visible, selectable and
                                         in the arrow cycle — only activation is
                                         refused (contract P8). IsEnabled="False" here
                                         would drop them from keyboard navigation AND
                                         from the UIA tree, which is the opposite of
                                         what the contract asks for. -->
                                    <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                        <Setter Property="Opacity" Value="0.65" />
                                        <Setter Property="AutomationProperties.HelpText" Value="{Binding DisabledReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                                   Margin="4,8,4,2"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                   AutomationProperties.Name="{Binding Name}"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- DS-10: a choice's check. Every choice keeps its place,
                                         so the labels line up; a command has no such column. -->
                                    <local:AutomationPresentationTextBlock Width="16"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding ChoiceMark}"
                                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Visibility="{Binding IsChoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Grid.Column="1">
                                        <!-- Match bolding. Segments always concatenate
                                             back to the whole label, so a hint-only
                                             match renders as one unbolded segment
                                             rather than bold-everything. -->
                                        <!-- Presentation only (R-4, #1246): the row's
                                             composed name carries the label, and a plain
                                             ItemsControl put a list of
                                             "CommandPaletteLabelSegment { … }" items inside
                                             every row — the W5-2 search-row class. -->
                                        <local:AutomationPresentationItemsControl ItemsSource="{Binding LabelSegments}"
                                                                                  Focusable="False">
                                            <local:AutomationPresentationItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </local:AutomationPresentationItemsControl.ItemsPanel>
                                            <local:AutomationPresentationItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:AutomationPresentationTextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                        <local:AutomationPresentationTextBlock.Style>
                                                            <Style TargetType="local:AutomationPresentationTextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </local:AutomationPresentationTextBlock.Style>
                                                    </local:AutomationPresentationTextBlock>
                                                </DataTemplate>
                                            </local:AutomationPresentationItemsControl.ItemTemplate>
                                        </local:AutomationPresentationItemsControl>
                                        <local:AutomationPresentationTextBlock
                                                Text="{Binding DisabledReason}"
                                                Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                TextWrapping="Wrap" />
                                    </StackPanel>
                                    <local:AutomationPresentationTextBlock Grid.Column="2"
                                            Margin="12,0,0,0"
                                            Text="{Binding HotkeyHint}"
                                            Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </local:AutomationVisibilityListBox>
                    <!-- Empty states. Collapsed when unused: an empty
                         ItemsControl left on-screen at zero size fails the
                         axe BoundingRectangleNotNull check (the W4-5/W4-6
                         lesson). -->
                    <!-- AutomationLandmarkGrid, not StackPanel: a bare Panel
                         creates NO automation peer, so the composed name
                         below would be silently dropped and the block would
                         publish nothing at all. Both children are
                         presentation-only, so this host is the single stop. -->
                    <local:AutomationLandmarkGrid Grid.Row="2"
                                Margin="4,4,4,0"
                                Visibility="{Binding ShowsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding EmptyStateAccessibleName}">
                        <StackPanel>
                        <local:AutomationPresentationTextBlock Text="{Binding EmptyStateTitle}" TextWrapping="Wrap"
                                                               FontWeight="SemiBold" />
                        <local:AutomationPresentationTextBlock Text="{Binding EmptyStateDetail}"
                                                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                               TextWrapping="Wrap" />
                        </StackPanel>
                    </local:AutomationLandmarkGrid>
                    <local:AutomationPresentationTextBlock Grid.Row="3"
                            Margin="4,8,4,0"
                            Text="{Binding KeysHint}"
                            Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                            TextWrapping="Wrap" />
                </Grid>
            </local:AutomationLandmarkBorder>
            </Grid>
            <!-- ==========================================================
                 W4-4 (#736): the add-property sheet. Focus lands on the
                 Key field at open; Enter = Add, Esc = Cancel (code-behind
                 PreviewKeyDown — no window-global default button).
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.AddPropertySheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="448" MinWidth="320" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=AddPropertyOverlay}" />
            <local:AutomationLandmarkBorder x:Name="AddPropertyOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.AddPropertySheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.AddPropertySheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="AddPropertyOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="AddPropertySheet"
                    AutomationProperties.Name="Add property"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <StackPanel>
                    <TextBlock Text="Add property"
                               Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <local:AutomationPresentationTextBlock Margin="0,10,0,2" Text="Property key" />
                    <TextBox x:Name="AddPropertyKeyTextBox"
                             Padding="6,4"
                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AddPropertyKey"
                             AutomationProperties.Name="Property key" />
                    <local:AutomationPresentationTextBlock Margin="0,8,0,2" Text="Property type" />
                    <ComboBox ItemsSource="{x:Static panels:AddPropertyViewModel.Kinds}"
                              SelectedItem="{Binding Kind}"
                              AutomationProperties.AutomationId="AddPropertyType"
                              AutomationProperties.Name="Property type">
                        <!-- R-4 (#1246): every item host names its containers. -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Slate.ComboRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <!-- Round 3: shape-derived kinds need a shape-valid
                         seed — core classifies stored values by shape,
                         so the chosen type must survive the re-read. -->
                    <local:AutomationPresentationTextBlock Margin="0,8,0,2" Text="Initial value" />
                    <TextBox Padding="6,4"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AddPropertyValue"
                             AutomationProperties.Name="Initial value" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding ValidationError}"
                               Foreground="{DynamicResource Slate.WarningBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}" />
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Padding="10,4"
                                Content="Add"
                                Click="AddPropertyAdd_Click"
                                AutomationProperties.AutomationId="AddPropertyConfirm"
                                AutomationProperties.HelpText="Add this property to the note." />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Cancel"
                                Command="{Binding DataContext.Workspace.CloseAddPropertySheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="AddPropertyCancel" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>
            <!-- ==========================================================
                 W4-4 (#736): the bulk-rename sheet. Default action is
                 PREVIEW, never Apply; Apply arms only after a preview on
                 the exact key pair (any key edit disarms it); Esc cancels
                 in-flight core work through the CancelToken and closes.
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.BulkRenameSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="760" MaxHeight="560" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=BulkRenameOverlay}" />
            <local:AutomationLandmarkBorder x:Name="BulkRenameOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.BulkRenameSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.BulkRenameSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="BulkRenameOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="BulkRenameSheet"
                    AutomationProperties.Name="Rename property across the vault"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Rename property across the vault" TextWrapping="Wrap"
                               Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <local:AutomationPresentationTextBlock Margin="0,0,0,2" Text="Old property key" TextWrapping="Wrap" />
                            <TextBox x:Name="BulkRenameOldKeyTextBox"
                                     Padding="6,4"
                                     Text="{Binding OldKey, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="BulkRenameOldKey"
                                     AutomationProperties.Name="Old property key" />
                            <local:AutomationPresentationTextBlock Margin="0,6,0,2" Text="Old key type" TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding KeyTypes}"
                                      SelectedItem="{Binding OldKeyType}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.AutomationId="BulkRenameOldKeyType"
                                      AutomationProperties.Name="Old key type">
                                <!-- W7-7 PR 3 (#1246, R-4): NVDA reads a combo's value
                                     from its selected item's name, which was the record
                                     dump "KeyTypeChoice { Label = Any key type, Kind = }";
                                     DisplayMemberPath templates the text only. -->
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Slate.ComboRowBase}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <local:AutomationPresentationTextBlock Margin="0,0,0,2" Text="New property key" TextWrapping="Wrap" />
                            <TextBox Padding="6,4"
                                     Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="BulkRenameNewKey"
                                     AutomationProperties.Name="New property key" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                   Visibility="{Binding ProgressText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ErrorText}"
                                   Foreground="{DynamicResource Slate.WarningBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3"
                               Margin="0,12"
                               Text="{Binding EmptyStateText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.Name="{Binding EmptyStateText}" />
                    <grids:AccessibleDataGrid x:Name="BulkRenamePreviewGrid"
                                              Grid.Row="3"
                                              Margin="0,8"
                                              MinHeight="120"
                                              MaxHeight="280"
                                              Visibility="{Binding ShowEmptyState, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding FooterText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                               AutomationProperties.AutomationId="BulkRenameFooter" />
                    <StackPanel Grid.Row="5"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Padding="10,4"
                                Content="Preview"
                                Click="BulkRenamePreview_Click"
                                IsEnabled="{Binding CanPreview}"
                                AutomationProperties.AutomationId="BulkRenamePreviewButton" />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Apply"
                                Click="BulkRenameApply_Click"
                                IsEnabled="{Binding CanApply}"
                                AutomationProperties.AutomationId="BulkRenameApplyButton"
                                AutomationProperties.HelpText="Apply the previewed property rename across the vault." />
                        <Button Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Close"
                                Command="{Binding DataContext.Workspace.CloseBulkRenameSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="BulkRenameClose" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>

            <!-- ==========================================================
                 W4-5 (#737): the citation details overlay. D-1 — mac
                 anchors a popover to the row; a WPF Popup lives in a
                 separate HWND whose UIA subtree is a sibling window, so
                 this is the in-window sheet instead. The focus-return
                 contract (WCAG 2.4.3 / 2.1.2) is preserved verbatim:
                 Escape returns focus to the row that opened it
                 (contract 11).
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.CitationDetails, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="448" MinWidth="320" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=CitationDetailsOverlay}" />
            <local:AutomationLandmarkBorder x:Name="CitationDetailsOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.CitationDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CitationDetails}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="CitationDetailsOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="CitationDetailsSheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <StackPanel>
                    <!-- An unresolved key is a real state, not an error
                         (contract 7): the sheet says so plainly rather
                         than showing empty fields. -->
                    <StackPanel Visibility="{Binding IsUnresolved, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding UnresolvedHeading}" TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding UnresolvedBody}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Absent values never produce a row (contract 10):
                         Fields carries only what is present. -->
                    <!-- A ListBox, not an ItemsControl.
                         An ItemsControl's items were bare StackPanels,
                         and WPF creates NO automation peer for a Panel,
                         so AutomationProperties.Name on it was dropped
                         outright; both children are
                         AutomationPresentationTextBlock, whose peer
                         returns false from IsControlElement AND
                         IsContentElement. The net effect was that every
                         citation field — Title, Authors, Year, Journal,
                         Publisher, DOI, URL — was absent from the UIA
                         tree, in the one surface whose entire job is
                         speaking them. ListBoxItem DOES have a peer, so
                         each field becomes its own navigable AT element,
                         which is what mac's per-field rendering means
                         (CitationPopover.swift:5-10). -->
                    <ListBox ItemsSource="{Binding Fields}"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="220"
                             Visibility="{Binding IsUnresolved, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="CitationDetailsFields"
                             AutomationProperties.Name="{x:Static panels:CitationPhrase.DetailsFieldsLabel}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <local:AutomationPresentationTextBlock Text="{Binding Label}"
                                                                           TextWrapping="Wrap"
                                                                           Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                                    <local:AutomationPresentationTextBlock x:Name="FieldValueText"
                                                                           Text="{Binding Value}"
                                                                           TextWrapping="Wrap" />
                                    <!-- DOI and URL carry a LinkTarget
                                         and are actually followable;
                                         every other field is plain
                                         text. Rendering all of them
                                         identically left the DOI
                                         readable but unreachable. -->
                                    <TextBlock x:Name="FieldValueLink" TextWrapping="Wrap" Visibility="Collapsed">
                                        <Hyperlink Command="{Binding DataContext.Workspace.OpenCitationLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding LinkTarget}">
                                            <Run Text="{Binding Value, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLink}" Value="True">
                                        <Setter TargetName="FieldValueText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="FieldValueLink" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- A real disclosure, matching mac's
                         DisclosureGroup. The abstract used to render
                         unconditionally while its accessible name said
                         "Abstract, collapsed." forever: AbstractExpanded
                         had no writer anywhere in production, so a
                         sighted user read the text and a screen-reader
                         user heard only that it was collapsed, with no
                         control to open it. The body also scrolls now —
                         a long abstract was clipped at MaxHeight with no
                         keyboard route to the rest. -->
                    <Expander Margin="0,6,0,0"
                              IsExpanded="{Binding AbstractExpanded, Mode=TwoWay}"
                              Visibility="{Binding HasAbstract, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="CitationDetailsAbstract"
                              AutomationProperties.Name="{Binding AbstractAutomationName}">
                        <Expander.Header>
                            <TextBlock Text="{x:Static panels:CitationPhrase.FieldAbstract}" />
                        </Expander.Header>
                        <ScrollViewer Focusable="True" AutomationProperties.Name="{Binding AbstractText}" MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <local:AutomationPresentationTextBlock Text="{Binding AbstractText}"
                                                                   TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Expander>
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="CitationDetailsCloseButton"
                                Padding="10,4"
                                Content="{Binding CloseText}"
                                Command="{Binding DataContext.Workspace.CloseCitationDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="CitationDetailsClose"
                                AutomationProperties.HelpText="{Binding CloseHelp}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>

            <!-- ==========================================================
                 W4-5 (#737): the citation summary sheet (Ctrl+Shift+J).
                 Counts come from the leaf's already-published rows, so
                 the sheet can never disagree with the panel behind it
                 (contract 12).
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.CitationSummary, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="448" MinWidth="320" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=CitationSummaryOverlay}" />
            <local:AutomationLandmarkBorder x:Name="CitationSummaryOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.CitationSummary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CitationSummary}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="CitationSummaryOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="CitationSummarySheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding Body}"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0"
                               HorizontalAlignment="Right">
                        <Button x:Name="CitationSummaryWalkButton"
                                Margin="0,0,8,4"
                                Padding="10,4"
                                Content="{Binding WalkActionText}"
                                IsEnabled="{Binding CanWalkThrough}"
                                Click="CitationSummaryWalk_Click"
                                AutomationProperties.AutomationId="CitationSummaryWalk"
                                AutomationProperties.HelpText="{Binding WalkActionHelp}" />
                        <Button x:Name="CitationSummaryDismissButton"
                                Margin="0,0,0,4"
                                Padding="10,4"
                                Content="{Binding DismissText}"
                                Command="{Binding DataContext.Workspace.CloseCitationSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="CitationSummaryDismiss"
                                AutomationProperties.HelpText="{Binding DismissHelp}" />
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>

            <!-- ==========================================================
                 W4-5 (#737): files citing this entry, opened from a
                 bibliography row action.
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.FilesCiting, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="448" MinWidth="320" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=FilesCitingOverlay}" />
            <local:AutomationLandmarkBorder x:Name="FilesCitingOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.FilesCiting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.FilesCiting}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="FilesCitingOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="FilesCitingSheet"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding EmptyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ListBox x:Name="FilesCitingList"
                             Margin="0,6,0,0"
                             MaxHeight="260"
                             ItemsSource="{Binding Paths}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="FilesCitingList"
                             AutomationProperties.Name="{Binding Heading}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:AutomationPresentationTextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="FilesCitingCloseButton"
                                Padding="10,4"
                                Content="{x:Static panels:CitationPhrase.DetailsClose}"
                                Command="{Binding DataContext.Workspace.CloseFilesCitingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="FilesCitingClose" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.DashboardEditorSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="560" MaxHeight="520" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=DashboardEditorOverlay}" />
            <local:AutomationLandmarkBorder x:Name="DashboardEditorOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.RaisedSurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.DashboardEditorSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.DashboardEditorSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="DashboardEditorOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="DashboardEditorSheet"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Title}" TextWrapping="Wrap"
                               Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <!-- #1790: one label column, so the fields start together. -->
                    <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name:" VerticalAlignment="Center" />
                        <TextBox x:Name="DashboardEditorNameBox"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="2"
                                 Margin="6,0,0,0"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="DashboardEditorName"
                                 AutomationProperties.Name="Dashboard name" />
                        <TextBlock Grid.Row="1" Text="Saved query:" Margin="0,10,0,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="DashboardEditorQueryPicker"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="6,10,0,0"
                                  MinWidth="120"
                                  ItemsSource="{Binding DataContext.Workspace.SavedQueries, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.AutomationId="DashboardEditorQueryPicker" local:SiblingNames.NamePath="Name" local:SiblingNames.Noun="query"
                                  AutomationProperties.Name="Saved query to add">
                            <!-- R-4 (#1246): as the saved-queries list. -->
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Slate.ComboRowBase}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <!-- DS-14: under the picker, so a narrow sheet keeps the picker whole. -->
                        <Button Content="Add section"
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Margin="6,8,0,0"
                                AutomationProperties.AutomationId="DashboardEditorAddSection"
                                Click="DashboardEditorAddSection_Click" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Save"
                                AutomationProperties.AutomationId="DashboardEditorSave"
                                Click="DashboardEditorSave_Click" />
                        <Button Content="Cancel"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="DashboardEditorCancel"
                                Click="DashboardEditorCancel_Click" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Sections}"
                             Margin="0,10,0,0"
                             MaxHeight="280"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="DashboardEditorSections"
                             AutomationProperties.Name="Dashboard sections">
                        <!-- R-4 (#1246): a section row is named by its query and
                             its place, and so is every control in it: Add
                             section takes one query twice (codex PR 3 round 2). -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Button Content="Up" Margin="0,0,4,0" Click="DashboardEditorMoveUp_Click"
                                                AutomationProperties.Name="{Binding AutomationName, StringFormat=Move {0} up}" />
                                        <Button Content="Down" Margin="0,0,4,0" Click="DashboardEditorMoveDown_Click"
                                                AutomationProperties.Name="{Binding AutomationName, StringFormat=Move {0} down}" />
                                        <Button Content="Remove" Click="DashboardEditorRemoveSection_Click"
                                                AutomationProperties.Name="{Binding AutomationName, StringFormat=Remove {0}}" />
                                    </WrapPanel>
                                    <!-- #1790: one label column, so the fields start together. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="{Binding SavedQueryName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Margin="0,2,0,0" Text="Heading:" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Margin="6,2,0,0"
                                                 Text="{Binding HeadingOverride, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding AutomationName, StringFormat=Heading override for {0}}" />
                                        <TextBlock Grid.Row="2" Margin="0,2,0,0" Text="View:" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="2"
                                                  Grid.Column="1"
                                                  Margin="6,2,0,0"
                                                  MinWidth="120"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding ViewOverride}"
                                                  AutomationProperties.Name="{Binding AutomationName, StringFormat=View override for {0}}">
                                            <ComboBoxItem Content="Default" Tag="" />
                                            <ComboBoxItem Content="Table" Tag="table" />
                                            <ComboBoxItem Content="List" Tag="list" />
                                        </ComboBox>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.BaseQueryBuilderSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="640" MaxHeight="560" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=BaseQueryBuilderOverlay}" />
            <local:AutomationLandmarkBorder x:Name="BaseQueryBuilderOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.RaisedSurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.BaseQueryBuilderSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.BaseQueryBuilderSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="BaseQueryBuilderOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="BaseQueryBuilderSheet"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Title}" TextWrapping="Wrap"
                               Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Save to View"
                                Margin="0,4,8,0"
                                AutomationProperties.AutomationId="BuilderSaveToView"
                                Click="BuilderSaveToView_Click">
                            <Button.Style>
                                <!-- Only an edit-view context can save to a view
                                     (red team round 1: the button sat enabled in
                                     every context and clicked into silence). -->
                                <Style TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Context.ViewPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Update Saved Query"
                                Margin="0,4,8,0"
                                AutomationProperties.AutomationId="BuilderUpdateSavedQuery"
                                Click="BuilderUpdateSavedQuery_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Slate.ButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Context.SavedQueryId}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Save as Saved Query"
                                Margin="0,4,8,0"
                                AutomationProperties.AutomationId="BuilderSaveAsSavedQuery"
                                Click="BuilderSaveAsSavedQuery_Click" />
                        <Button Content="Save as .base"
                                Margin="0,4,8,0"
                                AutomationProperties.AutomationId="BuilderSaveAsBase"
                                Click="BuilderSaveAsBase_Click" />
                        <Button Content="Done"
                                Margin="0,4,0,0"
                                AutomationProperties.AutomationId="BuilderDone"
                                Click="BuilderDone_Click" />
                    </WrapPanel>
                        <StackPanel>
                            <!-- DS-14: a WrapPanel, so a narrow sheet keeps "Add group" whole. -->
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="Match:" Margin="0,4,6,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="BuilderCombinatorBox"
                                          Margin="0,4,12,0"
                                          MinWidth="90"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Combinator}"
                                          AutomationProperties.AutomationId="BuilderCombinator"
                                          AutomationProperties.Name="Condition combinator">
                                    <ComboBoxItem Content="All" Tag="and" />
                                    <ComboBoxItem Content="Any" Tag="or" />
                                </ComboBox>
                                <Button Content="Add condition"
                                        Margin="0,4,6,0"
                                        AutomationProperties.AutomationId="BuilderAddCondition"
                                        Click="BuilderAddCondition_Click" />
                                <Button Content="Add group"
                                        Margin="0,4,0,0"
                                        AutomationProperties.AutomationId="BuilderAddGroup"
                                        Click="BuilderAddGroup_Click" />
                            </WrapPanel>
                            <!-- R-4 (#1246), the one-stop rule: a row's container
                                 wraps its own controls, so it is layout. As a
                                 plain ItemsControl container it read its view
                                 model's type name, and named it was a second
                                 stop beside those controls; the controls carry
                                 the row's position instead ("Condition 2
                                 expression", "Remove Condition 2"). -->
                            <local:LayoutItemsControl Focusable="False" ItemsSource="{Binding ConditionRows}"
                                          Margin="0,6,0,0"
                                          AutomationProperties.AutomationId="BuilderConditions">
                                <local:LayoutItemsControl.Style>
                                    <!-- Empty collections collapse: a zero-size
                                         list is an axe BoundingRectangle
                                         violation (the queries-leaf rule). -->
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConditionRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:LayoutItemsControl.Style>
                                <local:LayoutItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Label}" MinWidth="70" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <Button DockPanel.Dock="Right"
                                                        Content="Remove"
                                                        Click="BuilderRemoveCondition_Click"
                                                        AutomationProperties.Name="{Binding RemoveName}" />
                                                <TextBox Margin="6,0,6,0"
                                                         Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding IsPreserved, Converter={StaticResource InverseBooleanConverter}}"
                                                         TextChanged="BuilderExpression_TextChanged"
                                                         AutomationProperties.Name="{Binding ExpressionName}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding ValidationMessage}"
                                                       Foreground="{DynamicResource Slate.WarningBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <local:LayoutItemsControl Focusable="False" ItemsSource="{Binding GroupMembers}" Margin="24,0,0,0">
                                                <local:LayoutItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GroupMembers}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:LayoutItemsControl.Style>
                                                <local:LayoutItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <TextBox Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextChanged="BuilderExpression_TextChanged"
                                                                     AutomationProperties.Name="{Binding ExpressionName}" />
                                                            <!-- A group member's refusal renders like a
                                                                 top-level row's (red team round 1: it was
                                                                 invisible). -->
                                                            <TextBlock Text="{Binding ValidationMessage}"
                                                                       Foreground="{DynamicResource Slate.WarningBrush}"
                                                                       TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </Trigger>
                                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </local:LayoutItemsControl.ItemTemplate>
                                            </local:LayoutItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </local:LayoutItemsControl.ItemTemplate>
                            </local:LayoutItemsControl>
                            <TextBlock Text="{Binding SaveError}"
                                       Foreground="{DynamicResource Slate.WarningBrush}"
                                       TextWrapping="Wrap"
                                       Focusable="True"
                                       AutomationProperties.AutomationId="BuilderSaveError">
                                <TextBlock.Style>
                                    <!-- An EMPTY focusable text is a tab stop
                                         announcing nothing — collapsed until
                                         there is an error to read. -->
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,10,0,2" Text="PREVIEW" Style="{DynamicResource Slate.CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            <TextBlock x:Name="BuilderPreviewLine"
                                       Text="Preview not loaded."
                                       TextWrapping="Wrap"
                                       Focusable="True"
                                       AutomationProperties.AutomationId="BuilderPreviewLine" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="BuilderSavePathBox" local:FieldPrompt.IsEnabled="True"
                                         MinWidth="180"
                                         AutomationProperties.AutomationId="BuilderSavePathBox"
                                         AutomationProperties.Name="New .base path" />
                                <TextBox x:Name="BuilderSaveNameBox" local:FieldPrompt.IsEnabled="True"
                                         MinWidth="140"
                                         Margin="8,0,0,0"
                                         AutomationProperties.AutomationId="BuilderSaveNameBox"
                                         AutomationProperties.Name="Saved query name" />
                            </StackPanel>
                        </StackPanel>
                </DockPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>
            <!-- ==========================================================
                 W5-3 (#743): the template picker sheet. Focus lands per
                 state (first row / Try Again / Cancel); Enter activates
                 the selected row, Esc cancels (code-behind
                 PreviewKeyDown). Declared after every earlier sheet —
                 ModalSurface paint order is XAML declaration order.
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.TemplatePickerSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="448" MinWidth="320" MaxHeight="440" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=TemplatePickerOverlay}" />
            <local:AutomationLandmarkBorder x:Name="TemplatePickerOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.TemplatePickerSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.TemplatePickerSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="TemplatePickerOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="TemplatePickerSheet"
                    AutomationProperties.Name="Choose a template"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Choose a template" TextWrapping="Wrap"
                                   Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <!-- A plain TextBlock, deliberately: the subtitle
                             carries the DESTINATION, which an AT user can
                             learn nowhere else on this sheet — mac exposes
                             it (TemplatePicker.swift:75-80). Presentation
                             suppression here was a red-team High. -->
                        <TextBlock Margin="0,4,0,8"
                                   Text="{Binding Subtitle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="TemplatePickerSubtitle"
                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="TemplatePickerCancelButton"
                                Padding="10,4"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="TemplatePickerCancel"
                                AutomationProperties.HelpText="Closes the template picker without creating a note." />
                    </StackPanel>
                    <Grid>
                        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="24,0" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Loading templates…"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                       AutomationProperties.Name="Loading templates." />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="No templates found."
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,8"
                                       Text="{x:Static templates:TemplatePickerViewModel.EmptyStateDetail}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            <Button x:Name="TemplatePickerTryAgainButton"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Content="Try Again"
                                    Command="{Binding RetryCommand}"
                                    AutomationProperties.AutomationId="TemplatePickerTryAgain"
                                    AutomationProperties.HelpText="Reloads templates for the same destination." />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Couldn’t load templates"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,8"
                                       Text="{x:Static templates:TemplatePickerViewModel.FailedStateDetail}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            <Button x:Name="TemplatePickerFailedTryAgainButton"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Content="Try Again"
                                    Command="{Binding RetryCommand}"
                                    AutomationProperties.AutomationId="TemplatePickerFailedTryAgain"
                                    AutomationProperties.HelpText="Reloads templates for the same destination." />
                        </StackPanel>
                        <ListBox x:Name="TemplatePickerList"
                                 MaxHeight="260"
                                 Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 ItemsSource="{Binding Rows}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MouseDoubleClick="TemplatePickerList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.AutomationId="TemplatePickerList" local:SiblingNames.NamePath="AccessibleName" local:SiblingNames.Noun="template"
                                 AutomationProperties.Name="Templates">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="Activate to use this template for a new note." />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Presentation text: the ListBoxItem
                                         carries the composed accessible name;
                                         plain TextBlocks would republish both
                                         fragments as duplicate text peers
                                         (AutomationLandmark.cs documents the
                                         detached-peer hazard this prevents —
                                         every other row template does this). -->
                                    <StackPanel>
                                        <local:AutomationPresentationTextBlock
                                                Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <local:AutomationPresentationTextBlock
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                                Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>
            <!-- ==========================================================
                 W5-3 (#743): the prompt/name flow sheet — one sheet, two
                 steps (contracts TD-5). Enter is Next on the prompt step
                 and Create on the name step; Esc cancels the whole flow
                 and nothing is written (T7).
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.TemplateFlowSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="448" MinWidth="320" MaxHeight="480" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=TemplateFlowOverlay}" />
            <local:AutomationLandmarkBorder x:Name="TemplateFlowOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.TemplateFlowSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.TemplateFlowSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="TemplateFlowOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="TemplateFlowSheet"
                    AutomationProperties.Name="Create from template"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <Grid>
                    <DockPanel Visibility="{Binding IsPromptStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Fill in template details" TextWrapping="Wrap"
                                       Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <!-- Plain TextBlock: carries the template name
                                 and destination, which AT can learn nowhere
                                 else on this step (mac exposes it). -->
                            <TextBlock Margin="0,4,0,8"
                                       Text="{Binding PromptStepSubtitle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="TemplatePromptsSubtitle"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Padding="10,4"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    AutomationProperties.AutomationId="TemplatePromptsCancel"
                                    AutomationProperties.HelpText="Cancels the create-from-template flow." />
                            <Button Margin="8,0,0,0"
                                    Padding="10,4"
                                    Content="Next"
                                    Command="{Binding NextCommand}"
                                    AutomationProperties.AutomationId="TemplatePromptsNext"
                                    AutomationProperties.HelpText="Continue to choose the new note's name. Enter." />
                        </StackPanel>
                        <!-- Focusable=False on BOTH layout hosts, the sheet's
                             ScrollViewer and this ItemsControl: both are Controls, whose Focusable
                             default is TRUE — the journey's axe scan caught
                             the ItemsControl as a focusable unnamed List (the
                             W4-5 class), and the red team caught the
                             ScrollViewer as the same class one level up,
                             where axe's Pane rules cannot see it. The prompt
                             TextBoxes are the tab stops; these are layout.
                             W7-7 PR 3 (#1246, R-4): so are the item containers,
                             which NVDA read as "SlateWindows.Templates.
                             TemplatePromptFieldViewModel, data item". -->
                            <local:LayoutItemsControl x:Name="TemplateFlowPromptsList" local:SiblingNames.NamePath="Label" local:SiblingNames.Noun="field"
                                                      Focusable="False"
                                                      ItemsSource="{Binding PromptFields}">
                                <local:LayoutItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                    </Style>
                                </local:LayoutItemsControl.ItemContainerStyle>
                                <local:LayoutItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <local:AutomationPresentationTextBlock Margin="0,0,0,2"
                                                    Text="{Binding Label}"
                                                    TextWrapping="Wrap" />
                                            <TextBox Padding="6,4"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </local:LayoutItemsControl.ItemTemplate>
                            </local:LayoutItemsControl>
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsNameStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Name the new note" TextWrapping="Wrap"
                                       Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <!-- Plain TextBlock: the template name lives
                                 here (mac exposes it). -->
                            <TextBlock Margin="0,4,0,8"
                                       Text="{Binding NameStepSubtitle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="TemplateNameSubtitle"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Padding="10,4"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    AutomationProperties.AutomationId="TemplateNameCancel"
                                    AutomationProperties.HelpText="Cancels the create-from-template flow. No file is written." />
                            <Button Margin="8,0,0,0"
                                    Padding="10,4"
                                    Content="Create"
                                    Command="{Binding CreateCommand}"
                                    PreviewMouseLeftButtonDown="TemplateNameCreate_PreviewMouseLeftButtonDown"
                                    AutomationProperties.AutomationId="TemplateNameCreate"
                                    AutomationProperties.HelpText="Render the template and open the new note. Enter." />
                        </StackPanel>
                        <StackPanel>
                            <local:AutomationPresentationTextBlock Margin="0,0,0,2" Text="New note name" />
                            <local:AutomationPresentationTextBlock Margin="0,0,0,4"
                                    Text="{Binding NameHint}"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                            <TextBox x:Name="TemplateFlowNameTextBox"
                                     Padding="6,4"
                                     Text="{Binding NoteName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="TemplateFlowName"
                                     AutomationProperties.Name="{Binding NameFieldAccessibleName}"
                                     AutomationProperties.HelpText=".md extension added automatically." />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding ValidationError}"
                                       Foreground="{DynamicResource Slate.WarningBrush}"
                                       TextWrapping="Wrap"
                                       Focusable="True"
                                       AutomationProperties.Name="{Binding ValidationErrorAccessibleName}"
                                       Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>
            <!-- ==========================================================
                 W5-4 (#744) F4: the Move-To folder picker — the keyboard-
                 first, drag-free move path. Filter-as-you-type; Enter
                 moves to the selected row; Esc cancels and nothing moves.
                 ========================================================== -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding FileSidebar.MoveToSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="448" MinWidth="320" MaxHeight="440" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=MoveToOverlay}" />
            <local:AutomationLandmarkBorder x:Name="MoveToOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.FileSidebar.MoveToSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding FileSidebar.MoveToSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="MoveToOverlay_PreviewKeyDown"
                    AutomationProperties.AutomationId="MoveToSheet"
                    AutomationProperties.Name="Move to folder"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                   Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Margin="0,4,0,8"
                                   Text="{Binding Subtitle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="MoveToSubtitle"
                                   Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                        <TextBox x:Name="MoveToFilterTextBox"
                                 Padding="6,4"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="MoveToFilter"
                                 AutomationProperties.Name="Filter folders"
                                 AutomationProperties.HelpText="Type to filter destination folders, or type a new folder name." />
                        <TextBlock Text="{Binding Status}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="MoveToStatus" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Content="Try again"
                                Margin="0,0,8,0"
                                Padding="10,4"
                                Command="{Binding RetryCommand}"
                                Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="MoveToRetry"
                                AutomationProperties.HelpText="Loads destination folders again, keeping the filter." />
                        <Button x:Name="MoveToCancelButton"
                                Padding="10,4"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="MoveToCancel"
                                AutomationProperties.HelpText="Closes the folder picker without moving anything." />
                    </StackPanel>
                    <!-- MinHeight: an EMPTY destination list (a vault
                         with no folders, or a filter with no matches)
                         must keep UIA extent — a zero-size list is an
                         axe BoundingRectangleNotNull violation (W5-4
                         journey finding). -->
                    <ListBox x:Name="MoveToList"
                             MinHeight="48"
                             MaxHeight="260"
                             Margin="0,8,0,0"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow}"
                             BorderThickness="0"
                             Background="Transparent"
                             MouseDoubleClick="MoveToList_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="MoveToList" local:SiblingNames.NamePath="AccessibleName" local:SiblingNames.DistinguisherPath="Place" local:SiblingNames.Noun="destination"
                             AutomationProperties.Name="Destination folders">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding DataContext.RowHelpText, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <local:AutomationPresentationTextBlock
                                            Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <local:AutomationPresentationTextBlock
                                            Text="{Binding Detail}"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                            Visibility="{Binding Detail, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>

            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.CanvasCardEditorSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MinWidth="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=CanvasCardEditorOverlay}" />
            <local:AutomationLandmarkBorder x:Name="CanvasCardEditorOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.CanvasCardEditorSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CanvasCardEditorSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="CanvasCardEditorSheet"
                    AutomationProperties.Name="{Binding SheetName}"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="CanvasCardEditorTextBox"
                             local:FieldPrompt.IsEnabled="True" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding InspectionOnly}"
                             IsReadOnlyCaretVisible="True"
                             AcceptsReturn="True"
                             MinHeight="120"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="CanvasCardEditorText"
                             AutomationProperties.Name="{Binding TextName}"
                             AutomationProperties.HelpText="{Binding EditorHint}" />
                    <local:AutomationPresentationTextBlock Text="{Binding EditorHint}"
                                                           Margin="0,6,0,0"
                                                           MaxWidth="420"
                                                           HorizontalAlignment="Left"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Slate.SecondaryTextBrush}" />
                    <Button Content="Close"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0"
                            Visibility="{Binding InspectionOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DataContext.Workspace.CloseCanvasInspectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.AutomationId="CanvasInspectionClose"
                            AutomationProperties.Name="Close card text" />
                </StackPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.CanvasCardPickerSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MinWidth="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=CanvasCardPickerOverlay}" />
            <local:AutomationLandmarkBorder x:Name="CanvasCardPickerOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.CanvasCardPickerSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CanvasCardPickerSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="CanvasCardPickerSheet"
                    AutomationProperties.Name="{Binding SheetName}"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" local:WheelChain.IsEnabled="True">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="CanvasCardPickerFilterBox"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="CanvasCardPickerFilter"
                             AutomationProperties.Name="{Binding FilterName}"
                             Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow}"
                             MaxHeight="240"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="CanvasCardPickerRows" local:SiblingNames.NamePath="Label" local:SiblingNames.Noun="card"
                             AutomationProperties.Name="{Binding RowsName}">
                        <!-- §G2 TG2-3 (IG2-48): a row's Status (the vault path for a
                             file) rides the item's UIA ItemStatus; §G2 TG2-9: its UIA Name
                             is the row's LABEL, never the record's ToString. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:AutomationPresentationTextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                </ScrollViewer>
            </local:AutomationLandmarkBorder>
            </Grid>

            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding Workspace.CanvasPromptSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MinWidth="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=CanvasPromptOverlay}" />
            <local:AutomationLandmarkBorder x:Name="CanvasPromptOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Padding="16"
                    Background="{DynamicResource Slate.SurfaceBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.Workspace.CanvasPromptSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding Workspace.CanvasPromptSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.AutomationId="CanvasPromptSheet"
                    AutomationProperties.Name="Canvas prompt"
                    AutomationProperties.IsDialog="True">
                <!-- DS-5: the choices take what the title and Clear All Marks leave of the
                     window, and scroll in it, so wrapped rows can't push the button off. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="CanvasPromptDraftBox"
                             Grid.Row="1"
                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding HasTextField, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.AutomationId="CanvasPromptDraft"
                             AutomationProperties.Name="Answer. Enter submits, Escape cancels." />
                    <ListBox x:Name="CanvasPromptChoicesList"
                             Grid.Row="2"
                             ItemsSource="{Binding Choices}"
                             SelectedItem="{Binding SelectedChoice}"
                             Focusable="{Binding HasRows}"
                             Visibility="{Binding HasTextField, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="CanvasPromptChoices" local:SiblingNames.NamePath="Name" local:SiblingNames.Noun="choice"
                             AutomationProperties.Name="Choices. Enter submits; on the marks list Enter jumps and Delete unmarks.">
                        <!-- §G2 TG2-1 (IG2-47): a choice's Status rides the item's UIA
                             ItemStatus — the connection prompts carry the outline row's
                             ordinal clause so parallel same-named rows stay distinct.
                             §G2 TG2-9: the item's UIA Name is the choice's NAME — a bound
                             record's container otherwise names itself by ToString, and the
                             journey heard "CanvasPromptChoice { Value = … }" for a row. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Converter={x:Static local:SiblingNames.Converter}}" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:AutomationPresentationTextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="CanvasPromptClearMarksButton"
                            Grid.Row="3"
                            Content="Clear All Marks"
                            Command="{Binding DataContext.Workspace.CanvasPromptClearMarksCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding ShowsClearMarks, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="CanvasPromptClearMarks"
                            AutomationProperties.Name="Clear all marks" />
                </Grid>
            </local:AutomationLandmarkBorder>
            </Grid>

            <!-- DS-10 (#1811): Settings. The design's layout: its category list, and the open
                 category's title, description and rows on the window's surface. No Save or
                 Cancel: a change applies at once. -->
            <Border Background="{DynamicResource Slate.ScrimBrush}"
                    Visibility="{Binding SettingsSheet, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Grid MaxWidth="760" MaxHeight="600" Margin="24">
            <Border Style="{DynamicResource Slate.OverlayShadow64}"
                    Visibility="{Binding Visibility, ElementName=SettingsOverlay}" />
            <local:AutomationLandmarkBorder x:Name="SettingsOverlay"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Background="{DynamicResource Slate.WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource Slate.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderOptions.ClearTypeHint="Enabled"
                    Visibility="{Binding DataContext.SettingsSheet, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"
                    DataContext="{Binding SettingsSheet}"
                    FocusManager.IsFocusScope="True"
                    local:SheetKeyboardFence.IsEnabled="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    KeyDown="SettingsOverlay_KeyDown"
                    AutomationProperties.AutomationId="SettingsSheet"
                    AutomationProperties.Name="Settings"
                    AutomationProperties.IsDialog="True">
                <!-- DS-14: below 600 the categories show their glyphs alone (SettingsLayoutGrid). -->
                <local:SettingsLayoutGrid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.ColumnSpan="2">
                        <Button x:Name="SettingsCloseButton"
                                DockPanel.Dock="Right"
                                Style="{DynamicResource Slate.SubtleIconButtonStyle}"
                                Content="&#xE711;"
                                Click="SettingsClose_Click"
                                AutomationProperties.AutomationId="SettingsClose"
                                AutomationProperties.Name="Close settings" />
                        <TextBlock Margin="12,0"
                                   VerticalAlignment="Center"
                                   Text="Settings"
                                   Style="{DynamicResource Slate.CaptionTextBlockStyle}" />
                    </DockPanel>
                    <ListBox x:Name="SettingsCategoriesList"
                             Grid.Row="1"
                             Margin="8,4,8,12"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             KeyboardNavigation.TabNavigation="Once"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="SettingsCategories"
                             AutomationProperties.Name="Settings categories">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Slate.PanelRowBase}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:AutomationPresentationTextBlock VerticalAlignment="Center"
                                                                           Text="{Binding Glyph}"
                                                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                           FontSize="20">
                                        <local:AutomationPresentationTextBlock.Style>
                                            <Style TargetType="local:AutomationPresentationTextBlock">
                                                <Setter Property="Margin" Value="0,0,12,0" />
                                                <Style.Triggers>
                                                    <!-- The name as the mouse's tooltip, on the glyph: on the
                                                         item it would be the item's help text too, the name
                                                         twice, and it would cover the page as the sheet opens
                                                         with the keys here. -->
                                                    <Trigger Property="local:SettingsLayoutGrid.IsCompact" Value="True">
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="ToolTip" Value="{Binding Label}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </local:AutomationPresentationTextBlock.Style>
                                    </local:AutomationPresentationTextBlock>
                                    <local:AutomationPresentationTextBlock Grid.Column="1"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding Label}"
                                                                           TextWrapping="Wrap">
                                        <local:AutomationPresentationTextBlock.Style>
                                            <Style TargetType="local:AutomationPresentationTextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="local:SettingsLayoutGrid.IsCompact" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </local:AutomationPresentationTextBlock.Style>
                                    </local:AutomationPresentationTextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer x:Name="SettingsPage"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,4,32,32">
                            <TextBlock Text="{Binding SelectedCategory.Label}"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource Slate.SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Margin="0,4,0,16"
                                       MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Text="How Slate looks on this computer."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Slate.SecondaryTextBrush}"
                                       Style="{DynamicResource Slate.BodyTextBlockStyle}" />
                            <local:SettingRow Label="Theme"
                                              Description="Light, Dark, or what Windows uses.">
                                <!-- DS-14: the label wraps, so a row stacked in a narrow window keeps
                                     the choice whole at the largest text. -->
                                <ComboBox x:Name="SettingsThemeComboBox"
                                          MinWidth="180"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          TextSearch.TextPath="Label"
                                          AutomationProperties.AutomationId="SettingsTheme">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Slate.ComboRowBase}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </local:SettingRow>
                            <local:SettingRow Margin="0,4,0,0"
                                              Label="Accent color"
                                              Description="Automatic uses Slate gold unless you’ve chosen an accent color in Windows.">
                                <!-- DS-14: the label wraps, so a row stacked in a narrow window keeps
                                     the choice whole at the largest text. -->
                                <ComboBox x:Name="SettingsAccentComboBox"
                                          MinWidth="180"
                                          ItemsSource="{Binding AccentOptions}"
                                          SelectedItem="{Binding SelectedAccent}"
                                          TextSearch.TextPath="Label"
                                          AutomationProperties.AutomationId="SettingsAccent">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Slate.ComboRowBase}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </local:SettingRow>
                        </StackPanel>
                    </ScrollViewer>
                </local:SettingsLayoutGrid>
            </local:AutomationLandmarkBorder>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
