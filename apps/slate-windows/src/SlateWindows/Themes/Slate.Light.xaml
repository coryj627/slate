<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Provisional W1 palette. Text-bearing pairs are intentionally high
         separation; W8-2 owns final values and the permanent APCA gate. -->
    <Color x:Key="Slate.WindowBackgroundColor">#FFF7F7F7</Color>
    <Color x:Key="Slate.SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="Slate.RaisedSurfaceColor">#FFEFEFEF</Color>
    <Color x:Key="Slate.TextColor">#FF171717</Color>
    <Color x:Key="Slate.SecondaryTextColor">#FF3A3A3A</Color>
    <Color x:Key="Slate.TertiaryTextColor">#FF555555</Color>
    <Color x:Key="Slate.BorderColor">#FF767676</Color>
    <Color x:Key="Slate.AccentColor">#FF005A9E</Color>
    <Color x:Key="Slate.SelectionBackgroundColor">#FF004578</Color>
    <Color x:Key="Slate.SelectionTextColor">#FFFFFFFF</Color>
    <Color x:Key="Slate.ErrorColor">#FF8A0014</Color>
    <Color x:Key="Slate.WarningColor">#FF754500</Color>

    <!-- Canvas tokens (W6-1 §D D13): the dark dictionary’s note
         applies; these are the light composites over #FFFFFFFF. -->
    <Color x:Key="Slate.Canvas.Fill1Color">#FFFEDEDF</Color>
    <Color x:Key="Slate.Canvas.Fill2Color">#FFFBECDC</Color>
    <Color x:Key="Slate.Canvas.Fill3Color">#FFF9F9E5</Color>
    <Color x:Key="Slate.Canvas.Fill4Color">#FFDDF6E5</Color>
    <Color x:Key="Slate.Canvas.Fill5Color">#FFE0F9F9</Color>
    <Color x:Key="Slate.Canvas.Fill6Color">#FFEFE9FF</Color>
    <Color x:Key="Slate.Canvas.Border1Color">#FFFB464C</Color>
    <Color x:Key="Slate.Canvas.Border2Color">#FFE9973F</Color>
    <Color x:Key="Slate.Canvas.Border3Color">#FFE0DE71</Color>
    <Color x:Key="Slate.Canvas.Border4Color">#FF44CF6E</Color>
    <Color x:Key="Slate.Canvas.Border5Color">#FF53DFDD</Color>
    <Color x:Key="Slate.Canvas.Border6Color">#FFA882FF</Color>
    <Color x:Key="Slate.Canvas.TextColor">#FF171717</Color>
    <Color x:Key="Slate.Canvas.GroupFillColor">#FFEFEFEF</Color>
    <Color x:Key="Slate.Canvas.EdgeColor">#FF767676</Color>
    <Color x:Key="Slate.Canvas.SelectionRingColor">#FF171717</Color>
    <Color x:Key="Slate.CodeKeywordColor">#FF6A1B9A</Color>
    <Color x:Key="Slate.CodeStringColor">#FF8E1515</Color>
    <Color x:Key="Slate.CodeNumberColor">#FF0D47A1</Color>
    <Color x:Key="Slate.CodeTypeColor">#FF00575B</Color>
    <Color x:Key="Slate.CodeFunctionColor">#FF283593</Color>

    <SolidColorBrush x:Key="Slate.WindowBackgroundBrush"
                     Color="{StaticResource Slate.WindowBackgroundColor}" />
    <SolidColorBrush x:Key="Slate.SurfaceBrush"
                     Color="{StaticResource Slate.SurfaceColor}" />
    <SolidColorBrush x:Key="Slate.RaisedSurfaceBrush"
                     Color="{StaticResource Slate.RaisedSurfaceColor}" />
    <SolidColorBrush x:Key="Slate.TextBrush"
                     Color="{StaticResource Slate.TextColor}" />
    <SolidColorBrush x:Key="Slate.SecondaryTextBrush"
                     Color="{StaticResource Slate.SecondaryTextColor}" />
    <SolidColorBrush x:Key="Slate.TertiaryTextBrush"
                     Color="{StaticResource Slate.TertiaryTextColor}" />
    <SolidColorBrush x:Key="Slate.BorderBrush"
                     Color="{StaticResource Slate.BorderColor}" />
    <SolidColorBrush x:Key="Slate.AccentBrush"
                     Color="{StaticResource Slate.AccentColor}" />
    <SolidColorBrush x:Key="Slate.SelectionBackgroundBrush"
                     Color="{StaticResource Slate.SelectionBackgroundColor}" />
    <SolidColorBrush x:Key="Slate.SelectionTextBrush"
                     Color="{StaticResource Slate.SelectionTextColor}" />
    <SolidColorBrush x:Key="Slate.FocusBrush"
                     Color="{StaticResource Slate.AccentColor}" />
    <SolidColorBrush x:Key="Slate.ErrorBrush"
                     Color="{StaticResource Slate.ErrorColor}" />
    <SolidColorBrush x:Key="Slate.WarningBrush"
                     Color="{StaticResource Slate.WarningColor}" />
    <SolidColorBrush x:Key="Slate.EditorHeadingBrush"
                     Color="{StaticResource Slate.AccentColor}" />
    <SolidColorBrush x:Key="Slate.EditorCodeBrush"
                     Color="{StaticResource Slate.SecondaryTextColor}" />
    <SolidColorBrush x:Key="Slate.EditorWikilinkBrush"
                     Color="{StaticResource Slate.AccentColor}" />
    <SolidColorBrush x:Key="Slate.EditorTagBrush"
                     Color="{StaticResource Slate.AccentColor}" />
    <SolidColorBrush x:Key="Slate.EditorMetadataBrush"
                     Color="{StaticResource Slate.SecondaryTextColor}" />
    <SolidColorBrush x:Key="Slate.CodeKeywordBrush"
                     Color="{StaticResource Slate.CodeKeywordColor}" />
    <SolidColorBrush x:Key="Slate.CodeStringBrush"
                     Color="{StaticResource Slate.CodeStringColor}" />
    <SolidColorBrush x:Key="Slate.CodeNumberBrush"
                     Color="{StaticResource Slate.CodeNumberColor}" />
    <SolidColorBrush x:Key="Slate.CodeCommentBrush"
                     Color="{StaticResource Slate.SecondaryTextColor}" />
    <SolidColorBrush x:Key="Slate.CodeTypeBrush"
                     Color="{StaticResource Slate.CodeTypeColor}" />
    <SolidColorBrush x:Key="Slate.CodeFunctionBrush"
                     Color="{StaticResource Slate.CodeFunctionColor}" />
    <SolidColorBrush x:Key="Slate.Canvas.Fill1Brush" Color="{StaticResource Slate.Canvas.Fill1Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Fill2Brush" Color="{StaticResource Slate.Canvas.Fill2Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Fill3Brush" Color="{StaticResource Slate.Canvas.Fill3Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Fill4Brush" Color="{StaticResource Slate.Canvas.Fill4Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Fill5Brush" Color="{StaticResource Slate.Canvas.Fill5Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Fill6Brush" Color="{StaticResource Slate.Canvas.Fill6Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Border1Brush" Color="{StaticResource Slate.Canvas.Border1Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Border2Brush" Color="{StaticResource Slate.Canvas.Border2Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Border3Brush" Color="{StaticResource Slate.Canvas.Border3Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Border4Brush" Color="{StaticResource Slate.Canvas.Border4Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Border5Brush" Color="{StaticResource Slate.Canvas.Border5Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.Border6Brush" Color="{StaticResource Slate.Canvas.Border6Color}" />
    <SolidColorBrush x:Key="Slate.Canvas.TextBrush" Color="{StaticResource Slate.Canvas.TextColor}" />
    <SolidColorBrush x:Key="Slate.Canvas.GroupFillBrush" Color="{StaticResource Slate.Canvas.GroupFillColor}" />
    <SolidColorBrush x:Key="Slate.Canvas.EdgeBrush" Color="{StaticResource Slate.Canvas.EdgeColor}" />
    <SolidColorBrush x:Key="Slate.Canvas.SelectionRingBrush" Color="{StaticResource Slate.Canvas.SelectionRingColor}" />
</ResourceDictionary>
