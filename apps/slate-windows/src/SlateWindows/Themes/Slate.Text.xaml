<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The two type-ramp styles Fluent doesn't ship (design/windows/xaml/README.md).
         They stay out of Slate.Light.xaml and Slate.Dark.xaml, which are generated,
         and every appearance merges them, High Contrast included. They aren't based
         on Fluent's BodyTextBlockStyle because a StaticResource can't reach a sibling
         merged dictionary. -->
    <Style x:Key="Slate.BodyLargeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="Slate.BodyLargeStrongTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource Slate.BodyLargeTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The editor's selection border, here for the same reason: it isn't generated. -->
    <Pen x:Key="Slate.EditorSelectionBorderPen"
         Brush="{DynamicResource Slate.AccentTextBrush}"
         Thickness="1" />
    <!-- #1773, #1778: the shell's splitters keep their width to grab, and draw a line
         only while in use: the pane group's border is the edge the rest of the time. -->
    <Style x:Key="Slate.ShellSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}">
                        <Rectangle Width="1"
                                   HorizontalAlignment="Center"
                                   Fill="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Slate.AccentIndicatorBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Slate.AccentIndicatorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A grid cell's selected state, for the same reason: it isn't generated, and the
         cell's text inherits this foreground, so it pairs in every appearance. -->
    <Style x:Key="Slate.GridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Slate.TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Slate.SelectedSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Slate.SelectionTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Slate.AccentIndicatorBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- A row header's peer takes its name from the header's content, not from what
         the template draws. With no gripper parts, a row can't be resized by pointer. -->
    <Style x:Key="Slate.GridRowHeaderStyle" TargetType="DataGridRowHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowHeader">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- #1762, #1781: list rows and dropdown rows, here so a style built in code can
         reach them. Selection is a shape too, not colour alone. -->
    <ControlTemplate x:Key="Slate.PanelRowTemplate" TargetType="ListBoxItem">
        <Border Padding="{TemplateBinding Padding}"
                CornerRadius="4"
                Background="{TemplateBinding Background}">
            <Grid>
                <!-- The pill: selection is a shape too, not colour alone. -->
                <Rectangle Width="3"
                           Height="16"
                           Margin="-7,0,0,0"
                           RadiusX="1.5"
                           RadiusY="1.5"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Fill="{TemplateBinding BorderBrush}" />
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Slate.RaisedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Slate.SelectedSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Slate.SelectionTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Slate.AccentIndicatorBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="Slate.ComboRowTemplate" TargetType="ComboBoxItem">
        <Border Margin="4,1"
                Padding="{TemplateBinding Padding}"
                CornerRadius="4"
                Background="{TemplateBinding Background}">
            <Grid>
                <Rectangle Width="3"
                           Height="16"
                           Margin="-7,0,0,0"
                           RadiusX="1.5"
                           RadiusY="1.5"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Fill="{TemplateBinding BorderBrush}" />
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <!-- The popup is already the raised surface, so a row the pointer or the
                 keys are on takes the selected surface; the pill marks the chosen one. -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Slate.SelectedSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Slate.SelectionTextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Slate.SelectedSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Slate.SelectionTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Slate.AccentIndicatorBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
