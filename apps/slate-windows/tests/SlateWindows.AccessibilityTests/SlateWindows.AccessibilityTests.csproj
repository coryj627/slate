<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3: a test project is its own executable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Axe.Windows" Version="2.4.2" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- xunit v3 without the Microsoft Testing Platform runner: tests run
         through VSTest (xunit.runner.visualstudio), so every CI `dotnet test`
         keeps its VSTest filter, TRX logger and blame-hang options. The
         `xunit.v3` meta-package would pull in MTP, which the .NET 10 SDK's
         `dotnet test` refuses to run through VSTest. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- W7-3's live audit runs from the CI binary artifact, without a checkout. -->
    <Content Include="..\..\chords.json" Link="fixtures\chords.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SlateWindows\MainWindow.xaml" Link="fixtures\MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SlateWindows\WorkspaceTemplates.xaml" Link="fixtures\WorkspaceTemplates.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\crates\slate-core\tests\fixtures\markdown\editor_semantics.md"
             Link="fixtures\editor_semantics.md"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- W4-5 (#737): the citation gate needs a real CSL style, and this
         job runs on DOWNLOADED BINARIES with no checkout (windows.yml
         "no checkout, no compilers"), so nothing outside the output
         directory exists at run time. Linking the committed demo-vault
         style copies it into bin, where it travels with the artifact. -->
    <Content Include="..\..\..\..\demo-vault\csl\ieee.csl"
             Link="fixtures\ieee.csl"
             CopyToOutputDirectory="PreserveNewest" />

    <!-- W6-1 PR A (#745): the canvas outline journey seeds its temp vault
         with committed demo-vault canvases, byte-exact. Same reason as the
         CSL style above — no checkout at run time — so they must travel in
         the output directory too. The §K benchmark fixture
         (large_2000.canvas, ~385 KB) is excluded: no journey reads it, and
         it is pure artifact weight. -->
    <Content Include="..\..\..\..\demo-vault\canvas\*.canvas"
             Exclude="..\..\..\..\demo-vault\canvas\large_2000.canvas"
             Link="fixtures\canvas\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />

    <!-- #1331: the gate step runs under the whole-run device-state guard,
         and the gate runner has no checkout, so the guard travels in the
         output directory with the binaries, as the fixtures above do
         (windows.yml runs it from tools\). -->
    <Content Include="..\..\..\..\scripts\windows\guard-device-state.ps1" Link="tools\guard-device-state.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlateWindows\SlateWindows.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- W6-2 PR B (B-18): the Connections journey computes core's exact
         renders (the summary, the row copy) through the binding over the
         vault it wrote, BEFORE launching the app — the §W-C witness asserts
         core's sentence, not a copy of it. -->
    <ProjectReference Include="..\..\src\SlateUniffi\SlateUniffi.csproj" />
  </ItemGroup>

  <Import Project="..\EvidenceCompilation.targets" />
</Project>
