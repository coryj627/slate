<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <!-- xunit v3: a test project is its own executable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only infrastructure: PrivateAssets="all" keeps the collector,
         test host, and VSTest runner from flowing to anything that
         references this project. `xunit.v3.mtp-off` itself is left alone — the test
         sources compile against its API. -->
    <!-- #1108: the drift twins read production source to prove the shipped
         code agrees with the declarative tables. A regex cannot tell live
         code from dead text — a chord commented out, moved into a string
         literal, or parked behind an inactive #if still satisfied one, and
         a first-match lookup could be answered by an unused overload. The
         syntax layer alone fixes all three by construction: comments and
         disabled regions are trivia, string contents are a distinct node
         type, and overloads are enumerable.

         Parser and compiler APIs only. Semantic censuses also bind symbols;
         the graph evidence census uses the build's recorded source/reference
         inputs. Microsoft.CodeAnalysis.CSharp.Workspaces and MSBuildWorkspace
         remain deliberately unreferenced: no in-process project loading or
         MSBuild discovery is needed. Currency: 5.9.0 is the latest stable
         (checked 2026-10-21), matching the compiler SDK 10.0.402 bundles. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" PrivateAssets="all" />
    <!-- xunit v3 without the Microsoft Testing Platform runner: tests run
         through VSTest (xunit.runner.visualstudio), so every CI `dotnet test`
         keeps its VSTest filter, TRX logger and blame-hang options. The
         `xunit.v3` meta-package would pull in MTP, which the .NET 10 SDK's
         `dotnet test` refuses to run through VSTest. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- The graph matrix binds the native journeys' own compiled inputs. -->
    <ProjectReference Include="..\SlateWindows.AccessibilityTests\SlateWindows.AccessibilityTests.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\SlateUniffi\SlateUniffi.csproj" />
    <ProjectReference Include="..\..\src\SlateWindows\SlateWindows.csproj" />
    <!-- HostLoggingCensus launches this executable from its project output.
         ReferenceOutputAssembly=false makes the dependency build-ordered
         without treating the probe as a test assembly dependency. -->
    <ProjectReference Include="..\..\tools\HostLogProbe\HostLogProbe.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\tools\ParityHarness\ParityHarness.csproj" />
    <!-- SvgDecodeOutOfProcessTests launches this probe the same way. -->
    <ProjectReference Include="..\..\tools\SvgDecodeProbe\SvgDecodeProbe.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\EvidenceCompilation.targets" />
</Project>
