<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only infrastructure: PrivateAssets="all" keeps the collector,
         test host, and VSTest runner from flowing to anything that
         references this project. `xunit` itself is left alone — the test
         sources compile against its API. -->
    <!-- #1108: the drift twins read production source to prove the shipped
         code agrees with the declarative tables. A regex cannot tell live
         code from dead text — a chord commented out, moved into a string
         literal, or parked behind an inactive #if still satisfied one, and
         a first-match lookup could be answered by an unused overload. The
         syntax layer alone fixes all three by construction: comments and
         disabled regions are trivia, string contents are a distinct node
         type, and overloads are enumerable.

         Syntax only. Microsoft.CodeAnalysis.CSharp.Workspaces and
         MSBuildWorkspace are deliberately NOT referenced — no project
         loading, no MSBuild discovery, and the scrapes stay fast enough
         to sit in the unit suite. Currency: 5.6.0 is the latest stable
         (checked 2026-08-16). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlateUniffi\SlateUniffi.csproj" />
    <ProjectReference Include="..\..\src\SlateWindows\SlateWindows.csproj" />
    <!-- HostLoggingCensus launches this executable from its project output.
         ReferenceOutputAssembly=false makes the dependency build-ordered
         without treating the probe as a test assembly dependency. -->
    <ProjectReference Include="..\..\tools\HostLogProbe\HostLogProbe.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\tools\ParityHarness\ParityHarness.csproj" />
  </ItemGroup>

</Project>
